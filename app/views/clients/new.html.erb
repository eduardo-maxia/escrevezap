<% content_for :page_title, "Novo cliente" %>

<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@28.1.0/dist/css/intlTelInput.css">
  <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@28.1.0/dist/js/intlTelInputWithUtils.min.js"></script>
<% end %>

<div class="md:p-6 md:max-w-lg">
  <%# Header — breadcrumb on desktop, back arrow + title on mobile %>
  <div class="px-4 pt-3 pb-4 md:px-0 md:pt-0 md:pb-0">
    <nav class="hidden md:flex mb-5" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1">
        <li class="inline-flex items-center">
          <%= link_to "Clientes", clients_path, class: "text-sm font-medium text-(--color-text-muted) hover:text-(--color-brand) transition-colors" %>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <i class="ph ph-caret-right text-xs text-(--color-text-subtle) mx-1.5"></i>
            <span class="text-sm font-medium text-(--color-text)">Novo cliente</span>
          </div>
        </li>
      </ol>
    </nav>
    <div class="md:hidden flex items-center gap-2">
      <%= link_to clients_path,
            class: "inline-flex items-center justify-center -ml-1.5 w-8 h-8 rounded-lg text-(--color-text-muted) hover:text-(--color-text) hover:bg-(--color-surface-raised) transition-colors" do %>
        <i class="ph ph-caret-left text-lg"></i>
      <% end %>
      <h2 class="text-xl font-bold text-(--color-text)">Novo cliente</h2>
    </div>
  </div>

  <div class="px-4 pb-8 md:px-0 md:pb-0">
    <div class="md:bg-(--color-surface) md:rounded-xl md:border md:border-(--color-border) md:p-6">
    <%= form_with model: @client, url: clients_path,
          data: { controller: "phone-input",
                  action: "submit->phone-input#syncHidden",
                  "phone-input-check-whatsapp-url-value": onboarding_check_whatsapp_path } do |f| %>

      <% if @client.errors.any? %>
        <div class="mb-4 p-3 bg-(--color-danger-light) border border-(--color-danger) rounded-lg text-sm text-(--color-danger)">
          <%= @client.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <% if @simple_mode && @campaign_client&.errors&.any? %>
        <div class="mb-4 p-3 bg-(--color-danger-light) border border-(--color-danger) rounded-lg text-sm text-(--color-danger)">
          <%= @campaign_client.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-(--color-text) mb-1.5">
            Nome <span class="text-(--color-danger)">*</span>
          </label>
          <%= f.text_field :name, required: true, autofocus: true,
                class: "w-full px-3.5 py-2.5 rounded-lg border border-(--color-border) bg-(--color-surface) text-(--color-text) text-sm placeholder:text-(--color-text-subtle) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) transition-colors" %>
        </div>

        <div>
          <label class="block text-sm font-medium text-(--color-text) mb-1.5">E-mail</label>
          <%= f.email_field :email,
                class: "w-full px-3.5 py-2.5 rounded-lg border border-(--color-border) bg-(--color-surface) text-(--color-text) text-sm placeholder:text-(--color-text-subtle) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) transition-colors" %>
        </div>

        <div>
          <label class="block text-sm font-medium text-(--color-text) mb-1.5">WhatsApp</label>
          <div class="flex items-center gap-3">
            <img data-phone-input-target="avatar"
                 class="hidden w-10 h-10 rounded-full object-cover ring-2 ring-(--color-success) flex-shrink-0"
                 alt="Foto do WhatsApp">
            <div class="flex-1 min-w-0">
              <input type="tel"
                     id="phone_display"
                     data-phone-input-target="input"
                     data-action="input->phone-input#checkPhone countrychange->phone-input#checkPhone"
                     class="w-full px-3.5 py-2.5 rounded-lg border border-(--color-border) bg-(--color-surface) text-(--color-text) text-sm placeholder:text-(--color-text-subtle) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) transition-colors">
              <%= f.hidden_field :phone_number, data: { "phone-input-target": "hidden" } %>
              <p data-phone-input-target="phoneCheck" class="hidden text-xs mt-1.5"></p>
            </div>
          </div>
          <p class="mt-1.5 text-xs text-(--color-text-subtle)">Opcional — clientes sem WhatsApp não recebem lembretes automáticos.</p>
        </div>

        <% if @simple_mode %>
          <div class="pt-2 border-t border-(--color-border) space-y-4">
            <p class="text-sm font-semibold text-(--color-text)">Cobrança</p>

            <div class="grid grid-cols-2 gap-4">
              <div data-controller="amount-input">
                <label class="block text-sm font-medium text-(--color-text) mb-1.5">
                  Valor mensal <span class="text-(--color-danger)">*</span>
                </label>
                <div class="relative">
                  <span class="absolute inset-y-0 left-3 flex items-center text-sm text-(--color-text-muted) pointer-events-none select-none">R$</span>
                  <input type="text"
                         inputmode="numeric"
                         placeholder="0,00"
                         required
                         data-amount-input-target="display"
                         data-action="input->amount-input#format"
                         class="w-full pl-9 pr-3.5 py-2.5 rounded-lg border border-(--color-border) bg-(--color-surface) text-(--color-text) text-sm placeholder:text-(--color-text-subtle) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) transition-colors">
                  <input type="hidden"
                         name="campaign_client[amount]"
                         value="<%= @campaign_client&.amount %>"
                         data-amount-input-target="hidden">
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-(--color-text) mb-1.5">
                  Dia de vencimento <span class="text-(--color-danger)">*</span>
                </label>
                <input type="number"
                       name="campaign_client[due_day]"
                       required
                       min="1"
                       max="30"
                       placeholder="Ex: 15"
                       value="<%= @campaign_client&.due_day %>"
                       class="w-full px-3.5 py-2.5 rounded-lg border border-(--color-border) bg-(--color-surface) text-(--color-text) text-sm focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) transition-colors">
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <div class="flex flex-col-reverse md:flex-row md:items-center gap-3 mt-6">
        <%= link_to "Cancelar", clients_path,
              class: "hidden md:inline-flex px-5 py-2.5 border border-(--color-border) text-sm font-medium text-(--color-text-muted) rounded-lg hover:text-(--color-text) transition-colors text-center justify-center" %>
        <%= f.submit "Cadastrar cliente",
              class: "w-full md:w-auto px-5 py-2.5 bg-(--color-brand) text-(--color-text-inverse) text-sm font-semibold rounded-lg hover:bg-(--color-brand-dark) transition-colors cursor-pointer" %>
      </div>
    <% end %>
    </div>
  </div>
</div>
