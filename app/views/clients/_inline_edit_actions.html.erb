<div class="absolute inset-y-0 right-1.5 flex items-center gap-1 z-10">
  <button type="button" data-action="click->inline-edit#cancel"
          class="w-7 h-7 flex items-center justify-center rounded-md text-(--color-text-muted) hover:bg-(--color-surface-raised) transition-colors cursor-pointer"
          aria-label="Cancelar">
    <i class="ph ph-x text-sm"></i>
  </button>
  <button type="submit"
          class="w-7 h-7 flex items-center justify-center rounded-md bg-(--color-brand) text-(--color-text-inverse) hover:bg-(--color-brand-dark) transition-colors cursor-pointer"
          aria-label="Salvar">
    <i class="ph ph-check text-sm"></i>
  </button>
</div>
