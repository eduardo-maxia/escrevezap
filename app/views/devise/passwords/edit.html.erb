<div class="min-h-screen flex flex-col items-center justify-center p-4">

  <%# Brand %>
  <div class="mb-8 text-center">
    <%= image_tag "/logo.jpeg", alt: "Cobrança em Dia", class: "h-14 w-auto mb-4" %>
    <p class="text-(--color-text-muted) text-sm mt-1">Gestão de cobranças via WhatsApp</p>
  </div>

  <%# Card %>
  <div class="w-full max-w-md bg-(--color-surface) rounded-2xl shadow-sm border border-(--color-border) p-8">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-xl bg-(--color-brand-light) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-lock-key-open text-(--color-brand) text-xl"></i>
      </div>
      <div>
        <h2 class="text-xl font-semibold text-(--color-text)">Nova senha</h2>
        <p class="text-sm text-(--color-text-muted)">Escolha uma senha segura</p>
      </div>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="space-y-5">
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :password, "Nova senha", class: "text-sm font-medium text-(--color-text)" %>
            <% if @minimum_password_length %>
              <span class="text-xs text-(--color-text-subtle)">mín. <%= @minimum_password_length %> caracteres</span>
            <% end %>
          </div>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
                class: "w-full px-3.5 py-2.5 rounded-lg border border-(--color-border) bg-(--color-surface) text-(--color-text) text-sm placeholder:text-(--color-text-subtle) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) transition-colors",
                placeholder: "••••••••" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirmar nova senha", class: "block text-sm font-medium text-(--color-text) mb-1.5" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                class: "w-full px-3.5 py-2.5 rounded-lg border border-(--color-border) bg-(--color-surface) text-(--color-text) text-sm placeholder:text-(--color-text-subtle) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) transition-colors",
                placeholder: "••••••••" %>
        </div>

        <%= f.submit "Redefinir senha",
              class: "w-full bg-(--color-brand) hover:bg-(--color-brand-dark) text-(--color-text-inverse) font-semibold py-2.5 px-4 rounded-lg text-sm transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>

</div>
