<div class="auth-page">
  <%= render "devise/shared/brand", tagline: "Defina sua nova senha" %>

  <div class="auth-card">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-xl bg-(--color-brand-light) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-lock-key-open text-(--color-brand) text-xl"></i>
      </div>
      <div>
        <h1 class="text-xl font-semibold text-(--color-text)">Nova senha</h1>
        <p class="text-sm text-(--color-text-muted)">Escolha uma senha segura</p>
      </div>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="space-y-5">
        <div>
          <div class="flex items-center justify-between mb-2">
            <%= f.label :password, "Nova senha", class: "text-sm font-medium text-(--color-text)" %>
            <% if @minimum_password_length %>
              <span class="text-xs text-(--color-text-subtle)">mín. <%= @minimum_password_length %> caracteres</span>
            <% end %>
          </div>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
                class: "auth-input", placeholder: "••••••••" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirmar nova senha", class: "auth-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                class: "auth-input", placeholder: "••••••••" %>
        </div>

        <%= f.submit "Redefinir senha", class: "auth-btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
