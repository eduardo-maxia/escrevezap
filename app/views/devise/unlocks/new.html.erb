<div class="auth-page">
  <%= render "devise/shared/brand", tagline: "Desbloqueio de conta" %>

  <div class="auth-card">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-xl bg-(--color-warning-light) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-lock-open text-(--color-warning) text-xl"></i>
      </div>
      <div>
        <h1 class="text-xl font-semibold text-(--color-text)">Desbloquear conta</h1>
        <p class="text-sm text-(--color-text-muted)">Reenviaremos as instruções por e-mail</p>
      </div>
    </div>

    <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="space-y-5">
        <div>
          <%= f.label :email, "E-mail", class: "auth-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "auth-input", placeholder: "seu@email.com" %>
        </div>

        <%= f.submit "Reenviar instruções", class: "auth-btn-primary" %>
      </div>
    <% end %>
  </div>

  <div class="mt-6 text-center">
    <p class="text-sm text-(--color-text-muted)">
      Já desbloqueou?
      <%= link_to "Entrar", new_session_path(resource_name), class: "auth-link" %>
    </p>
  </div>
</div>
