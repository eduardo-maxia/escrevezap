<div class="min-h-screen flex flex-col items-center justify-center p-4">

  <%# Brand %>
  <div class="mb-8 text-center flex flex-row gap-2 items-center">
    <%= image_tag "/logo.jpeg", alt: "Cobrança em Dia", class: "h-14 w-auto" %>
    <p class="text-primary text-lg font-bold">Cobrança em Dia</p>
  </div>

  <%# Card %>
  <div class="w-full max-w-md bg-(--color-surface) rounded-2xl shadow-sm border border-(--color-border) p-8">
    <h2 class="text-xl font-semibold text-(--color-text) mb-6">Entrar na sua conta</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="space-y-5">
        <div>
          <%= f.label :email, "E-mail", class: "block text-sm font-medium text-(--color-text) mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "w-full px-3.5 py-2.5 rounded-lg border border-(--color-border) bg-(--color-surface) text-(--color-text) text-sm placeholder:text-(--color-text-subtle) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) transition-colors",
                placeholder: "seu@email.com" %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :password, "Senha", class: "block text-sm font-medium text-(--color-text)" %>
            <% if devise_mapping.recoverable? %>
              <%= link_to "Esqueceu a senha?", new_password_path(resource_name),
                    class: "text-sm text-(--color-brand) hover:text-(--color-brand-dark) font-medium" %>
            <% end %>
          </div>
          <%= f.password_field :password, autocomplete: "current-password",
                class: "w-full px-3.5 py-2.5 rounded-lg border border-(--color-border) bg-(--color-surface) text-(--color-text) text-sm placeholder:text-(--color-text-subtle) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) transition-colors",
                placeholder: "••••••••" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2">
            <%= f.check_box :remember_me, class: "w-4 h-4 rounded border-(--color-border) accent-(--color-brand)" %>
            <%= f.label :remember_me, "Lembrar de mim", class: "text-sm text-(--color-text-muted) cursor-pointer" %>
          </div>
        <% end %>

        <%= f.submit "Entrar",
              class: "w-full bg-(--color-brand) hover:bg-(--color-brand-dark) text-(--color-text-inverse) font-semibold py-2.5 px-4 rounded-lg text-sm transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <%# Links %>
  <div class="mt-6 text-center space-y-2">
    <% if devise_mapping.registerable? %>
      <p class="text-sm text-(--color-text-muted)">
        Não tem conta?
        <%= link_to "Criar conta", new_registration_path(resource_name),
              class: "text-(--color-brand) hover:text-(--color-brand-dark) font-medium" %>
      </p>
    <% end %>
    <% if devise_mapping.confirmable? %>
      <p class="text-sm text-(--color-text-muted)">
        <%= link_to "Não recebeu o e-mail de confirmação?", new_confirmation_path(resource_name),
              class: "text-(--color-brand) hover:text-(--color-brand-dark) font-medium" %>
      </p>
    <% end %>
    <% if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) %>
      <p class="text-sm text-(--color-text-muted)">
        <%= link_to "Não recebeu as instruções de desbloqueio?", new_unlock_path(resource_name),
              class: "text-(--color-brand) hover:text-(--color-brand-dark) font-medium" %>
      </p>
    <% end %>
  </div>

</div>
