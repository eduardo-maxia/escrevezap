<div class="min-h-screen flex flex-col items-center justify-center p-4">

  <%# Brand %>
  <div class="mb-8 text-center">
    <%= image_tag "/logo.png", alt: "Cobrança em Dia", class: "h-14 w-auto mb-4" %>
    <p class="text-(--color-text-muted) text-sm mt-1">Gestão de cobranças via WhatsApp</p>
  </div>

  <%# Card %>
  <div class="w-full max-w-md bg-(--color-surface) rounded-2xl shadow-sm border border-(--color-border) p-8">
    <h2 class="text-xl font-semibold text-(--color-text) mb-6">Criar sua conta</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="space-y-5">
        <div>
          <%= f.label :email, "E-mail", class: "block text-sm font-medium text-(--color-text) mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "w-full px-3.5 py-2.5 rounded-lg border border-(--color-border) bg-(--color-surface) text-(--color-text) text-sm placeholder:text-(--color-text-subtle) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) transition-colors",
                placeholder: "seu@email.com" %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :password, "Senha", class: "block text-sm font-medium text-(--color-text)" %>
            <% if @minimum_password_length %>
              <span class="text-xs text-(--color-text-subtle)">mín. <%= @minimum_password_length %> caracteres</span>
            <% end %>
          </div>
          <%= f.password_field :password, autocomplete: "new-password",
                class: "w-full px-3.5 py-2.5 rounded-lg border border-(--color-border) bg-(--color-surface) text-(--color-text) text-sm placeholder:text-(--color-text-subtle) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) transition-colors",
                placeholder: "••••••••" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirmar senha", class: "block text-sm font-medium text-(--color-text) mb-1.5" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                class: "w-full px-3.5 py-2.5 rounded-lg border border-(--color-border) bg-(--color-surface) text-(--color-text) text-sm placeholder:text-(--color-text-subtle) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) transition-colors",
                placeholder: "••••••••" %>
        </div>

        <%= f.submit "Criar conta",
              class: "w-full bg-(--color-brand) hover:bg-(--color-brand-dark) text-(--color-text-inverse) font-semibold py-2.5 px-4 rounded-lg text-sm transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <%# Links %>
  <div class="mt-6 text-center">
    <p class="text-sm text-(--color-text-muted)">
      Já tem conta?
      <%= link_to "Entrar", new_session_path(resource_name),
            class: "text-(--color-brand) hover:text-(--color-brand-dark) font-medium" %>
    </p>
  </div>

</div>
