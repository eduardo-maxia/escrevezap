<div class="auth-page">
  <%= render "devise/shared/brand" %>

  <div class="auth-card">
    <h1 class="text-xl font-semibold text-(--color-text) mb-6">Criar sua conta</h1>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="space-y-5">
        <div>
          <%= f.label :email, "E-mail", class: "auth-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "auth-input", placeholder: "seu@email.com" %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <%= f.label :password, "Senha", class: "text-sm font-medium text-(--color-text)" %>
            <% if @minimum_password_length %>
              <span class="text-xs text-(--color-text-subtle)">mín. <%= @minimum_password_length %> caracteres</span>
            <% end %>
          </div>
          <%= f.password_field :password, autocomplete: "new-password",
                class: "auth-input", placeholder: "••••••••" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirmar senha", class: "auth-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                class: "auth-input", placeholder: "••••••••" %>
        </div>

        <%= f.submit "Criar conta", class: "auth-btn-primary" %>
      </div>
    <% end %>
  </div>

  <div class="mt-6 text-center">
    <p class="text-sm text-(--color-text-muted)">
      Já tem conta?
      <%= link_to "Entrar", new_session_path(resource_name), class: "auth-link" %>
    </p>
  </div>
</div>
