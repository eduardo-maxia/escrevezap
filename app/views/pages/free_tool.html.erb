<% content_for :title_full, "Transcrever Áudio Grátis | EscreveZap" %>
<% content_for :description, "Ferramenta gratuita para transcrever áudios em texto online. Faça upload de um arquivo de voz e receba a transcrição com IA na hora." %>

<section class="relative overflow-hidden bg-(--color-bg)" aria-labelledby="free-tool-title">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-16 md:pt-24 md:pb-20 text-center">

    <nav aria-label="Trilha de navegação" class="text-xs text-(--color-text-muted) mb-6">
      <ol class="inline-flex items-center gap-1.5">
        <li><%= link_to "Início", root_path, class: "hover:text-(--color-text)" %></li>
        <li aria-hidden="true">/</li>
        <li class="text-(--color-text)" aria-current="page">Ferramenta Gratuita</li>
      </ol>
    </nav>

    <div class="inline-flex items-center gap-1.5 bg-(--color-brand-light) text-(--color-brand) text-xs font-semibold px-3 py-1.5 rounded-full mb-6">
      <i class="ph ph-sparkle"></i>
      EscreveZap — Ferramenta Gratuita
    </div>

    <h1 id="free-tool-title" class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-(--color-text) leading-tight tracking-tight">
      Transcrever áudio em texto
    </h1>

    <p class="mt-5 text-lg md:text-xl text-(--color-text-muted) leading-relaxed max-w-2xl mx-auto">
      Faça o upload do seu áudio (até 30 segundos) e receba a transcrição completa e formatada com nossa IA otimizada para o português.
    </p>

    <div class="mt-12 bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden max-w-2xl mx-auto text-left" 
         data-controller="audio-uploader"
         data-audio-uploader-url-value="<%= try_transcribe_path %>">
      
      <div class="p-7 md:p-10">
        <div data-audio-uploader-target="dropzone" class="border-2 border-dashed border-gray-300 rounded-2xl p-10 text-center hover:bg-gray-50 transition-colors cursor-pointer" data-action="click->audio-uploader#browse dragover->audio-uploader#dragover dragleave->audio-uploader#dragleave drop->audio-uploader#drop">
          <div class="w-16 h-16 mx-auto bg-(--color-brand-light) text-(--color-brand) rounded-full flex items-center justify-center mb-4">
            <i class="ph ph-upload-simple text-3xl"></i>
          </div>
          <p class="text-lg font-semibold text-(--color-text) mb-2">Clique ou arraste seu áudio aqui</p>
          <p class="text-sm text-(--color-text-muted)">Suporta MP3, WAV, OGG, M4A, WEBM (Max: 30s)</p>
          <input type="file" accept="audio/*" class="hidden" data-audio-uploader-target="input" data-action="change->audio-uploader#upload">
        </div>

        <!-- Loading State -->
        <div data-audio-uploader-target="loading" class="hidden mt-8 text-center py-6">
          <i class="ph ph-spinner animate-spin text-4xl text-(--color-brand) mb-3"></i>
          <p class="text-sm font-semibold text-(--color-text)">Transcrevendo áudio...</p>
          <p class="text-xs text-(--color-text-muted) mt-1">Nossa IA está trabalhando nisso.</p>
        </div>

        <!-- Error State -->
        <div data-audio-uploader-target="error" class="hidden mt-6">
          <div class="flex items-start gap-3 bg-red-50 border border-red-100 rounded-xl px-4 py-3">
            <i class="ph ph-warning-circle text-red-500 text-lg shrink-0 mt-0.5"></i>
            <p data-audio-uploader-target="errorText" class="text-sm text-red-700 leading-relaxed"></p>
          </div>
          <button type="button" data-action="click->audio-uploader#reset" class="mt-4 text-sm font-semibold text-(--color-brand) hover:underline">Tentar novamente</button>
        </div>

        <!-- Result State -->
        <div data-audio-uploader-target="result" class="hidden mt-8">
          <div class="flex items-center justify-between mb-4">
             <h3 class="text-lg font-bold text-(--color-text)">Resultado da Transcrição</h3>
             <button type="button" data-action="click->audio-uploader#reset" class="text-xs font-semibold text-(--color-text-muted) hover:text-(--color-brand) flex items-center gap-1">
               <i class="ph ph-arrows-clockwise"></i> Novo arquivo
             </button>
          </div>
          
          <div class="rounded-2xl border border-gray-200 overflow-hidden shadow-sm">
            <div class="bg-(--color-surface-soft) px-5 py-3 border-b border-gray-200 flex items-center justify-between">
              <span class="text-xs font-bold text-(--color-text-muted) uppercase tracking-wide">Transcrição (IA)</span>
            </div>
            <div class="p-5 bg-white">
              <div data-audio-uploader-target="summaryBlock" class="hidden mb-4">
                <p class="text-xs font-bold text-(--color-brand) mb-1.5">📝 Resumo</p>
                <p data-audio-uploader-target="summaryText" class="text-sm text-(--color-accent) leading-relaxed"></p>
                <div class="h-px bg-gray-100 my-4"></div>
              </div>
              <p class="text-xs font-bold text-(--color-brand) mb-1.5">📄 Texto Completo</p>
              <p data-audio-uploader-target="formattedText" class="text-sm text-(--color-text) leading-relaxed"></p>
            </div>
          </div>

          <div class="mt-8 text-center bg-(--color-brand-light) rounded-2xl p-6">
            <h4 class="font-bold text-(--color-text) mb-2">Gostou da qualidade da IA?</h4>
            <p class="text-sm text-(--color-text-muted) mb-4">Imagine ter essa transcrição automaticamente no seu WhatsApp, para cada áudio que você receber.</p>
            <%= link_to official_whatsapp_url, target: "_blank", rel: "noopener", class: "inline-flex items-center justify-center gap-2 bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold px-6 py-3 rounded-xl transition-colors text-sm shadow-sm" do %>
              <i class="ph ph-whatsapp-logo text-lg"></i>
              Conectar no WhatsApp (Grátis)
            <% end %>
          </div>
        </div>
      </div>
      <div class="bg-(--color-surface-soft) border-t border-gray-100 px-7 py-4 flex items-center gap-2 text-xs text-(--color-text-muted)">
        <i class="ph ph-shield-check text-(--color-brand)"></i>
        <span>Seu áudio é processado de forma segura e descartado imediatamente. Não armazenamos seus arquivos.</span>
      </div>
    </div>
  </div>
</section>

