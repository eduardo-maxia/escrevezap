<%# ── Navbar ──────────────────────────────────────────────────────────────── %>
<header class="sticky top-0 z-50 bg-(--color-surface)/90 backdrop-blur-sm border-b border-(--color-border)">
  <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <%= image_tag "/logo.jpeg", alt: "Cobrança em Dia", class: "h-8 w-auto" %>
      <span class="font-semibold text-(--color-text) text-sm hidden sm:block">Cobrança em Dia</span>
    </div>
    <%= link_to new_user_session_path,
          class: "inline-flex items-center gap-1.5 px-4 py-2 bg-(--color-brand) text-(--color-text-inverse) text-sm font-medium rounded-lg hover:bg-(--color-brand-dark) transition-colors" do %>
      Entrar
      <i class="ph ph-arrow-right text-sm"></i>
    <% end %>
  </div>
</header>

<%# ── Hero ───────────────────────────────────────────────────────────────── %>
<section class="bg-(--color-brand) text-(--color-text-inverse) py-24 px-6">
  <div class="max-w-3xl mx-auto text-center">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 text-sm text-blue-200 mb-6">
      <i class="ph ph-whatsapp-logo text-base"></i>
      Integração nativa com WhatsApp
    </span>

    <h1 class="text-4xl sm:text-5xl font-bold leading-tight tracking-tight">
      Cobranças via WhatsApp<br>no piloto automático
    </h1>

    <p class="mt-6 text-lg text-blue-200 max-w-xl mx-auto leading-relaxed">
      Automatize lembretes de vencimento, acompanhe pagamentos e mantenha seus clientes em dia — sem precisar fazer nada manualmente.
    </p>

    <div class="mt-10 flex items-center justify-center gap-3 flex-wrap">
      <%= link_to new_user_registration_path,
            class: "inline-flex items-center gap-2 px-8 py-3.5 bg-(--color-accent) hover:bg-(--color-accent-dark) text-white font-semibold rounded-xl transition-colors text-sm" do %>
        Começar agora
        <i class="ph ph-arrow-right text-base"></i>
      <% end %>
      <%= link_to new_user_session_path,
            class: "inline-flex items-center gap-2 px-8 py-3.5 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-medium rounded-xl transition-colors text-sm" do %>
        Já tenho conta
      <% end %>
    </div>
  </div>
</section>

<%# ── Features ───────────────────────────────────────────────────────────── %>
<section class="py-20 px-6 bg-(--color-surface-muted)">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-14">
      <h2 class="text-3xl font-bold text-(--color-text)">Tudo para cobrar sem esforço</h2>
      <p class="mt-3 text-(--color-text-muted) max-w-lg mx-auto">Uma plataforma simples que faz o trabalho pesado de cobrança por você.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">

      <div class="bg-(--color-surface) rounded-2xl border border-(--color-border) p-7">
        <div class="w-11 h-11 rounded-xl bg-(--color-brand-light) flex items-center justify-center mb-5">
          <i class="ph ph-paper-plane-tilt text-(--color-brand) text-xl"></i>
        </div>
        <h3 class="font-semibold text-(--color-text) mb-2">Disparos automáticos</h3>
        <p class="text-sm text-(--color-text-muted) leading-relaxed">
          Configure uma vez e esqueça. Mensagens de cobrança são enviadas automaticamente no dia do vencimento, dentro do horário que você definir.
        </p>
      </div>

      <div class="bg-(--color-surface) rounded-2xl border border-(--color-border) p-7">
        <div class="w-11 h-11 rounded-xl bg-(--color-brand-light) flex items-center justify-center mb-5">
          <i class="ph ph-users-three text-(--color-brand) text-xl"></i>
        </div>
        <h3 class="font-semibold text-(--color-text) mb-2">Gestão de clientes</h3>
        <p class="text-sm text-(--color-text-muted) leading-relaxed">
          Cadastre clientes, defina valores e datas de vencimento. Acompanhe o histórico completo de parcelas e pagamentos de cada um.
        </p>
      </div>

      <div class="bg-(--color-surface) rounded-2xl border border-(--color-border) p-7">
        <div class="w-11 h-11 rounded-xl bg-(--color-brand-light) flex items-center justify-center mb-5">
          <i class="ph ph-receipt text-(--color-brand) text-xl"></i>
        </div>
        <h3 class="font-semibold text-(--color-text) mb-2">Controle de pagamentos</h3>
        <p class="text-sm text-(--color-text-muted) leading-relaxed">
          Registre baixas, anexe comprovantes de pagamento e mantenha o controle financeiro dos seus recebíveis em um só lugar.
        </p>
      </div>

    </div>
  </div>
</section>

<%# ── How it works ────────────────────────────────────────────────────────── %>
<section class="py-20 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-14">
      <h2 class="text-3xl font-bold text-(--color-text)">Como funciona</h2>
      <p class="mt-3 text-(--color-text-muted)">Em três passos você já está cobrando automaticamente.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">

      <div class="text-center">
        <div class="w-12 h-12 rounded-full bg-(--color-brand) text-(--color-text-inverse) flex items-center justify-center text-lg font-bold mx-auto mb-5">1</div>
        <h3 class="font-semibold text-(--color-text) mb-2">Conecte o WhatsApp</h3>
        <p class="text-sm text-(--color-text-muted) leading-relaxed">Escaneie um QR code para vincular o número que vai enviar as cobranças.</p>
      </div>

      <div class="text-center">
        <div class="w-12 h-12 rounded-full bg-(--color-brand) text-(--color-text-inverse) flex items-center justify-center text-lg font-bold mx-auto mb-5">2</div>
        <h3 class="font-semibold text-(--color-text) mb-2">Cadastre seus clientes</h3>
        <p class="text-sm text-(--color-text-muted) leading-relaxed">Informe nome, número, valor e data de vencimento de cada cliente.</p>
      </div>

      <div class="text-center">
        <div class="w-12 h-12 rounded-full bg-(--color-brand) text-(--color-text-inverse) flex items-center justify-center text-lg font-bold mx-auto mb-5">3</div>
        <h3 class="font-semibold text-(--color-text) mb-2">Receba automaticamente</h3>
        <p class="text-sm text-(--color-text-muted) leading-relaxed">A plataforma cuida dos disparos diários. Você acompanha tudo pelo dashboard.</p>
      </div>

    </div>
  </div>
</section>

<%# ── Final CTA ───────────────────────────────────────────────────────────── %>
<section class="bg-(--color-brand) py-20 px-6 text-center text-(--color-text-inverse)">
  <div class="max-w-xl mx-auto">
    <h2 class="text-3xl font-bold">Pronto para cobrar no piloto automático?</h2>
    <p class="mt-4 text-blue-200 text-lg">Comece agora e automatize suas cobranças em minutos.</p>
    <%= link_to new_user_registration_path,
          class: "mt-8 inline-flex items-center gap-2 px-10 py-4 bg-(--color-accent) hover:bg-(--color-accent-dark) text-white font-semibold rounded-xl transition-colors" do %>
      Criar conta gratuita
      <i class="ph ph-arrow-right text-base"></i>
    <% end %>
  </div>
</section>

<%# ── Footer ─────────────────────────────────────────────────────────────── %>
<footer class="border-t border-(--color-border) py-8 px-6">
  <div class="max-w-5xl mx-auto flex items-center justify-between gap-4 flex-wrap">
    <div class="flex items-center gap-2.5">
      <%= image_tag "/logo.jpeg", alt: "Cobrança em Dia", class: "h-7 w-auto" %>
      <span class="text-sm text-(--color-text-muted)">Cobrança em Dia</span>
    </div>
    <p class="text-sm text-(--color-text-subtle)">© <%= Date.today.year %> Cobrança em Dia. Todos os direitos reservados.</p>
    <%= link_to "Entrar", new_user_session_path, class: "text-sm text-(--color-text-muted) hover:text-(--color-brand) transition-colors" %>
  </div>
</footer>
