<%# ============================================================== %>
<%# SEO metadata + structured data %>
<%# ============================================================== %>
<% content_for :title_full, "Transcrever Áudio do WhatsApp em Texto | EscreveZap" %>
<% content_for :description, "Transcreva áudios do WhatsApp automaticamente em texto. EscreveZap conecta no seu WhatsApp, transcreve as mensagens de voz com IA e responde direto na conversa — sem trocar de app." %>
<% content_for :jsonld do %>
  <%= faq_jsonld(HomeContent::FAQS) %>
<% end %>

<%# ============================================================== %>
<%# HERO %>
<%# ============================================================== %>
<section class="relative overflow-hidden bg-(--color-bg)" aria-labelledby="hero-title">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-20 md:pt-24 md:pb-28">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

      <%# ── Left: copy ── %>
      <div class="text-center lg:text-left">
        <%# Badge %>
        <div class="inline-flex items-center gap-1.5 bg-(--color-brand-light) text-(--color-brand) text-xs font-semibold px-3 py-1.5 rounded-full mb-6">
          <i class="ph ph-sparkle"></i>
          Transcrição automática no WhatsApp
        </div>

        <%# Headline %>
        <h1 id="hero-title" class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-(--color-text) leading-tight tracking-tight">
          Transcreva áudios<br class="hidden sm:block">
          do WhatsApp<br class="hidden sm:block">
          <span class="text-(--color-brand)">em texto, na hora.</span>
        </h1>

        <%# Subheadline %>
        <p class="mt-5 text-lg md:text-xl text-(--color-text-muted) leading-relaxed max-w-lg mx-auto lg:mx-0">
          EscreveZap conecta no seu WhatsApp, converte automaticamente cada áudio em texto com IA e responde direto na conversa. Sem trocar de app, sem copiar e colar.
        </p>

        <%# CTAs %>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
          <%= link_to new_user_session_path,
                class: "inline-flex items-center justify-center gap-2 bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold px-6 py-3.5 rounded-xl transition-colors text-sm shadow-sm" do %>
            <i class="ph ph-whatsapp-logo text-lg"></i>
            Conectar meu WhatsApp
          <% end %>
          <a href="#como-funciona"
             class="inline-flex items-center justify-center gap-1.5 text-(--color-text-muted) hover:text-(--color-text) font-medium px-6 py-3.5 text-sm transition-colors">
            <i class="ph ph-play-circle text-lg"></i>
            Ver como funciona
          </a>
        </div>

        <%# Micro-copy %>
        <p class="mt-4 text-xs text-(--color-text-muted)">
          Grátis para começar &middot; Cancele quando quiser
        </p>
      </div>

      <%# ── Right: WhatsApp mockup ── %>
      <div class="flex justify-center lg:justify-end">
        <div class="w-full max-w-xs sm:max-w-sm">

          <%# Chat card %>
          <div class="rounded-3xl shadow-2xl overflow-hidden border border-gray-200/80 ring-1 ring-black/5">

            <%# Chat header — green bar %>
            <div class="bg-(--color-brand) px-4 py-3 flex items-center gap-3">
              <button class="text-white/70 shrink-0" tabindex="-1">
                <i class="ph ph-arrow-left text-lg"></i>
              </button>
              <div class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center shrink-0">
                <i class="ph ph-user text-white"></i>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-white font-semibold text-sm leading-tight truncate">João Silva</p>
                <p class="text-white/70 text-xs">online</p>
              </div>
              <div class="flex items-center gap-3.5 text-white/70 shrink-0">
                <i class="ph ph-video-camera text-base"></i>
                <i class="ph ph-phone text-base"></i>
              </div>
            </div>

            <%# Chat body %>
            <div class="bg-stone-100 px-3 py-4 space-y-3" style="min-height:380px">

              <%# Time badge %>
              <div class="flex justify-center">
                <span class="bg-white/80 text-gray-400 text-xs px-3 py-1 rounded-full shadow-sm">Hoje</span>
              </div>

              <%# Incoming audio message %>
              <div class="max-w-xs">
                <div class="bg-white rounded-2xl rounded-tl-sm px-3 py-2.5 shadow-sm inline-flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-full bg-(--color-brand-light) flex items-center justify-center shrink-0">
                    <i class="ph ph-microphone text-(--color-brand) text-sm"></i>
                  </div>
                  <%# Waveform bars — heights span h-1..h-6 so Tailwind JIT picks them up %>
                  <div class="flex items-center gap-px">
                    <div class="w-0.5 h-2 bg-gray-300 rounded-full"></div>
                    <div class="w-0.5 h-4 bg-gray-300 rounded-full"></div>
                    <div class="w-0.5 h-3 bg-gray-300 rounded-full"></div>
                    <div class="w-0.5 h-5 bg-gray-400 rounded-full"></div>
                    <div class="w-0.5 h-3 bg-gray-300 rounded-full"></div>
                    <div class="w-0.5 h-6 bg-gray-400 rounded-full"></div>
                    <div class="w-0.5 h-4 bg-gray-300 rounded-full"></div>
                    <div class="w-0.5 h-5 bg-gray-400 rounded-full"></div>
                    <div class="w-0.5 h-3 bg-gray-300 rounded-full"></div>
                    <div class="w-0.5 h-4 bg-gray-400 rounded-full"></div>
                    <div class="w-0.5 h-2 bg-gray-300 rounded-full"></div>
                    <div class="w-0.5 h-3 bg-gray-300 rounded-full"></div>
                    <div class="w-0.5 h-5 bg-gray-400 rounded-full"></div>
                    <div class="w-0.5 h-4 bg-gray-300 rounded-full"></div>
                    <div class="w-0.5 h-2 bg-gray-300 rounded-full"></div>
                  </div>
                  <span class="text-xs text-gray-400 shrink-0">0:47</span>
                </div>
              </div>

              <%# EscreveZap reply bubble (right-aligned) %>
              <div class="flex justify-end">
                <div class="bg-(--color-brand-light) rounded-2xl rounded-tr-sm px-4 py-3 shadow-sm max-w-xs">
                  <p class="text-xs font-bold text-(--color-brand) mb-1.5">📝 Resumo rápido</p>
                  <p class="text-xs text-(--color-accent) leading-relaxed mb-3">
                    Ele quer confirmar a reunião de amanhã às 14h e pediu para revisar o contrato antes.
                  </p>
                  <div class="h-px bg-(--color-brand)/20 mb-3"></div>
                  <p class="text-xs font-bold text-(--color-brand) mb-1.5">📄 Transcrição completa</p>
                  <p class="text-xs text-(--color-text-muted) italic leading-relaxed">
                    "Então, amanhã às duas... você pode confirmar? E aquele contrato precisa ser revisado antes, tá? Me fala."
                  </p>
                  <div class="flex items-center justify-between mt-2.5">
                    <span class="text-xs text-(--color-brand)/50" style="font-size:10px">via EscreveZap ✨</span>
                    <span class="text-(--color-brand)" style="font-size:10px">✓✓</span>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <p class="text-center text-xs text-(--color-text-muted) mt-3">
            Transcrição aparece automaticamente na conversa
          </p>
        </div>
      </div>

    </div>
  </div>
</section>


<%# ============================================================== %>
<%# TRUST BAR %>
<%# ============================================================== %>
<section class="bg-(--color-surface) border-y border-gray-100 py-8">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-5">
      <% [
        { icon: "ph-check-circle",   text: "Funciona no seu próprio WhatsApp" },
        { icon: "ph-sim-card",       text: "Sem trocar de número" },
        { icon: "ph-timer",          text: "Configure em menos de 2 minutos" },
        { icon: "ph-smiley",         text: "Reaja com qualquer emoji para transcrever" }
      ].each do |t| %>
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-(--color-brand-subtle) flex items-center justify-center shrink-0">
            <i class="ph <%= t[:icon] %> text-(--color-brand) text-sm"></i>
          </div>
          <span class="text-sm text-(--color-text)"><%= t[:text] %></span>
        </div>
      <% end %>
    </div>
  </div>
</section>


<%# ============================================================== %>
<%# HOW IT WORKS %>
<%# ============================================================== %>
<section id="como-funciona" class="py-20 md:py-28">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-extrabold text-(--color-text) tracking-tight">
        Funciona em menos de 2 minutos.
      </h2>
      <p class="mt-3 text-(--color-text-muted) text-lg">Três passos para nunca mais precisar esperar para ouvir.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% [
        {
          num: "1",
          icon: "ph-hash",
          title: "Conecte seu WhatsApp",
          body:  "Digite seu número para gerar um código de 8 dígitos. Sua conta conecta em segundos."
        },
        {
          num: "2",
          icon: "ph-smiley",
          title: "Reaja com qualquer emoji no áudio",
          body:  "Recebeu um áudio e não pode ouvir? Basta reagir com qualquer emoji (👍, ❤️, 😂) na mensagem."
        },
        {
          num: "3",
          icon: "ph-chat-text",
          title: "Receba no WhatsApp",
          body:  "A transcrição aparece automaticamente respondendo o áudio original. Sem abrir outro app."
        }
      ].each do |step| %>
        <div class="text-center">
          <div class="relative inline-block mb-5">
            <div class="w-16 h-16 rounded-2xl bg-(--color-brand-light) flex items-center justify-center">
              <i class="ph <%= step[:icon] %> text-(--color-brand) text-3xl"></i>
            </div>
            <div class="absolute -top-1.5 -right-1.5 w-6 h-6 rounded-full bg-(--color-brand) text-white text-xs font-bold flex items-center justify-center">
              <%= step[:num] %>
            </div>
          </div>
          <h3 class="text-base font-bold text-(--color-text) mb-2"><%= step[:title] %></h3>
          <p class="text-sm text-(--color-text-muted) leading-relaxed"><%= step[:body] %></p>
        </div>
      <% end %>
    </div>

    <%# Arrow connectors — desktop only %>
    <%# (decorative, handled by grid gap + natural reading flow) %>

    <div class="mt-12 text-center">
      <%= link_to new_user_session_path,
            class: "inline-flex items-center gap-2 bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold px-6 py-3.5 rounded-xl transition-colors text-sm" do %>
        <i class="ph ph-whatsapp-logo text-lg"></i>
        Começar agora
      <% end %>
    </div>
  </div>
</section>


<%# ============================================================== %>
<%# USE CASES — "Quando usar o EscreveZap" %>
<%# ============================================================== %>
<section id="quando-usar" class="bg-(--color-brand-subtle) py-20 md:py-28" aria-labelledby="use-cases-title">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 id="use-cases-title" class="text-3xl md:text-4xl font-extrabold text-(--color-text) tracking-tight">
        Quando usar o EscreveZap?
      </h2>
      <p class="mt-3 text-(--color-text-muted) text-lg max-w-xl mx-auto">
        Sempre que ouvir um áudio do WhatsApp não for uma opção — ou quando ler é simplesmente mais rápido.
      </p>
    </div>

    <ul class="grid grid-cols-2 md:grid-cols-4 gap-4 list-none">
      <% HomeContent::USE_CASES.each do |s| %>
        <li class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <div class="text-2xl mb-2" aria-hidden="true"><%= s[:emoji] %></div>
          <h3 class="font-semibold text-(--color-text) text-sm mb-1"><%= s[:title] %></h3>
          <p class="text-xs text-(--color-text-muted) leading-relaxed"><%= s[:body] %></p>
        </li>
      <% end %>
    </ul>

  </div>
</section>


<%# ============================================================== %>
<%# WOW — BEFORE / AFTER — Basic vs Pro %>
<%# ============================================================== %>
