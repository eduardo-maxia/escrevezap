<% content_for :title, "WhatsApp" %>

<div class="py-6">
  <h1 class="text-xl font-bold text-(--color-text) mb-6">WhatsApp</h1>

  <% if @waha_session&.working? %>
    <div class="bg-(--color-surface) border border-(--color-border) rounded-2xl overflow-hidden">
      <div class="flex items-center gap-4 px-5 py-4 border-b border-(--color-border)">
        <% if @waha_session.avatar_url.present? %>
          <img src="<%= @waha_session.avatar_url %>" alt="" class="w-12 h-12 rounded-full object-cover flex-shrink-0">
        <% else %>
          <div class="w-12 h-12 rounded-full bg-(--color-brand-light) flex items-center justify-center flex-shrink-0">
            <i class="ph ph-whatsapp-logo text-2xl text-(--color-brand)"></i>
          </div>
        <% end %>
        <div class="min-w-0">
          <p class="text-sm font-semibold text-(--color-text) truncate">
            <%= @waha_session.display_name.presence || "WhatsApp conectado" %>
          </p>
          <p class="text-xs text-(--color-text-muted)"><%= format_phone(@waha_session.waha_chat_id&.split("@")&.first) %></p>
        </div>
        <span class="ml-auto flex-shrink-0 inline-flex items-center gap-1.5 bg-(--color-success-light) text-(--color-success) text-xs font-medium px-2.5 py-1 rounded-full">
          <span class="w-1.5 h-1.5 rounded-full bg-(--color-success)"></span>
          Conectado
        </span>
      </div>
      <div class="px-5 py-4">
        <%= button_to app_waha_session_path, method: :delete,
              data: {
                turbo_confirm: "Desconectar o WhatsApp vai pausar todas as transcrições. Confirmar?",
                controller: "loadable",
                "loadable-loading-text-value": "Desconectando..."
              },
              class: "w-full flex items-center justify-center gap-2 border border-(--color-border) text-(--color-text-muted) hover:border-(--color-danger) hover:text-(--color-danger) font-medium px-4 py-2.5 rounded-xl text-sm transition-colors disabled:opacity-60 disabled:cursor-not-allowed" do %>
          <i class="ph ph-plug text-base"></i>
          Desconectar WhatsApp
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="bg-(--color-surface) border border-(--color-border) rounded-2xl overflow-hidden"
         data-controller="connect"
         data-connect-pairing-url-value="<%= pairing_code_app_waha_session_path(format: :json) %>"
         data-connect-reconnect-url-value="<%= reconnect_app_waha_session_path(format: :json) %>"
         data-connect-dashboard-url-value="<%= authenticated_root_path %>"
         data-connect-status-url-value="<%= status_app_waha_session_path(format: :json) %>"
         data-connect-status-value="<%= @waha_session&.waha_status || 'pending' %>">

      <div class="px-5 py-4 border-b border-(--color-border) flex items-center gap-2" data-connect-target="statusBadge">
        <span class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse" data-connect-target="statusDot"></span>
        <span class="text-sm text-(--color-text-muted)" data-connect-target="statusText">
          <%= case @waha_session&.waha_status
              when "stopped", "failed" then "Desconectado"
              when "starting"          then "Iniciando..."
              when "scan_qr_code"      then "Aguardando QR Code..."
              else                          "Verificando..."
              end %>
        </span>
      </div>



      <div data-connect-target="pairingPanel" class="px-5 py-5">
        <div data-connect-target="phoneFormWrapper">
          <p class="text-sm text-(--color-text-muted) mb-4 leading-relaxed">
            Digite seu número do WhatsApp para receber um código de emparelhamento de 8 dígitos.
          </p>
          <form data-action="submit->connect#requestPairingCode" novalidate>
            <div class="mb-3">
              <input type="tel"
                     name="phone_number"
                     inputmode="numeric"
                     autocomplete="tel"
                     class="w-full bg-(--color-surface) border border-(--color-border) rounded-xl px-4 py-3 text-sm text-(--color-text) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-transparent transition"
                     data-connect-target="phoneInput">
            </div>

            <button type="submit"
                    data-connect-target="pairingSubmitBtn"
                    class="w-full flex items-center justify-center gap-2 bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold px-4 py-3 rounded-xl text-sm transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
              <span data-connect-target="pairingBtnText">Receber código</span>
            </button>

            <div data-connect-target="pairingError" class="hidden mt-3 items-center gap-2 rounded-lg bg-(--color-danger-light) border border-(--color-danger) px-3 py-2.5 text-xs text-(--color-danger)">
              <i class="ph ph-warning-circle flex-shrink-0"></i>
              <span data-connect-target="pairingErrorText"></span>
            </div>
          </form>
        </div>

        <div data-connect-target="codeWrapper" class="hidden flex-col items-center gap-5 py-2">
          <div class="text-center">
            <p class="text-sm text-(--color-text-muted) mb-3 leading-relaxed">
              No WhatsApp, vá em <strong>Dispositivos conectados</strong> → <strong>Vincular com número de telefone</strong> e insira o código:
            </p>
            <div class="inline-flex items-center justify-center bg-(--color-brand-subtle) border-2 border-(--color-brand-light) rounded-2xl px-8 py-5">
              <span class="font-mono text-3xl font-bold tracking-[0.2em] text-(--color-brand)" data-connect-target="codeText">- - - -</span>
            </div>
          </div>

          <button type="button"
                  data-action="click->connect#resetPairing"
                  class="flex items-center gap-1.5 text-xs text-(--color-text-muted) hover:text-(--color-text) transition-colors">
            <i class="ph ph-arrow-u-up-left"></i>
            Usar outro número
          </button>
        </div>
      </div>

      <div data-connect-target="errorPanel" class="hidden px-5 py-8 text-center">
        <div class="flex flex-col items-center gap-5">
          <div class="w-16 h-16 rounded-full bg-(--color-danger-light) flex items-center justify-center">
            <i class="ph ph-wifi-slash text-4xl text-(--color-danger)"></i>
          </div>
          <div>
            <h3 class="text-lg font-bold text-(--color-text)" data-connect-target="errorTitle">Falha ao conectar</h3>
            <p class="text-sm text-(--color-text-muted) mt-1 max-w-xs" data-connect-target="errorMessage">Tente iniciar novamente.</p>
          </div>
          <button type="button"
                  data-action="click->connect#reconnect"
                  data-connect-target="reconnectButton"
                  class="inline-flex items-center justify-center gap-2 bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold px-6 py-3 rounded-xl text-sm transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
            <i class="ph ph-arrows-clockwise text-base"></i>
            <span data-connect-target="reconnectButtonText">Reiniciar sessão</span>
          </button>
        </div>
      </div>

      <div data-connect-target="successPanel" class="hidden px-5 py-8 text-center">
        <div class="flex flex-col items-center gap-4">
          <div class="w-16 h-16 rounded-full bg-(--color-brand-light) flex items-center justify-center">
            <i class="ph ph-check-circle text-4xl text-(--color-brand)"></i>
          </div>
          <div>
            <h3 class="text-lg font-bold text-(--color-text)">Conectado com sucesso!</h3>
            <p class="text-sm text-(--color-text-muted) mt-1">Seu WhatsApp está pronto para transcrever.</p>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
