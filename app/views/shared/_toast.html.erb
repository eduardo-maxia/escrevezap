<%# Toast container — rendered once in application layout.
    Toasts are triggered via window.toast('message', { type: 'success' }) %>
<div data-controller="toast"
     data-toast-position-value="top-right"
     data-toast-layout-value="default"
     data-toast-auto-dismiss-duration-value="4500">
  <ul data-toast-target="container"
      data-action="mouseenter->toast#handleMouseEnter mouseleave->toast#handleMouseLeave"
      class="fixed block w-full z-[9999] max-w-[320px] sm:max-w-xs right-0 top-0 overflow-visible"
      style="transition: height 300ms ease;">
  </ul>
</div>

