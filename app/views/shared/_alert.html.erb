<%# Flowbite-style dismissible alert. %>
<%# Usage: %>
<%#   render "shared/alert", type: :danger,  message: flash[:alert] %>
<%#   render "shared/alert", type: :success, message: flash[:notice] %>
<%#   render "shared/alert", type: :warning, message: "..." %>
<%#   render "shared/alert", type: :info,    message: "...", dismissible: false %>
<%
  type        = local_assigns.fetch(:type, :info).to_sym
  message     = local_assigns[:message]
  dismissible = local_assigns.fetch(:dismissible, true)
  return if message.blank?

  palettes = {
    danger:  { text: "--color-danger",  bg: "--color-danger-light",  icon: "ph-warning-circle" },
    warning: { text: "--color-warning", bg: "--color-warning-light", icon: "ph-warning" },
    success: { text: "--color-success", bg: "--color-success-light", icon: "ph-check-circle" },
    info:    { text: "--color-brand",   bg: "--color-brand-light",   icon: "ph-info" }
  }
  palette = palettes[type] || palettes[:info]

  dom_id = "alert-#{SecureRandom.hex(4)}"
%>
<div id="<%= dom_id %>"
     role="alert"
     data-turbo-temporary
     class="flex items-center p-4 mb-4 text-sm font-medium rounded-lg text-(<%= palette[:text] %>) bg-(<%= palette[:bg] %>)">
  <i class="ph-fill <%= palette[:icon] %> shrink-0 text-base"></i>
  <span class="sr-only">Aviso</span>
  <div class="ms-3 text-left flex-1"><%= message %></div>
  <% if dismissible %>
    <button type="button"
            data-dismiss-target="#<%= dom_id %>"
            aria-label="Fechar"
            class="ms-3 -mx-1.5 -my-1.5 rounded-lg p-1.5 inline-flex items-center justify-center h-7 w-7 hover:bg-black/5 focus:ring-2 focus:ring-(<%= palette[:text] %>)/30 transition">
      <i class="ph ph-x text-sm"></i>
    </button>
  <% end %>
</div>
