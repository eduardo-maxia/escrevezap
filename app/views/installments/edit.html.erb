<% input_cls = "w-full px-3 py-2.5 bg-(--color-surface) border border-(--color-border) rounded-lg text-sm text-(--color-text) focus:outline-none focus:border-(--color-brand) focus:ring-1 focus:ring-(--color-brand) transition-colors" %>

<turbo-frame id="modal">
  <dialog data-controller="modal"
          class="app-modal md:max-w-md">

    <div class="app-modal-handle"></div>

    <%# ── Header ── %>
    <div class="flex items-start justify-between gap-4 px-6 py-5 border-b border-(--color-border) flex-shrink-0">
      <div>
        <p class="text-xs text-(--color-text-muted) mb-0.5">
          <%= I18n.l(@installment.due_date, format: "%B de %Y").capitalize %>
        </p>
        <h2 class="text-base font-bold text-(--color-text)">Editar parcela</h2>
      </div>
      <button type="button"
              data-action="click->modal#close"
              class="p-1.5 rounded-lg text-(--color-text-muted) hover:text-(--color-text) hover:bg-(--color-surface-raised) transition-colors flex-shrink-0 mt-0.5">
        <i class="ph ph-x text-sm"></i>
      </button>
    </div>

    <%# ── Body ── %>
    <div class="px-6 py-5">
      <% if @installment.errors.any? %>
        <div class="mb-4 p-3 bg-(--color-danger-light) border border-(--color-danger) rounded-lg text-sm text-(--color-danger)">
          <%= @installment.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <%= form_with model: @installment, url: installment_path(@installment), method: :patch,
            html: { multipart: true },
            data: { turbo_frame: "_top" } do |f| %>
        <div class="space-y-4">

          <%# Valor %>
          <div data-controller="amount-input">
            <label class="block text-xs font-medium text-(--color-text-muted) mb-1.5">
              Valor <span class="text-(--color-danger)">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-3 flex items-center text-sm text-(--color-text-muted) pointer-events-none select-none">R$</span>
              <input type="text"
                     inputmode="numeric"
                     placeholder="0,00"
                     required
                     data-amount-input-target="display"
                     data-action="input->amount-input#format"
                     class="<%= input_cls %> pl-9">
              <input type="hidden"
                     name="installment[amount]"
                     value="<%= @installment.amount %>"
                     data-amount-input-target="hidden">
            </div>
          </div>

          <%# Vencimento %>
          <div>
            <label class="block text-xs font-medium text-(--color-text-muted) mb-1.5">
              Vencimento <span class="text-(--color-danger)">*</span>
            </label>
            <%= f.date_field :due_date, required: true, value: @installment.due_date, class: input_cls %>
          </div>

          <%# Status %>
          <div>
            <label class="block text-xs font-medium text-(--color-text-muted) mb-1.5">Status</label>
            <%= f.select :status,
                  [["Pendente", "pending"], ["Paga", "paid"], ["Cancelada", "cancelled"]],
                  { selected: @installment.status },
                  class: input_cls %>
          </div>

          <%# Comprovante %>
          <div>
            <label class="block text-xs font-medium text-(--color-text-muted) mb-1.5">Comprovante</label>
            <% if @installment.proof_image.attached? %>
              <div class="flex items-start gap-3 p-2 border border-(--color-border) rounded-lg">
                <%= link_to url_for(@installment.proof_image), target: "_blank",
                      class: "block flex-shrink-0 rounded-md overflow-hidden border border-(--color-border) hover:border-(--color-brand) transition-colors" do %>
                  <% if @installment.proof_image.image? %>
                    <%= image_tag @installment.proof_image.variant(resize_to_fill: [96, 96]).processed,
                          class: "w-20 h-20 object-cover" %>
                  <% else %>
                    <div class="w-20 h-20 flex items-center justify-center bg-(--color-surface-muted)">
                      <i class="ph ph-file-text text-2xl text-(--color-text-muted)"></i>
                    </div>
                  <% end %>
                <% end %>
                <div class="flex-1 min-w-0">
                  <p class="text-xs text-(--color-text) truncate"><%= @installment.proof_image.filename %></p>
                  <p class="text-xs text-(--color-text-subtle) mt-0.5">
                    <%= number_to_human_size(@installment.proof_image.byte_size) %>
                  </p>
                  <label class="inline-flex items-center gap-1 mt-2 px-2 py-1 border border-(--color-border) rounded-md text-xs text-(--color-text-muted) hover:text-(--color-text) cursor-pointer">
                    <i class="ph ph-upload-simple text-xs"></i> Substituir
                    <%= f.file_field :proof_image, accept: "image/*,application/pdf", class: "hidden" %>
                  </label>
                </div>
              </div>
            <% else %>
              <%= f.file_field :proof_image, accept: "image/*,application/pdf",
                    class: "block w-full text-xs text-(--color-text-muted) file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border file:border-(--color-border) file:bg-(--color-surface-muted) file:text-(--color-text) file:cursor-pointer hover:file:bg-(--color-surface-raised)" %>
              <p class="text-xs text-(--color-text-subtle) mt-1.5">Anexe um comprovante. Marque a parcela como <strong>Paga</strong> para mantê-lo salvo.</p>
            <% end %>
          </div>

        </div>

        <div class="flex justify-end gap-3 mt-6">
          <button type="button"
                  data-action="click->modal#close"
                  class="px-4 py-2 border border-(--color-border) text-sm font-medium text-(--color-text-muted) rounded-lg hover:text-(--color-text) transition-colors">
            Cancelar
          </button>
          <%= f.submit "Salvar alterações",
                class: "px-4 py-2 bg-(--color-brand) text-(--color-text-inverse) text-sm font-medium rounded-lg hover:bg-(--color-brand-dark) transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>

  </dialog>
</turbo-frame>
