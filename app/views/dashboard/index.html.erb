<% content_for :page_title, "Dashboard" %>

<div class="p-4 md:p-6 space-y-6">

<% if @feature_campanhas %>

  <%# ── FULL MODE ─────────────────────────────────────────────────── %>

  <%# Critical: chips down with active campaigns %>
  <% if @critical_chips&.any? %>
    <div class="flex items-start gap-4 bg-(--color-danger-light) border-2 border-(--color-danger) rounded-xl p-5">
      <i class="ph ph-warning-octagon text-(--color-danger) text-3xl flex-shrink-0 mt-0.5"></i>
      <div class="flex-1 min-w-0">
        <p class="font-bold text-(--color-danger) text-lg leading-tight">Atenção: cobranças não estão sendo enviadas</p>
        <p class="text-sm text-(--color-text) mt-1 mb-3">
          Os chips abaixo estão <strong>desconectados</strong> e possuem campanhas ativas.
          Nenhuma mensagem de cobrança será disparada até reconectar o WhatsApp.
        </p>
        <ul class="space-y-1.5 mb-4">
          <% @critical_chips.each do |chip| %>
            <% n = chip.campaigns.where(status: "active").count %>
            <li class="flex items-center gap-2 text-sm">
              <i class="ph ph-sim-card text-(--color-danger) flex-shrink-0"></i>
              <span class="font-semibold text-(--color-danger)"><%= chip.name %></span>
              <span class="text-(--color-text-muted)">— <%= n %> campanha<%= n == 1 ? "" : "s" %> ativa<%= n == 1 ? "" : "s" %></span>
            </li>
          <% end %>
        </ul>
        <%= link_to chips_path,
              class: "inline-flex items-center gap-2 px-4 py-2 bg-(--color-danger) text-(--color-text-inverse) text-sm font-semibold rounded-lg hover:opacity-90 transition-opacity" do %>
          <i class="ph ph-wifi-slash text-base"></i>
          Reconectar chips agora
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Welcome %>
  <div>
    <h2 class="text-2xl font-bold text-(--color-text)">
      Olá, <%= current_user.name || current_user.email.split("@").first.capitalize %>!
    </h2>
    <p class="text-(--color-text-muted) text-sm mt-1">
      Aqui está um resumo da sua operação de cobranças.
    </p>
  </div>

  <%# KPI Cards %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-5 flex items-start justify-between">
      <div>
        <p class="text-sm font-medium text-(--color-text-muted)">Campanhas</p>
        <p class="text-3xl font-bold text-(--color-text) mt-1"><%= @campaigns_count %></p>
        <p class="text-sm text-(--color-text-subtle) mt-1">
          <span class="text-(--color-success) font-medium"><%= @active_campaigns %></span> ativas
        </p>
      </div>
      <div class="w-10 h-10 rounded-lg bg-(--color-brand-light) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-megaphone text-(--color-brand) text-xl"></i>
      </div>
    </div>

    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-5 flex items-start justify-between">
      <div>
        <p class="text-sm font-medium text-(--color-text-muted)">Clientes</p>
        <p class="text-3xl font-bold text-(--color-text) mt-1"><%= @clients_count %></p>
        <p class="text-sm text-(--color-text-subtle) mt-1">Cadastrados</p>
      </div>
      <div class="w-10 h-10 rounded-lg bg-(--color-info-light) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-users-three text-(--color-info) text-xl"></i>
      </div>
    </div>

    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-5 flex items-start justify-between">
      <div>
        <p class="text-sm font-medium text-(--color-text-muted)">Parcelas Pendentes</p>
        <p class="text-3xl font-bold text-(--color-text) mt-1"><%= @pending_count %></p>
        <p class="text-sm text-(--color-text-subtle) mt-1">
          <%= number_to_currency(@pending_amount, unit: "R$\u00a0", separator: ",", delimiter: ".", precision: 2) %>
        </p>
      </div>
      <div class="w-10 h-10 rounded-lg bg-(--color-warning-light) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-receipt text-(--color-warning) text-xl"></i>
      </div>
    </div>

    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-5 flex items-start justify-between">
      <div>
        <p class="text-sm font-medium text-(--color-text-muted)">Chips WhatsApp</p>
        <p class="text-3xl font-bold text-(--color-text) mt-1"><%= @chips_count %></p>
        <p class="text-sm text-(--color-text-subtle) mt-1">Números cadastrados</p>
      </div>
      <div class="w-10 h-10 rounded-lg bg-(--color-brand-light) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-device-mobile text-(--color-brand) text-xl"></i>
      </div>
    </div>
  </div>

  <%# No company warning %>
  <% unless current_user.company %>
    <div class="flex items-start gap-4 bg-(--color-warning-light) border border-(--color-warning) rounded-xl p-5">
      <i class="ph ph-warning text-(--color-warning) text-2xl flex-shrink-0 mt-0.5"></i>
      <div>
        <p class="font-semibold text-(--color-text)">Sua conta não está vinculada a uma empresa</p>
        <p class="text-sm text-(--color-text-muted) mt-1">
          Entre em contato com o administrador para associar sua conta a uma empresa.
        </p>
      </div>
    </div>
  <% end %>

  <%# Bottom grid: Campaigns + Chips %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">

    <%# Campanhas recentes %>
    <div class="lg:col-span-2 bg-(--color-surface) rounded-xl border border-(--color-border)">
      <div class="px-5 py-4 border-b border-(--color-border) flex items-center justify-between">
        <h3 class="font-semibold text-(--color-text)">Campanhas Recentes</h3>
        <%= link_to "Ver todas →", campaigns_path, class: "text-sm text-(--color-brand) hover:text-(--color-brand-dark) font-medium" %>
      </div>

      <% if @recent_campaigns.empty? %>
        <div class="py-14 text-center">
          <div class="w-12 h-12 rounded-full bg-(--color-surface-raised) flex items-center justify-center mx-auto mb-3">
            <i class="ph ph-megaphone text-(--color-text-subtle) text-2xl"></i>
          </div>
          <p class="text-(--color-text-muted) text-sm font-medium">Nenhuma campanha ainda</p>
          <p class="text-(--color-text-subtle) text-xs mt-1">Crie sua primeira campanha para começar</p>
        </div>
      <% else %>
        <div class="divide-y divide-(--color-border)">
          <% @recent_campaigns.each do |campaign| %>
            <%
              badge_classes = case campaign.status
              when "active"   then "bg-(--color-success-light) text-(--color-success)"
              when "paused"   then "bg-(--color-warning-light) text-(--color-warning)"
              when "finished" then "bg-(--color-surface-raised) text-(--color-text-muted)"
              else "bg-(--color-info-light) text-(--color-info)"
              end
              status_label = { "active" => "Ativa", "paused" => "Pausada", "finished" => "Finalizada", "draft" => "Rascunho" }[campaign.status] || campaign.status&.capitalize
            %>
            <div class="px-5 py-4 flex items-center justify-between gap-4">
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-8 h-8 rounded-lg bg-(--color-brand-subtle) flex items-center justify-center flex-shrink-0">
                  <i class="ph ph-megaphone text-(--color-brand) text-sm"></i>
                </div>
                <div class="min-w-0">
                  <p class="text-sm font-medium text-(--color-text) truncate"><%= campaign.name %></p>
                  <p class="text-xs text-(--color-text-muted) truncate">
                    <i class="ph ph-device-mobile"></i>
                    <%= campaign.chip&.name || "Sem chip associado" %>
                  </p>
                </div>
              </div>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium flex-shrink-0 <%= badge_classes %>">
                <%= status_label %>
              </span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Status dos Chips %>
    <div class="bg-(--color-surface) rounded-xl border border-(--color-border)">
      <div class="px-5 py-4 border-b border-(--color-border)">
        <h3 class="font-semibold text-(--color-text)">Status dos Chips</h3>
      </div>

      <% if @chips.empty? %>
        <div class="py-14 text-center">
          <div class="w-12 h-12 rounded-full bg-(--color-surface-raised) flex items-center justify-center mx-auto mb-3">
            <i class="ph ph-device-mobile text-(--color-text-subtle) text-2xl"></i>
          </div>
          <p class="text-(--color-text-muted) text-sm font-medium">Nenhum chip cadastrado</p>
          <p class="text-(--color-text-subtle) text-xs mt-1">Adicione um número WhatsApp</p>
        </div>
      <% else %>
        <div class="p-3 space-y-2">
          <% @chips.each do |chip| %>
            <% connected = chip.waha_status == "working" %>
            <% never_connected = chip.waha_chat_id.blank? %>
            <%= link_to chip_path(chip), class: "flex items-center gap-3 p-3 rounded-lg #{never_connected ? 'bg-(--color-warning-light)/50 border border-(--color-warning)/40' : 'bg-(--color-surface-muted)'} hover:opacity-80 transition-opacity" do %>
              <div class="relative flex-shrink-0">
                <div class="w-8 h-8 rounded-full #{never_connected ? 'bg-(--color-warning-light)' : 'bg-(--color-sidebar-bg)'} flex items-center justify-center">
                  <i class="ph #{never_connected ? 'ph-warning text-(--color-warning)' : 'ph-device-mobile text-(--color-text-inverse)'} text-sm"></i>
                </div>
                <% unless never_connected %>
                  <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full border-2 border-(--color-surface) <%= connected ? 'bg-(--color-success)' : 'bg-(--color-text-subtle)' %>"></span>
                <% end %>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-(--color-text) truncate"><%= chip.name %></p>
                <p class="text-xs truncate <%= never_connected ? 'text-(--color-warning) font-medium' : connected ? 'text-(--color-success)' : 'text-(--color-text-subtle)' %>">
                  <% if never_connected %>
                    Nunca conectado — toque para configurar
                  <% elsif connected %>
                    Conectado<% if chip.formatted_number.present? %> · <%= chip.formatted_number %><% end %>
                  <% else %>
                    <%= chip.waha_status.presence || "Desconectado" %>
                  <% end %>
                </p>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>

<% else %>

  <%# ── SIMPLE MODE (feature_campanhas = false) ───────────────────── %>

  <%
    # Shared helpers for both mobile and desktop variants
    chip_status_label, chip_status_icon, chip_status_fg, chip_status_bg =
      case @chip&.waha_status
      when "working"      then ["Conectado",       "ph-check-circle",   "--color-success",    "--color-success-light"]
      when "scan_qr_code" then ["Aguardando QR",   "ph-qr-code",        "--color-warning",    "--color-warning-light"]
      when "starting"     then ["Iniciando...",    "ph-circle-dashed",  "--color-warning",    "--color-warning-light"]
      when "failed"       then ["Falha",           "ph-warning-circle", "--color-danger",     "--color-danger-light"]
      when "stopped"      then ["Parado",          "ph-pause-circle",   "--color-text-muted", "--color-surface-raised"]
      else                     ["Não configurado", "ph-plug",           "--color-text-muted", "--color-surface-raised"]
      end
    chip_working = @chip&.waha_status == "working"
    first_name   = (current_user.name || current_user.email.split("@").first).to_s.split.first.capitalize
  %>

  <%# ════════════════════════════════════════════════════════════════ %>
  <%# MOBILE LAYOUT — focused, action-first                             %>
  <%# ════════════════════════════════════════════════════════════════ %>
  <div class="md:hidden space-y-4">

    <%# Greeting %>
    <div class="pt-1">
      <h2 class="text-xl font-bold text-(--color-text)">Olá, <%= first_name %>!</h2>
      <p class="text-(--color-text-muted) text-xs mt-0.5">
        <%= I18n.l(Date.today, format: "%A, %d de %B").capitalize rescue Date.today.strftime("%d/%m/%Y") %>
      </p>
    </div>

    <%# 1. WhatsApp status — most critical (hero card) %>
    <% if @chip && @chip.waha_chat_id.blank? %>
      <%# Never connected — chip created but WhatsApp never paired %>
      <%= link_to chip_path(@chip),
            class: "block rounded-xl border-2 border-(--color-warning) bg-(--color-warning-light)/40 p-4" do %>
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-full bg-(--color-warning-light) flex items-center justify-center flex-shrink-0">
            <i class="ph ph-warning text-(--color-warning) text-2xl"></i>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-(--color-warning) leading-none mb-1">WhatsApp não conectado</p>
            <p class="text-sm font-bold text-(--color-text)">Conecte para enviar cobranças</p>
            <span class="inline-flex items-center gap-1 mt-1 text-[11px] font-medium text-(--color-warning)">
              <i class="ph ph-arrow-right"></i>
              Toque para configurar
            </span>
          </div>
          <i class="ph ph-caret-right text-(--color-text-subtle) text-lg flex-shrink-0"></i>
        </div>
      <% end %>
    <% elsif @chip %>
      <%= link_to chip_path(@chip),
            class: "block rounded-xl border #{chip_working ? 'border-(--color-success) bg-(--color-success-light)/40' : 'border-(--color-danger) bg-(--color-danger-light)/40'} p-4" do %>
        <div class="flex items-center gap-3">
          <% if chip_working && current_user.company&.profile_picture&.attached? %>
            <%= image_tag current_user.company.profile_picture,
                  class: "w-12 h-12 rounded-full object-cover ring-2 ring-(--color-success-light) flex-shrink-0" %>
          <% else %>
            <div class="w-12 h-12 rounded-full bg-(<%= chip_status_bg %>) flex items-center justify-center flex-shrink-0">
              <i class="ph ph-whatsapp-logo text-(<%= chip_status_fg %>) text-2xl"></i>
            </div>
          <% end %>
          <div class="flex-1 min-w-0">
            <p class="text-xs text-(--color-text-muted) leading-none mb-1">WhatsApp</p>
            <p class="text-sm font-bold text-(--color-text) truncate">
              <%= @chip.formatted_number.presence %>
            </p>
            <span class="inline-flex items-center gap-1 mt-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-(<%= chip_status_bg %>) text-(<%= chip_status_fg %>)">
              <i class="ph <%= chip_status_icon %>"></i>
              <%= chip_status_label %>
            </span>
          </div>
          <i class="ph ph-caret-right text-(--color-text-subtle) text-lg flex-shrink-0"></i>
        </div>
        <% unless chip_working %>
          <p class="text-xs text-(--color-danger) font-medium mt-3 leading-snug">
            <i class="ph ph-warning-circle align-middle"></i>
            Cobranças <strong>não estão sendo enviadas</strong>. Toque para reconectar.
          </p>
        <% end %>
      <% end %>
    <% else %>
      <%= link_to settings_cobranca_path,
            class: "block rounded-xl border-2 border-dashed border-(--color-border-strong) p-5 text-center" do %>
        <i class="ph ph-plus-circle text-(--color-text-muted) text-3xl block mb-1"></i>
        <p class="text-sm font-semibold text-(--color-text)">Conectar WhatsApp</p>
        <p class="text-xs text-(--color-text-muted) mt-0.5">Necessário para enviar cobranças</p>
      <% end %>
    <% end %>

    <%# 2. Faturamento do mês — hero number %>
    <div class="rounded-xl bg-(--color-sidebar-bg) text-(--color-text-inverse) p-5 overflow-hidden relative">
      <div class="relative z-10">
        <p class="text-xs font-medium text-(--color-text-inverse)/70 uppercase tracking-wide">Recebido em <%= I18n.l(Date.today, format: "%B").capitalize rescue Date.today.strftime("%B") %></p>
        <p class="text-3xl font-bold mt-1">
          <%= number_to_currency(@billing_month, unit: "R$\u00a0", separator: ",", delimiter: ".", precision: 2) %>
        </p>
        <% if @billing_trend %>
          <% up = @billing_trend >= 0 %>
          <p class="text-xs mt-2 flex items-center gap-1 text-(--color-text-inverse)/80">
            <i class="ph <%= up ? 'ph-trend-up text-(--color-success-light)' : 'ph-trend-down text-(--color-danger-light)' %>"></i>
            <span class="font-semibold <%= up ? 'text-(--color-success-light)' : 'text-(--color-danger-light)' %>">
              <%= up ? "+" : "" %><%= @billing_trend %>%
            </span>
            vs mês anterior
          </p>
        <% else %>
          <p class="text-xs mt-2 text-(--color-text-inverse)/70">Sem comparação disponível</p>
        <% end %>
      </div>
      <i class="ph-fill ph-currency-circle-dollar absolute -right-4 -bottom-4 text-7xl text-(--color-text-inverse)/10"></i>
    </div>

    <%# 3. Atrasadas + Próximas (2-col) %>
    <div class="grid grid-cols-2 gap-3">

      <%# Atrasadas — vermelho se houver %>
      <div class="rounded-xl p-4 border <%= @overdue_count > 0 ? 'border-(--color-danger) bg-(--color-danger-light)/40' : 'border-(--color-border) bg-(--color-surface)' %>">
        <div class="flex items-center gap-1.5 text-xs font-medium <%= @overdue_count > 0 ? 'text-(--color-danger)' : 'text-(--color-text-muted)' %>">
          <i class="ph ph-clock-countdown"></i>
          Atrasadas
        </div>
        <p class="text-xl font-bold mt-1 <%= @overdue_count > 0 ? 'text-(--color-danger)' : 'text-(--color-text)' %>">
          <%= number_to_currency(@overdue_amount, unit: "R$\u00a0", separator: ",", delimiter: ".", precision: 2) %>
        </p>
        <p class="text-[11px] text-(--color-text-muted) mt-0.5">
          <%= @overdue_count %> parcela<%= @overdue_count == 1 ? "" : "s" %>
        </p>
      </div>

      <%# Próximas 7 dias %>
      <div class="rounded-xl p-4 border border-(--color-border) bg-(--color-surface)">
        <div class="flex items-center gap-1.5 text-xs font-medium text-(--color-text-muted)">
          <i class="ph ph-calendar-dots"></i>
          Próximos 7 dias
        </div>
        <p class="text-xl font-bold mt-1 text-(--color-text)">
          <%= number_to_currency(@upcoming_amount, unit: "R$\u00a0", separator: ",", delimiter: ".", precision: 2) %>
        </p>
        <p class="text-[11px] text-(--color-text-muted) mt-0.5">
          <%= @upcoming_count %> parcela<%= @upcoming_count == 1 ? "" : "s" %>
        </p>
      </div>

    </div>

    <%# 4. A receber no mês — full width subtle bar %>
    <div class="rounded-xl border border-(--color-border) bg-(--color-surface) p-4">
      <div class="flex items-center justify-between gap-2">
        <div class="min-w-0">
          <p class="text-xs font-medium text-(--color-text-muted)">A receber no mês</p>
          <p class="text-lg font-bold text-(--color-warning) mt-0.5">
            <%= number_to_currency(@pending_month_amount, unit: "R$\u00a0", separator: ",", delimiter: ".", precision: 2) %>
          </p>
        </div>
        <div class="w-10 h-10 rounded-lg bg-(--color-warning-light) flex items-center justify-center flex-shrink-0">
          <i class="ph ph-receipt text-(--color-warning) text-xl"></i>
        </div>
      </div>
    </div>

    <%# 5. Recent pending installments — quick mark-as-paid %>
    <% if @recent_pending.any? %>
    <div class="rounded-xl border border-(--color-border) bg-(--color-surface) overflow-hidden">
      <div class="px-4 py-3 border-b border-(--color-border) flex items-center justify-between">
        <div>
          <h3 class="text-sm font-semibold text-(--color-text)">Pendências recentes</h3>
          <p class="text-[11px] text-(--color-text-muted)">Toque em <i class="ph ph-check-circle align-middle text-(--color-success)"></i> para dar baixa</p>
        </div>
        <%= link_to clients_path, class: "text-xs text-(--color-brand) font-semibold" do %>
          Ver todos <i class="ph ph-caret-right align-middle text-[10px]"></i>
        <% end %>
      </div>
      <ul class="divide-y divide-(--color-border)">
          <% @recent_pending.each do |inst| %>
            <%
              client    = inst.campaign_client.client
              days_late = (Date.today - inst.due_date).to_i
              overdue   = days_late > 0
              due_text  = if days_late == 0
                            "Vence hoje"
                          elsif days_late == 1
                            "1 dia atrasada"
                          elsif overdue
                            "#{days_late} dias atrasada"
                          else
                            I18n.l(inst.due_date, format: "%d/%m") rescue inst.due_date.strftime("%d/%m")
                          end
            %>
            <li class="flex items-center gap-3 px-4 py-3">
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-(--color-text) truncate"><%= client.name %></p>
                <div class="flex items-baseline gap-2 mt-0.5">
                  <span class="text-sm font-bold text-(--color-text)">
                    <%= number_to_currency(inst.amount, unit: "R$\u00a0", separator: ",", delimiter: ".", precision: 2) %>
                  </span>
                  <span class="text-[11px] font-medium <%= overdue ? 'text-(--color-danger)' : 'text-(--color-warning)' %>">
                    <%= due_text %>
                  </span>
                </div>
              </div>
              <%= button_to installment_path(inst),
                    method: :patch,
                    params: { installment: { status: "paid" } },
                    form: { class: "flex-shrink-0", data: { turbo_confirm: "Confirmar baixa de #{number_to_currency(inst.amount, unit: 'R$ ', separator: ',', delimiter: '.', precision: 2)} de #{client.name}?" } },
                    class: "flex items-center justify-center w-10 h-10 rounded-full bg-(--color-success-light) text-(--color-success) hover:bg-(--color-success) hover:text-(--color-text-inverse) transition-colors disabled:opacity-60",
                    data: { controller: "loadable", "loadable-spinner-only-value": "true" },
                    aria: { label: "Dar baixa" } do %>
                <i class="ph ph-check text-lg"></i>
              <% end %>
            </li>
          <% end %>
        </ul>
    </div>
    <% end %>

  </div>

  <%# ════════════════════════════════════════════════════════════════ %>
  <%# DESKTOP LAYOUT — full analytics                                   %>
  <%# ════════════════════════════════════════════════════════════════ %>
  <div class="hidden md:block space-y-6">

    <%# Welcome %>
    <div>
      <h2 class="text-2xl font-bold text-(--color-text)">Olá, <%= first_name %>!</h2>
      <p class="text-(--color-text-muted) text-sm mt-1">Aqui está o resumo das suas cobranças.</p>
    </div>

    <%# KPI cards — Flowbite style with trend %>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">

      <%# Faturamento do mês %>
      <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-5">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-medium text-(--color-text-muted) uppercase tracking-wide">Recebido no mês</span>
          <div class="w-8 h-8 rounded-lg bg-(--color-success-light) flex items-center justify-center">
            <i class="ph ph-trend-up text-(--color-success)"></i>
          </div>
        </div>
        <p class="text-2xl font-bold text-(--color-text)">
          <%= number_to_currency(@billing_month, unit: "R$\u00a0", separator: ",", delimiter: ".", precision: 2) %>
        </p>
        <% if @billing_trend %>
          <% up = @billing_trend >= 0 %>
          <p class="text-xs mt-1.5 flex items-center gap-1">
            <span class="inline-flex items-center gap-0.5 font-semibold <%= up ? 'text-(--color-success)' : 'text-(--color-danger)' %>">
              <i class="ph <%= up ? 'ph-arrow-up' : 'ph-arrow-down' %>"></i>
              <%= up ? "+" : "" %><%= @billing_trend %>%
            </span>
            <span class="text-(--color-text-muted)">vs mês anterior</span>
          </p>
        <% else %>
          <p class="text-xs mt-1.5 text-(--color-text-subtle)">Sem dados anteriores</p>
        <% end %>
      </div>

      <%# A receber no mês %>
      <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-5">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-medium text-(--color-text-muted) uppercase tracking-wide">A receber no mês</span>
          <div class="w-8 h-8 rounded-lg bg-(--color-warning-light) flex items-center justify-center">
            <i class="ph ph-receipt text-(--color-warning)"></i>
          </div>
        </div>
        <p class="text-2xl font-bold text-(--color-warning)">
          <%= number_to_currency(@pending_month_amount, unit: "R$\u00a0", separator: ",", delimiter: ".", precision: 2) %>
        </p>
        <p class="text-xs mt-1.5 text-(--color-text-muted)">
          Geral pendente: <%= number_to_currency(@pending_amount, unit: "R$\u00a0", separator: ",", delimiter: ".", precision: 2) %>
        </p>
      </div>

      <%# Atrasadas %>
      <div class="bg-(--color-surface) rounded-xl border <%= @overdue_count > 0 ? 'border-(--color-danger)/30' : 'border-(--color-border)' %> p-5">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-medium text-(--color-text-muted) uppercase tracking-wide">Atrasadas</span>
          <div class="w-8 h-8 rounded-lg bg-(--color-danger-light) flex items-center justify-center">
            <i class="ph ph-clock-countdown text-(--color-danger)"></i>
          </div>
        </div>
        <p class="text-2xl font-bold <%= @overdue_count > 0 ? 'text-(--color-danger)' : 'text-(--color-text)' %>">
          <%= number_to_currency(@overdue_amount, unit: "R$\u00a0", separator: ",", delimiter: ".", precision: 2) %>
        </p>
        <p class="text-xs mt-1.5 text-(--color-text-muted)">
          <%= @overdue_count %> parcela<%= @overdue_count == 1 ? "" : "s" %> em atraso
        </p>
      </div>

      <%# Clientes %>
      <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-5">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-medium text-(--color-text-muted) uppercase tracking-wide">Clientes</span>
          <div class="w-8 h-8 rounded-lg bg-(--color-brand-light) flex items-center justify-center">
            <i class="ph ph-users-three text-(--color-brand)"></i>
          </div>
        </div>
        <p class="text-2xl font-bold text-(--color-text)"><%= @clients_count %></p>
        <p class="text-xs mt-1.5 text-(--color-text-muted)">
          <%= @upcoming_count %> com cobrança nos próximos 7 dias
        </p>
      </div>

    </div>

    <%# Chart + WhatsApp side by side %>
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-5 items-start">

      <%# Evolution chart %>
      <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-5"
           data-controller="dashboard-chart"
           data-dashboard-chart-data-value="<%= @chart_data.to_json %>"
           data-dashboard-chart-metric-value="receita">

        <div class="flex items-center justify-between mb-5 gap-3 flex-wrap">
          <div>
            <h3 class="font-semibold text-(--color-text)">Evolução mensal</h3>
            <p class="text-xs text-(--color-text-muted) mt-0.5">Últimos 6 meses</p>
          </div>
          <div class="flex items-center gap-1 bg-(--color-surface-raised) rounded-lg p-1">
            <button type="button" data-metric="receita"
                    data-dashboard-chart-target="btn"
                    data-action="click->dashboard-chart#setMetric"
                    class="px-3 py-1 text-xs rounded-md bg-(--color-brand) text-white font-semibold transition-colors">
              Receita
            </button>
            <button type="button" data-metric="clientes"
                    data-dashboard-chart-target="btn"
                    data-action="click->dashboard-chart#setMetric"
                    class="px-3 py-1 text-xs rounded-md text-(--color-text-muted) transition-colors">
              Clientes
            </button>
            <button type="button" data-metric="inadimplencia"
                    data-dashboard-chart-target="btn"
                    data-action="click->dashboard-chart#setMetric"
                    class="px-3 py-1 text-xs rounded-md text-(--color-text-muted) transition-colors">
              Inadimplência
            </button>
          </div>
        </div>

        <div class="h-52">
          <canvas data-dashboard-chart-target="canvas"></canvas>
        </div>
      </div>

      <%# WhatsApp status card %>
      <div>
        <% if @chip && @chip.waha_chat_id.blank? %>
          <%# Never connected — chip created but WhatsApp never paired %>
          <%= link_to chip_path(@chip),
                class: "block bg-(--color-surface) rounded-xl border-2 border-(--color-warning) p-5 hover:shadow-sm transition-all" do %>
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-semibold text-(--color-warning) text-sm">WhatsApp</h3>
              <i class="ph ph-caret-right text-(--color-text-subtle)"></i>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-14 h-14 rounded-full bg-(--color-warning-light) flex items-center justify-center flex-shrink-0">
                <i class="ph ph-warning text-(--color-warning) text-2xl"></i>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-(--color-text)">Não conectado ainda</p>
                <p class="text-xs text-(--color-text-muted) mt-0.5 leading-snug">Conecte seu WhatsApp para começar a enviar cobranças automáticas.</p>
              </div>
            </div>
            <div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-(--color-warning) text-(--color-text-inverse) text-xs font-semibold">
              <i class="ph ph-whatsapp-logo"></i>
              Conectar agora
            </div>
          <% end %>
        <% elsif @chip %>
          <%= link_to chip_path(@chip),
                class: "block bg-(--color-surface) rounded-xl border border-(--color-border) p-5 hover:border-(--color-brand-light) hover:shadow-sm transition-all" do %>
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-semibold text-(--color-text) text-sm">WhatsApp</h3>
              <i class="ph ph-caret-right text-(--color-text-subtle)"></i>
            </div>

            <div class="flex items-center gap-3">
              <% if chip_working && current_user.company&.profile_picture&.attached? %>
                <%= image_tag current_user.company.profile_picture,
                      class: "w-14 h-14 rounded-full object-cover ring-2 ring-(--color-success-light) flex-shrink-0" %>
              <% else %>
                <div class="w-14 h-14 rounded-full bg-(<%= chip_status_bg %>) flex items-center justify-center flex-shrink-0">
                  <i class="ph ph-whatsapp-logo text-(<%= chip_status_fg %>) text-2xl"></i>
                </div>
              <% end %>

              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-(--color-text) truncate">
                  <%= @chip.formatted_number || "Não conectado" %>
                </p>
                <span class="inline-flex items-center gap-1.5 mt-1 px-2 py-0.5 rounded-full text-xs font-medium bg-(<%= chip_status_bg %>) text-(<%= chip_status_fg %>)">
                  <i class="ph <%= chip_status_icon %>"></i>
                  <%= chip_status_label %>
                </span>
              </div>
            </div>

            <% unless chip_working %>
              <p class="text-xs text-(--color-danger) mt-4 leading-relaxed font-medium flex items-start gap-1.5">
                <i class="ph ph-warning-circle mt-0.5"></i>
                <span>Toque para <%= @chip.waha_status == "scan_qr_code" ? "ler o QR code" : "conectar agora" %> e voltar a enviar cobranças.</span>
              </p>
            <% end %>
          <% end %>
        <% else %>
          <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-6 text-center">
            <i class="ph ph-device-mobile text-(--color-text-subtle) text-4xl block mb-2"></i>
            <p class="text-sm text-(--color-text-muted)">Nenhum número WhatsApp configurado.</p>
            <%= link_to settings_cobranca_path, class: "mt-3 inline-flex items-center gap-2 text-sm text-(--color-brand) hover:underline" do %>
              <i class="ph ph-gear"></i>
              Configurar em Configurações → Cobrança
            <% end %>
          </div>
        <% end %>
      </div>

    </div>

    <%# Pendências recentes %>
    <% if @recent_pending.any? %>
    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) overflow-hidden">
      <div class="px-5 py-4 border-b border-(--color-border) flex items-center justify-between">
        <div>
          <h3 class="font-semibold text-(--color-text)">Pendências recentes</h3>
          <p class="text-xs text-(--color-text-muted) mt-0.5">Clique em <i class="ph ph-check-circle align-middle text-(--color-success)"></i> para dar baixa diretamente</p>
        </div>
        <%= link_to clients_path, class: "text-sm text-(--color-brand) hover:text-(--color-brand-dark) font-medium" do %>
          Ver todos →
        <% end %>
      </div>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-(--color-border) bg-(--color-surface-muted)">
            <th class="px-5 py-3 text-left text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Cliente</th>
            <th class="px-5 py-3 text-left text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Valor</th>
            <th class="px-5 py-3 text-left text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Vencimento</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-(--color-border)">
          <% @recent_pending.each do |inst| %>
            <%
              client    = inst.campaign_client.client
              days_late = (Date.today - inst.due_date).to_i
              overdue   = days_late > 0
              due_text  = if days_late == 0
                            "Vence hoje"
                          elsif days_late == 1
                            "1 dia atrasada"
                          elsif overdue
                            "#{days_late} dias atrasada"
                          else
                            I18n.l(inst.due_date, format: "%d/%m") rescue inst.due_date.strftime("%d/%m")
                          end
            %>
            <tr class="hover:bg-(--color-surface-muted) transition-colors">
              <td class="px-5 py-3.5">
                <p class="font-medium text-(--color-text)"><%= client.name %></p>
              </td>
              <td class="px-5 py-3.5 font-semibold text-(--color-text)">
                <%= number_to_currency(inst.amount, unit: "R$\u00a0", separator: ",", delimiter: ".", precision: 2) %>
              </td>
              <td class="px-5 py-3.5">
                <span class="text-sm font-medium <%= overdue ? 'text-(--color-danger)' : 'text-(--color-warning)' %>">
                  <%= due_text %>
                </span>
              </td>
              <td class="px-5 py-3.5 text-right">
                <%= button_to installment_path(inst),
                      method: :patch,
                      params: { installment: { status: "paid" } },
                      form: { data: { turbo_confirm: "Confirmar baixa de #{number_to_currency(inst.amount, unit: 'R$ ', separator: ',', delimiter: '.', precision: 2)} de #{client.name}?" } },
                      class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium bg-(--color-success-light) text-(--color-success) hover:bg-(--color-success) hover:text-(--color-text-inverse) rounded-lg transition-colors disabled:opacity-60",
                      data: { controller: "loadable", "loadable-spinner-only-value": "true" },
                      aria: { label: "Dar baixa" } do %>
                  <i class="ph ph-check"></i>
                  Dar baixa
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% end %>

  </div>

<% end %>

<%# PWA install — discreet, only shows when prompt is available %>
<div data-controller="pwa-install" hidden
     class="flex items-center justify-center pt-2 pb-4">
  <button type="button"
          data-action="click->pwa-install#install"
          class="inline-flex md:hidden items-center gap-2 px-4 py-2 rounded-full border border-(--color-border) bg-(--color-surface) text-xs font-medium text-(--color-text-muted) hover:text-(--color-brand) hover:border-(--color-brand-light) hover:bg-(--color-brand-subtle) transition-colors">
    <i class="ph ph-device-mobile text-sm"></i>
    Instalar app
  </button>
</div>

</div>
