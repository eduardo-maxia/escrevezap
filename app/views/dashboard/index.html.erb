<% content_for :page_title, "Dashboard" %>

<div class="p-6 space-y-6">

<% if @feature_campanhas %>

  <%# ── FULL MODE ─────────────────────────────────────────────────── %>

  <%# Critical: chips down with active campaigns %>
  <% if @critical_chips&.any? %>
    <div class="flex items-start gap-4 bg-(--color-danger-light) border-2 border-(--color-danger) rounded-xl p-5">
      <i class="ph ph-warning-octagon text-(--color-danger) text-3xl flex-shrink-0 mt-0.5"></i>
      <div class="flex-1 min-w-0">
        <p class="font-bold text-(--color-danger) text-lg leading-tight">Atenção: cobranças não estão sendo enviadas</p>
        <p class="text-sm text-(--color-text) mt-1 mb-3">
          Os chips abaixo estão <strong>desconectados</strong> e possuem campanhas ativas.
          Nenhuma mensagem de cobrança será disparada até reconectar o WhatsApp.
        </p>
        <ul class="space-y-1.5 mb-4">
          <% @critical_chips.each do |chip| %>
            <% n = chip.campaigns.where(status: "active").count %>
            <li class="flex items-center gap-2 text-sm">
              <i class="ph ph-sim-card text-(--color-danger) flex-shrink-0"></i>
              <span class="font-semibold text-(--color-danger)"><%= chip.name %></span>
              <span class="text-(--color-text-muted)">— <%= n %> campanha<%= n == 1 ? "" : "s" %> ativa<%= n == 1 ? "" : "s" %></span>
            </li>
          <% end %>
        </ul>
        <%= link_to chips_path,
              class: "inline-flex items-center gap-2 px-4 py-2 bg-(--color-danger) text-(--color-text-inverse) text-sm font-semibold rounded-lg hover:opacity-90 transition-opacity" do %>
          <i class="ph ph-wifi-slash text-base"></i>
          Reconectar chips agora
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Welcome %>
  <div>
    <h2 class="text-2xl font-bold text-(--color-text)">
      Olá, <%= current_user.name || current_user.email.split("@").first.capitalize %>!
    </h2>
    <p class="text-(--color-text-muted) text-sm mt-1">
      Aqui está um resumo da sua operação de cobranças.
    </p>
  </div>

  <%# KPI Cards %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-5 flex items-start justify-between">
      <div>
        <p class="text-sm font-medium text-(--color-text-muted)">Campanhas</p>
        <p class="text-3xl font-bold text-(--color-text) mt-1"><%= @campaigns_count %></p>
        <p class="text-sm text-(--color-text-subtle) mt-1">
          <span class="text-(--color-success) font-medium"><%= @active_campaigns %></span> ativas
        </p>
      </div>
      <div class="w-10 h-10 rounded-lg bg-(--color-brand-light) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-megaphone text-(--color-brand) text-xl"></i>
      </div>
    </div>

    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-5 flex items-start justify-between">
      <div>
        <p class="text-sm font-medium text-(--color-text-muted)">Clientes</p>
        <p class="text-3xl font-bold text-(--color-text) mt-1"><%= @clients_count %></p>
        <p class="text-sm text-(--color-text-subtle) mt-1">Cadastrados</p>
      </div>
      <div class="w-10 h-10 rounded-lg bg-(--color-info-light) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-users-three text-(--color-info) text-xl"></i>
      </div>
    </div>

    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-5 flex items-start justify-between">
      <div>
        <p class="text-sm font-medium text-(--color-text-muted)">Parcelas Pendentes</p>
        <p class="text-3xl font-bold text-(--color-text) mt-1"><%= @pending_count %></p>
        <p class="text-sm text-(--color-text-subtle) mt-1">
          <%= number_to_currency(@pending_amount, unit: "R$\u00a0", separator: ",", delimiter: ".", precision: 2) %>
        </p>
      </div>
      <div class="w-10 h-10 rounded-lg bg-(--color-warning-light) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-receipt text-(--color-warning) text-xl"></i>
      </div>
    </div>

    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-5 flex items-start justify-between">
      <div>
        <p class="text-sm font-medium text-(--color-text-muted)">Chips WhatsApp</p>
        <p class="text-3xl font-bold text-(--color-text) mt-1"><%= @chips_count %></p>
        <p class="text-sm text-(--color-text-subtle) mt-1">Números cadastrados</p>
      </div>
      <div class="w-10 h-10 rounded-lg bg-(--color-brand-light) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-device-mobile text-(--color-brand) text-xl"></i>
      </div>
    </div>
  </div>

  <%# No company warning %>
  <% unless current_user.company %>
    <div class="flex items-start gap-4 bg-(--color-warning-light) border border-(--color-warning) rounded-xl p-5">
      <i class="ph ph-warning text-(--color-warning) text-2xl flex-shrink-0 mt-0.5"></i>
      <div>
        <p class="font-semibold text-(--color-text)">Sua conta não está vinculada a uma empresa</p>
        <p class="text-sm text-(--color-text-muted) mt-1">
          Entre em contato com o administrador para associar sua conta a uma empresa.
        </p>
      </div>
    </div>
  <% end %>

  <%# Bottom grid: Campaigns + Chips %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">

    <%# Campanhas recentes %>
    <div class="lg:col-span-2 bg-(--color-surface) rounded-xl border border-(--color-border)">
      <div class="px-5 py-4 border-b border-(--color-border) flex items-center justify-between">
        <h3 class="font-semibold text-(--color-text)">Campanhas Recentes</h3>
        <%= link_to "Ver todas →", campaigns_path, class: "text-sm text-(--color-brand) hover:text-(--color-brand-dark) font-medium" %>
      </div>

      <% if @recent_campaigns.empty? %>
        <div class="py-14 text-center">
          <div class="w-12 h-12 rounded-full bg-(--color-surface-raised) flex items-center justify-center mx-auto mb-3">
            <i class="ph ph-megaphone text-(--color-text-subtle) text-2xl"></i>
          </div>
          <p class="text-(--color-text-muted) text-sm font-medium">Nenhuma campanha ainda</p>
          <p class="text-(--color-text-subtle) text-xs mt-1">Crie sua primeira campanha para começar</p>
        </div>
      <% else %>
        <div class="divide-y divide-(--color-border)">
          <% @recent_campaigns.each do |campaign| %>
            <%
              badge_classes = case campaign.status
              when "active"   then "bg-(--color-success-light) text-(--color-success)"
              when "paused"   then "bg-(--color-warning-light) text-(--color-warning)"
              when "finished" then "bg-(--color-surface-raised) text-(--color-text-muted)"
              else "bg-(--color-info-light) text-(--color-info)"
              end
              status_label = { "active" => "Ativa", "paused" => "Pausada", "finished" => "Finalizada", "draft" => "Rascunho" }[campaign.status] || campaign.status&.capitalize
            %>
            <div class="px-5 py-4 flex items-center justify-between gap-4">
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-8 h-8 rounded-lg bg-(--color-brand-subtle) flex items-center justify-center flex-shrink-0">
                  <i class="ph ph-megaphone text-(--color-brand) text-sm"></i>
                </div>
                <div class="min-w-0">
                  <p class="text-sm font-medium text-(--color-text) truncate"><%= campaign.name %></p>
                  <p class="text-xs text-(--color-text-muted) truncate">
                    <i class="ph ph-device-mobile"></i>
                    <%= campaign.chip&.name || "Sem chip associado" %>
                  </p>
                </div>
              </div>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium flex-shrink-0 <%= badge_classes %>">
                <%= status_label %>
              </span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Status dos Chips %>
    <div class="bg-(--color-surface) rounded-xl border border-(--color-border)">
      <div class="px-5 py-4 border-b border-(--color-border)">
        <h3 class="font-semibold text-(--color-text)">Status dos Chips</h3>
      </div>

      <% if @chips.empty? %>
        <div class="py-14 text-center">
          <div class="w-12 h-12 rounded-full bg-(--color-surface-raised) flex items-center justify-center mx-auto mb-3">
            <i class="ph ph-device-mobile text-(--color-text-subtle) text-2xl"></i>
          </div>
          <p class="text-(--color-text-muted) text-sm font-medium">Nenhum chip cadastrado</p>
          <p class="text-(--color-text-subtle) text-xs mt-1">Adicione um número WhatsApp</p>
        </div>
      <% else %>
        <div class="p-3 space-y-2">
          <% @chips.each do |chip| %>
            <% connected = chip.waha_status == "working" %>
            <div class="flex items-center gap-3 p-3 rounded-lg bg-(--color-surface-muted)">
              <div class="relative flex-shrink-0">
                <div class="w-8 h-8 rounded-full bg-(--color-sidebar-bg) flex items-center justify-center">
                  <i class="ph ph-device-mobile text-(--color-text-inverse) text-sm"></i>
                </div>
                <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full border-2 border-(--color-surface) <%= connected ? 'bg-(--color-success)' : 'bg-(--color-text-subtle)' %>"></span>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-(--color-text) truncate">
                  <%= chip.name + " | " + chip.formatted_number %>
                </p>
                <p class="text-xs <%= connected ? 'text-(--color-success)' : 'text-(--color-text-subtle)' %> truncate">
                  <%= connected ? "Conectado" : (chip.waha_status.presence || "Desconectado") %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>

<% else %>

  <%# ── SIMPLE MODE (feature_campanhas = false) ───────────────────── %>

  <%# Welcome %>
  <div>
    <h2 class="text-2xl font-bold text-(--color-text)">
      Olá, <%= current_user.name || current_user.email.split("@").first.capitalize %>!
    </h2>
    <p class="text-(--color-text-muted) text-sm mt-1">
      Aqui está o resumo das suas cobranças.
    </p>
  </div>

  <%# KPI Cards %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

    <%# Clientes %>
    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-5 flex items-start justify-between">
      <div>
        <p class="text-sm font-medium text-(--color-text-muted)">Clientes</p>
        <p class="text-3xl font-bold text-(--color-text) mt-1"><%= @clients_count %></p>
        <p class="text-sm text-(--color-text-subtle) mt-1">Cadastrados</p>
      </div>
      <div class="w-10 h-10 rounded-lg bg-(--color-info-light) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-users-three text-(--color-info) text-xl"></i>
      </div>
    </div>

    <%# Faturamento do mês %>
    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-5 flex items-start justify-between">
      <div>
        <p class="text-sm font-medium text-(--color-text-muted)">Faturamento do mês</p>
        <p class="text-2xl font-bold text-(--color-success) mt-1">
          <%= number_to_currency(@billing_month, unit: "R$\u00a0", separator: ",", delimiter: ".", precision: 2) %>
        </p>
        <p class="text-sm text-(--color-text-subtle) mt-1">Recebido no mês atual</p>
      </div>
      <div class="w-10 h-10 rounded-lg bg-(--color-success-light) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-trend-up text-(--color-success) text-xl"></i>
      </div>
    </div>

    <%# Pendente no mês %>
    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-5 flex items-start justify-between">
      <div>
        <p class="text-sm font-medium text-(--color-text-muted)">Pendente no mês</p>
        <p class="text-2xl font-bold text-(--color-warning) mt-1">
          <%= number_to_currency(@pending_month_amount, unit: "R$\u00a0", separator: ",", delimiter: ".", precision: 2) %>
        </p>
        <p class="text-sm text-(--color-text-subtle) mt-1">
          Total geral: <%= number_to_currency(@pending_amount, unit: "R$\u00a0", separator: ",", delimiter: ".", precision: 2) %>
        </p>
      </div>
      <div class="w-10 h-10 rounded-lg bg-(--color-warning-light) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-receipt text-(--color-warning) text-xl"></i>
      </div>
    </div>

  </div>

  <%# Chart + WhatsApp side by side %>
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-5 items-start">

    <%# Evolution chart %>
    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-5"
         data-controller="dashboard-chart"
         data-dashboard-chart-data-value="<%= @chart_data.to_json %>"
         data-dashboard-chart-metric-value="receita">

      <div class="flex items-center justify-between mb-5 gap-3 flex-wrap">
        <h3 class="font-semibold text-(--color-text)">Evolução mensal</h3>
        <div class="flex items-center gap-1 bg-(--color-surface-raised) rounded-lg p-1">
          <button type="button" data-metric="receita"
                  data-dashboard-chart-target="btn"
                  data-action="click->dashboard-chart#setMetric"
                  class="px-3 py-1 text-xs rounded-md bg-(--color-brand) text-white font-semibold transition-colors">
            Receita
          </button>
          <button type="button" data-metric="clientes"
                  data-dashboard-chart-target="btn"
                  data-action="click->dashboard-chart#setMetric"
                  class="px-3 py-1 text-xs rounded-md text-(--color-text-muted) transition-colors">
            Clientes
          </button>
          <button type="button" data-metric="inadimplencia"
                  data-dashboard-chart-target="btn"
                  data-action="click->dashboard-chart#setMetric"
                  class="px-3 py-1 text-xs rounded-md text-(--color-text-muted) transition-colors">
            Inadimplência
          </button>
        </div>
      </div>

      <div class="h-52">
        <canvas data-dashboard-chart-target="canvas"></canvas>
      </div>

    </div>

    <%# WhatsApp connection panel %>
    <div>
      <% if @chip %>
        <%= render "shared/chip_connection_panel",
              chip: @chip,
              redirect_url: authenticated_root_path,
              after_disconnect: disconnect_chip_path(@chip),
              show_swap_button: true,
              source: "dashboard" %>
      <% else %>
        <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-6 text-center">
          <i class="ph ph-device-mobile text-(--color-text-subtle) text-4xl block mb-2"></i>
          <p class="text-sm text-(--color-text-muted)">Nenhum número WhatsApp configurado.</p>
          <%= link_to settings_cobranca_path, class: "mt-3 inline-flex items-center gap-2 text-sm text-(--color-brand) hover:underline" do %>
            <i class="ph ph-gear"></i>
            Configurar em Configurações → Cobrança
          <% end %>
        </div>
      <% end %>
    </div>

  </div>

<% end %>
</div>
