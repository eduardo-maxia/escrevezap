<% content_for :title, "Início" %>

<div class="py-6 space-y-6">

  <%# ── Greeting ──────────────────────────────────────────────────────── %>
  <div class="flex items-center justify-between">
    <div>
      <p class="text-sm text-(--color-text-muted)">Olá,</p>
      <h1 class="text-xl font-bold text-(--color-text)"><%= current_user.display_name %> 👋</h1>
    </div>
    <%# Connection status pill %>
    <% if @waha_session&.working? %>
      <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-50 border border-green-200 text-xs font-semibold text-green-700">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
        Conectado
      </span>
    <% else %>
      <%= link_to app_waha_session_path, class: "flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-(--color-warning-light) border border-yellow-200 text-xs font-semibold text-(--color-warning)" do %>
        <span class="w-1.5 h-1.5 rounded-full bg-(--color-warning)"></span>
        Desconectado
      <% end %>
    <% end %>
  </div>

  <% show_usage = !(@waha_session&.working? && @total_count == 0) %>

  <% if show_usage %>
    <%# ── Stats ─────────────────────────────────────────────────────────── %>
    <div class="grid grid-cols-2 gap-3">
      <div class="col-span-2 bg-(--color-surface) border border-(--color-border) rounded-2xl px-4 py-4">
        <p class="text-xs text-(--color-text-muted) mb-1">Transcrições este mês</p>
        <p class="text-3xl font-bold text-(--color-brand)"><%= @month_count %></p>
        <p class="text-xs text-(--color-text-subtle) mt-1">de <%= current_user.transcription_limit %> no plano <%= current_user.plan %></p>
      </div>
    </div>
  <% end %>

  <% unless @waha_session&.working? %>
    <div class="rounded-2xl border border-(--color-warning) bg-(--color-warning-light) px-4 py-4 flex items-start gap-3">
      <div class="w-9 h-9 rounded-full bg-white/70 flex items-center justify-center flex-shrink-0">
        <i class="ph ph-whatsapp-logo text-(--color-warning) text-lg"></i>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold text-(--color-text)">Conecte seu WhatsApp para ativar as transcrições</p>
        <p class="text-xs text-(--color-text-muted) mt-1">Você pode conectar agora e começar a receber respostas automáticas nos áudios.</p>
        <%= link_to app_waha_session_path,
              class: "mt-3 inline-flex items-center gap-1.5 bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold px-4 py-2 rounded-xl text-xs transition-colors" do %>
          Conectar WhatsApp agora
          <i class="ph ph-arrow-right text-sm"></i>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @waha_session&.working? && @total_count == 0 %>
    <div class="rounded-2xl border border-(--color-brand-light) bg-(--color-brand-subtle) px-5 py-6">
      <div class="flex flex-col items-center text-center">
        <div class="w-16 h-16 rounded-full bg-white flex items-center justify-center mb-4 shadow-sm">
          <i class="ph-fill ph-eyes text-3xl text-(--color-brand)"></i>
        </div>
        <h2 class="text-lg font-bold text-(--color-text) mb-2">Tudo pronto! Seu WhatsApp está conectado.</h2>
        <p class="text-sm text-(--color-text-muted) mb-6">
          Para transcrever seu primeiro áudio, basta <strong>reagir com um 👀 (olhinho)</strong> a qualquer mensagem de voz no seu WhatsApp. O EscreveZap vai ouvir o áudio e responder com o texto na hora!
        </p>
        <div class="bg-white/60 rounded-xl px-4 py-3 border border-white flex items-center justify-center gap-3 w-full max-w-sm">
          <i class="ph-fill ph-speaker-high text-(--color-text-subtle) text-xl"></i>
          <span class="text-sm font-semibold text-(--color-text)">Mensagem de voz</span>
          <div class="bg-white shadow-sm border border-(--color-border) rounded-full px-2 py-0.5 ml-2 text-sm">👀</div>
        </div>
      </div>
    </div>
  <% end %>

  <% if show_usage %>
    <%# ── Usage bar ──────────────────────────────────────────────────────── %>
    <% limit = current_user.transcription_limit %>
    <% pct   = [((@month_count.to_f / limit) * 100).round, 100].min %>
    <div>
      <div class="flex justify-between text-xs text-(--color-text-muted) mb-1.5">
        <span>Uso do plano</span>
        <span><%= @month_count %>/<%= limit %></span>
      </div>
      <div class="w-full h-2 bg-(--color-surface-raised) rounded-full overflow-hidden">
        <div class="h-full rounded-full transition-all <%= pct >= 90 ? 'bg-(--color-danger)' : 'bg-(--color-brand)' %>"
             style="width: <%= pct %>%"></div>
      </div>
      <% if pct >= 90 %>
        <p class="text-xs text-(--color-danger) mt-1">Quase no limite — considere fazer upgrade.</p>
      <% end %>
    </div>
  <% end %>

  <%# ── Top contacts this month ───────────────────────────────────────── %>
  <% if @top_contacts.any? %>
    <div>
      <h2 class="text-sm font-bold text-(--color-text) mb-3">Quem mais te manda áudios?</h2>
      <div class="space-y-2">
        <% @top_contacts.each_with_index do |contact, i| %>
          <div class="flex items-center gap-3 bg-(--color-surface) border border-(--color-border) rounded-2xl px-4 py-3">
            <% if contact.avatar_url.present? %>
              <img src="<%= contact.avatar_url %>" alt="" class="w-9 h-9 rounded-full object-cover flex-shrink-0">
            <% else %>
              <div class="w-9 h-9 rounded-full bg-(--color-brand-subtle) flex items-center justify-center flex-shrink-0">
                <i class="ph ph-user text-sm text-(--color-brand)"></i>
              </div>
            <% end %>
            <p class="flex-1 text-sm font-semibold text-(--color-text) truncate"><%= contact.display_name.presence || contact.formatted_phone %></p>
            <span class="text-xs font-semibold text-(--color-brand) flex-shrink-0">
              <%= contact.transcription_count %> <span class="font-normal text-(--color-text-subtle)">áudios</span>
            </span>
            <% if i == 0 %>
              <i class="ph-fill ph-trophy text-base text-(--color-accent) flex-shrink-0"></i>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>


</div>
