<% content_for :title, "Início" %>

<div class="py-6 space-y-6">

  <%# ── Greeting ──────────────────────────────────────────────────────── %>
  <div class="flex items-center justify-between">
    <div>
      <p class="text-sm text-(--color-text-muted)">Olá,</p>
      <h1 class="text-xl font-bold text-(--color-text)"><%= current_user.display_name %> 👋</h1>
    </div>
    <%# Connection status pill %>
    <% if @waha_session&.working? %>
      <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-50 border border-green-200 text-xs font-semibold text-green-700">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
        Conectado
      </span>
    <% else %>
      <%= link_to app_waha_session_path, class: "flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-(--color-warning-light) border border-yellow-200 text-xs font-semibold text-(--color-warning)" do %>
        <span class="w-1.5 h-1.5 rounded-full bg-(--color-warning)"></span>
        Desconectado
      <% end %>
    <% end %>
  </div>

  <%# ── Stats ─────────────────────────────────────────────────────────── %>
  <div class="grid grid-cols-2 gap-3">
    <div class="bg-(--color-surface) border border-(--color-border) rounded-2xl px-4 py-4">
      <p class="text-xs text-(--color-text-muted) mb-1">Transcrições este mês</p>
      <p class="text-3xl font-bold text-(--color-brand)"><%= @month_count %></p>
      <p class="text-xs text-(--color-text-subtle) mt-1">de <%= current_user.transcription_limit %> no plano <%= current_user.plan %></p>
    </div>
    <div class="bg-(--color-surface) border border-(--color-border) rounded-2xl px-4 py-4">
      <p class="text-xs text-(--color-text-muted) mb-1">Contatos monitorados</p>
      <p class="text-3xl font-bold text-(--color-brand)"><%= @contacts.count %></p>
      <p class="text-xs text-(--color-text-subtle) mt-1"><%= @contacts.count { |c| c.enabled? } %> ativos</p>
    </div>
  </div>

  <%# ── Usage bar ──────────────────────────────────────────────────────── %>
  <% limit = current_user.transcription_limit %>
  <% pct   = [((@month_count.to_f / limit) * 100).round, 100].min %>
  <div>
    <div class="flex justify-between text-xs text-(--color-text-muted) mb-1.5">
      <span>Uso do plano</span>
      <span><%= @month_count %>/<%= limit %></span>
    </div>
    <div class="w-full h-2 bg-(--color-surface-raised) rounded-full overflow-hidden">
      <div class="h-full rounded-full transition-all <%= pct >= 90 ? 'bg-(--color-danger)' : 'bg-(--color-brand)' %>"
           style="width: <%= pct %>%"></div>
    </div>
    <% if pct >= 90 %>
      <p class="text-xs text-(--color-danger) mt-1">Quase no limite — considere fazer upgrade.</p>
    <% end %>
  </div>

  <%# ── Quick action: add contact ─────────────────────────────────────── %>
  <% if @contacts.empty? %>
    <div class="rounded-2xl border-2 border-dashed border-(--color-border) px-5 py-6 text-center">
      <i class="ph ph-address-book text-3xl text-(--color-text-subtle) mb-2 block"></i>
      <p class="text-sm font-semibold text-(--color-text) mb-1">Adicione seu primeiro contato</p>
      <p class="text-xs text-(--color-text-muted) mb-4">Escolha quem você quer monitorar para receber as transcrições.</p>
      <%= link_to "Adicionar contato", new_monitored_contact_path,
            class: "inline-flex items-center gap-1.5 bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold px-5 py-2.5 rounded-xl text-sm transition-colors" %>
    </div>
  <% end %>

  <%# ── Top contacts this month ───────────────────────────────────────── %>
  <% if @top_contacts.any? %>
    <div>
      <h2 class="text-sm font-bold text-(--color-text) mb-3">Quem mais te manda áudios?</h2>
      <div class="space-y-2">
        <% @top_contacts.each_with_index do |contact, i| %>
          <%= link_to monitored_contact_path(contact), class: "flex items-center gap-3 bg-(--color-surface) border border-(--color-border) rounded-2xl px-4 py-3 hover:border-(--color-brand-light) transition-colors" do %>
            <% if contact.avatar_url.present? %>
              <img src="<%= contact.avatar_url %>" alt="" class="w-9 h-9 rounded-full object-cover flex-shrink-0">
            <% else %>
              <div class="w-9 h-9 rounded-full bg-(--color-brand-subtle) flex items-center justify-center flex-shrink-0">
                <i class="ph ph-user text-sm text-(--color-brand)"></i>
              </div>
            <% end %>
            <p class="flex-1 text-sm font-semibold text-(--color-text) truncate"><%= contact.display_name.presence || contact.formatted_phone %></p>
            <span class="text-xs font-semibold text-(--color-brand) flex-shrink-0">
              <%= contact.transcription_count %> <span class="font-normal text-(--color-text-subtle)">áudios</span>
            </span>
            <% if i == 0 %>
              <i class="ph-fill ph-trophy text-base text-(--color-accent) flex-shrink-0"></i>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ── Recent transcriptions ─────────────────────────────────────────── %>
  <% if @recent.any? %>
    <div>
      <div class="flex items-center justify-between mb-2">
        <h2 class="text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Recentes</h2>
        <%= link_to "Ver todas", transcriptions_path, class: "text-xs text-(--color-brand) font-medium hover:underline" %>
      </div>
      <div class="flex flex-col gap-1">
        <% @recent.each do |tr| %>
          <%= link_to transcription_path(tr), class: "flex items-center gap-2.5 px-3 py-2 rounded-xl hover:bg-(--color-surface-raised) transition-colors" do %>
            <% contact = tr.monitored_contact %>
            <% if contact.avatar_url.present? %>
              <img src="<%= contact.avatar_url %>" alt="" class="w-7 h-7 rounded-full object-cover flex-shrink-0">
            <% else %>
              <div class="w-7 h-7 rounded-full bg-(--color-brand-subtle) flex items-center justify-center flex-shrink-0">
                <i class="ph ph-user text-xs text-(--color-brand)"></i>
              </div>
            <% end %>
            <p class="flex-1 text-xs font-medium text-(--color-text) truncate"><%= contact.display_name.presence || contact.formatted_phone %></p>
            <% if tr.direction == "inbound" %>
              <i class="ph ph-arrow-down-left text-xs text-green-500 flex-shrink-0" title="Recebido"></i>
            <% else %>
              <i class="ph ph-arrow-up-right text-xs text-(--color-text-subtle) flex-shrink-0" title="Enviado"></i>
            <% end %>
            <span class="text-[10px] text-(--color-text-subtle) flex-shrink-0"><%= tr.created_at.strftime("%H:%M") %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
