<% content_for :page_title, "Perfil" %>
<%
  lbl     = "block text-xs font-semibold text-(--color-text-subtle) uppercase tracking-wide mb-1 md:text-sm md:font-medium md:normal-case md:tracking-normal md:text-(--color-text) md:mb-1.5"
  inp     = "w-full text-sm text-(--color-text) bg-transparent border-0 p-0 focus:outline-none focus:ring-0 placeholder:text-(--color-text-subtle) md:px-3 md:py-2.5 md:bg-(--color-surface) md:border md:border-(--color-border) md:rounded-lg md:focus:border-(--color-brand) md:focus:ring-1 md:focus:ring-(--color-brand) md:transition-colors"
  inp_err = "w-full text-sm text-(--color-text) bg-transparent border-0 p-0 focus:outline-none focus:ring-0 placeholder:text-(--color-text-subtle) md:px-3 md:py-2.5 md:bg-(--color-surface) md:border md:border-(--color-danger) md:rounded-lg md:focus:border-(--color-danger) md:focus:ring-1 md:focus:ring-(--color-danger) md:transition-colors"
%>

<%# Mobile header %>
<div class="md:hidden flex items-center gap-2 px-4 py-3 border-b border-(--color-border) bg-(--color-surface) sticky top-0 z-10">
  <%= link_to settings_path, class: "p-1.5 -ml-1 rounded-lg text-(--color-text) hover:bg-(--color-surface-muted) transition-colors" do %>
    <i class="ph ph-arrow-left text-lg leading-none"></i>
  <% end %>
  <h1 class="text-base font-semibold text-(--color-text)">Perfil</h1>
</div>

<div class="px-4 pt-5 pb-24 md:p-6 md:pb-6 md:max-w-xl space-y-4 md:space-y-6">

  <%# Desktop header %>
  <div class="hidden md:block">
    <h2 class="text-2xl font-bold text-(--color-text)">Perfil</h2>
    <p class="text-sm text-(--color-text-muted) mt-1">Seu nome e e-mail de acesso.</p>
  </div>

  <% if flash[:notice].present? %>
    <div class="flex items-center gap-3 p-3.5 bg-(--color-success-light) border border-(--color-success) rounded-xl text-sm text-(--color-success)">
      <i class="ph ph-check-circle flex-shrink-0 text-base"></i>
      <span><%= flash[:notice] %></span>
    </div>
  <% end %>

  <%# Top-level alert — only shown outside the OTP state %>
  <% if flash[:alert].present? && !@show_otp %>
    <div class="flex items-center gap-3 p-3.5 bg-(--color-danger-light) border border-(--color-danger) rounded-xl text-sm text-(--color-danger)">
      <i class="ph ph-warning-circle flex-shrink-0 text-base"></i>
      <span><%= flash[:alert] %></span>
    </div>
  <% end %>

  <% if current_user.errors.any? %>
    <div class="flex items-center gap-3 p-3.5 bg-(--color-danger-light) border border-(--color-danger) rounded-xl text-sm text-(--color-danger)">
      <i class="ph ph-warning-circle flex-shrink-0 text-base"></i>
      <span><%= current_user.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <%# ── Profile form ── %>
  <%= form_with model: current_user, url: settings_perfil_path, method: :patch do |f| %>
    <div class="space-y-4">
      <%# Card — divide-y rows on mobile, padded card on desktop %>
      <div class="bg-(--color-surface) rounded-2xl border border-(--color-border) overflow-hidden md:p-6">

        <%# Name row %>
        <div class="px-4 py-3.5 border-b border-(--color-border) md:px-0 md:py-0 md:border-b-0 md:pb-4 <%= 'opacity-50 pointer-events-none select-none' if @show_otp %>">
          <%= f.label :name, "Nome", class: lbl %>
          <%= f.text_field :name,
                class: inp,
                placeholder: "Seu nome completo",
                enterkeyhint: "next",
                disabled: @show_otp %>
        </div>

        <%# Email row %>
        <div class="px-4 py-3.5 md:px-0 md:py-0">
          <% if @show_otp %>
            <div class="flex items-center justify-between gap-2 mb-1">
              <span class="<%= lbl.sub('mb-1 ', '') %>">E-mail</span>
              <span class="inline-flex items-center gap-1 text-[10px] font-semibold px-2 py-0.5 rounded-full bg-(--color-warning-light) text-(--color-warning) uppercase tracking-wide">
                <i class="ph ph-clock text-[10px]"></i>
                Aguardando
              </span>
            </div>
            <div class="flex items-center gap-2">
              <span class="flex-1 text-sm text-(--color-text-muted) truncate"><%= @pending_email %></span>
              <%= button_to settings_cancel_email_change_path, method: :post,
                    class: "shrink-0 p-1 text-(--color-text-subtle) hover:text-(--color-danger) transition-colors cursor-pointer bg-transparent border-0",
                    title: "Cancelar mudança de e-mail" do %>
                <i class="ph ph-x-circle text-xl leading-none"></i>
              <% end %>
            </div>
          <% else %>
            <%= f.label :email, "E-mail", class: lbl %>
            <%= f.email_field :email,
                  class: (flash[:alert].present? && !@show_otp) ? inp_err : inp,
                  required: true,
                  enterkeyhint: "go" %>
          <% end %>
        </div>

      </div>

      <% unless @show_otp %>
        <div class="md:flex md:justify-end">
          <button type="submit"
                  data-controller="loadable"
                  data-loadable-loading-text-value="Salvando..."
                  class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-(--color-brand) text-(--color-text-inverse) text-sm font-semibold rounded-lg hover:bg-(--color-brand-dark) transition-colors cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed">
            Salvar
          </button>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ── OTP verification (shown when email change is pending) ── %>
  <% if @show_otp %>
    <div id="email-otp-section"
         class="bg-(--color-brand-subtle) rounded-2xl border border-(--color-brand-light) overflow-hidden">

      <%# Header row %>
      <div class="flex items-start gap-3 px-4 py-4 border-b border-(--color-brand-light) md:px-6">
        <div class="w-8 h-8 rounded-lg bg-(--color-brand-light) flex items-center justify-center shrink-0 mt-0.5">
          <i class="ph ph-envelope text-(--color-brand) text-base"></i>
        </div>
        <div>
          <p class="text-sm font-semibold text-(--color-text)">Confirme seu novo e-mail</p>
          <p class="text-xs text-(--color-text-muted) mt-0.5">
            Código de <%= User::OTP_LENGTH %> dígitos enviado para
            <strong class="text-(--color-text)"><%= @pending_email %></strong>
          </p>
        </div>
      </div>

      <%# OTP input row %>
      <div class="px-4 py-4 md:px-6">
        <% if flash[:alert].present? %>
          <div class="flex items-center gap-2 p-3 mb-4 bg-(--color-danger-light) border border-(--color-danger) rounded-xl text-sm text-(--color-danger)">
            <i class="ph ph-warning-circle flex-shrink-0"></i>
            <span><%= flash[:alert] %></span>
          </div>
        <% end %>

        <%= form_with url: settings_verify_email_change_path, method: :post, local: true,
              data: { controller: "otp-input", "otp-input-length-value": User::OTP_LENGTH } do %>
          <%= hidden_field_tag :code, "", data: { "otp-input-target": "hidden" } %>

          <div class="flex justify-center gap-2 sm:gap-3 mb-4"
               data-otp-input-target="boxes"
               data-action="input->otp-input#onInput keydown->otp-input#onKeydown paste->otp-input#onPaste focus->otp-input#onFocus">
            <% User::OTP_LENGTH.times do |i| %>
              <input type="text"
                     inputmode="numeric"
                     autocomplete="one-time-code"
                     pattern="[0-9]*"
                     maxlength="1"
                     aria-label="Dígito <%= i + 1 %>"
                     class="otp-box <%= flash[:alert].present? ? 'otp-box-error' : '' %>">
            <% end %>
          </div>

          <button type="submit"
                  data-otp-input-target="submit"
                  data-controller="loadable"
                  data-loadable-loading-text-value="Verificando..."
                  class="w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-(--color-brand) text-(--color-text-inverse) text-sm font-semibold rounded-lg hover:bg-(--color-brand-dark) transition-colors cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
                  disabled>
            Confirmar e-mail
          </button>
        <% end %>
      </div>

      <%# Resend + cancel row %>
      <div class="px-4 py-3 border-t border-(--color-brand-light) flex flex-wrap items-center justify-between gap-3 md:px-6">
        <div class="text-sm text-(--color-text-muted)"
             data-controller="otp-resend"
             data-otp-resend-seconds-value="<%= @resend_in || 0 %>">
          <span data-otp-resend-target="cooldown"
                class="<%= 'hidden' if (@resend_in || 0) <= 0 %>">
            Reenviar em <span data-otp-resend-target="countdown"><%= @resend_in %></span>s
          </span>
          <%= button_to "Reenviar código", settings_resend_email_change_path, method: :post,
                data: {
                  otp_resend_target: "button",
                  controller: "loadable",
                  "loadable-loading-text-value": "Reenviando..."
                },
                class: "text-sm font-medium text-(--color-brand) hover:text-(--color-brand-dark) cursor-pointer bg-transparent border-0 p-0 inline-flex items-center gap-1 disabled:opacity-40 disabled:cursor-not-allowed #{'hidden' if (@resend_in || 0) > 0}",
                disabled: (@resend_in || 0) > 0,
                form: { class: "inline" } %>
        </div>

        <%= button_to "Cancelar", settings_cancel_email_change_path, method: :post,
              class: "text-xs text-(--color-text-subtle) hover:text-(--color-danger) transition-colors cursor-pointer bg-transparent border-0 p-0" %>
      </div>
    </div>

    <script>
      document.getElementById("email-otp-section")?.scrollIntoView({ behavior: "smooth", block: "nearest" });
    </script>
  <% end %>

</div>

