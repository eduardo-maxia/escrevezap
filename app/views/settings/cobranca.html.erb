<% content_for :page_title, "Cobrança" %>
<% input_cls = "w-full px-3 py-2.5 bg-(--color-surface) border border-(--color-border) rounded-lg text-sm text-(--color-text) focus:outline-none focus:border-(--color-brand) focus:ring-1 focus:ring-(--color-brand) transition-colors" %>

<div class="p-6 max-w-xl space-y-6">
  <div>
    <h2 class="text-2xl font-bold text-(--color-text)">Cobrança automática</h2>
    <p class="text-sm text-(--color-text-muted) mt-1">Configure o serviço de cobrança da sua empresa.</p>
  </div>

  <% if notice.present? %>
    <div class="flex items-center gap-3 px-4 py-3 bg-(--color-success-light) border border-(--color-success) rounded-lg text-sm text-(--color-text)">
      <i class="ph ph-check-circle text-(--color-success)"></i>
      <%= notice %>
    </div>
  <% end %>

  <%# ── Configurações do serviço ────────────────────────────────── %>
  <% if @campaign %>
    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-6">
      <h3 class="font-semibold text-(--color-text) mb-4">Serviço de cobrança</h3>

      <% if @campaign.errors.any? %>
        <div class="flex items-start gap-3 px-4 py-3 mb-4 bg-(--color-danger-light) border border-(--color-danger) rounded-lg text-sm text-(--color-danger)">
          <i class="ph ph-warning-circle flex-shrink-0 mt-0.5"></i>
          <span><%= @campaign.errors.full_messages.to_sentence %></span>
        </div>
      <% end %>

      <%= form_with model: @campaign, url: settings_cobranca_path, method: :patch, class: "space-y-4" do |f| %>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :start_time, "Início dos envios", class: "block text-sm font-medium text-(--color-text) mb-1.5" %>
            <%= f.time_field :start_time, class: input_cls %>
          </div>
          <div>
            <%= f.label :end_time, "Fim dos envios", class: "block text-sm font-medium text-(--color-text) mb-1.5" %>
            <%= f.time_field :end_time, class: input_cls %>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-(--color-text) mb-1.5">Mensagem de cobrança</label>
          <textarea name="campaign[template][body]"
                    rows="5"
                    placeholder="Olá {{nome}}, sua mensalidade de {{valor}} vence em {{vencimento}}."
                    class="<%= input_cls %> resize-none"><%= @campaign.template&.dig("body") %></textarea>
          <p class="text-xs text-(--color-text-subtle) mt-1.5">
            Variáveis disponíveis:
            <code class="bg-(--color-surface-raised) px-1 py-0.5 rounded">{{nome}}</code>
            <code class="bg-(--color-surface-raised) px-1 py-0.5 rounded">{{valor}}</code>
            <code class="bg-(--color-surface-raised) px-1 py-0.5 rounded">{{vencimento}}</code>
          </p>
        </div>
        <div class="flex justify-end">
          <%= f.submit "Salvar",
                class: "px-5 py-2.5 bg-(--color-brand) text-(--color-text-inverse) text-sm font-medium rounded-lg hover:bg-(--color-brand-dark) transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-8 text-center">
      <i class="ph ph-invoice text-(--color-text-subtle) text-4xl block mb-2"></i>
      <p class="text-sm text-(--color-text-muted)">Nenhuma cobrança configurada ainda.</p>
      <p class="text-xs text-(--color-text-subtle) mt-1">Complete o processo de configuração inicial.</p>
    </div>
  <% end %>

  <%# ── WhatsApp ────────────────────────────────────────────────── %>
  <div class="bg-(--color-surface) rounded-xl border border-(--color-border) p-6">
    <h3 class="font-semibold text-(--color-text) mb-4">WhatsApp</h3>

    <% if @chip %>
      <%
        connected = @chip.working?
        status_label = connected ? "Conectado" : (@chip.waha_status&.humanize || "Desconectado")
        status_color = connected ? "--color-success" : "--color-warning"
        status_bg    = connected ? "--color-success-light" : "--color-warning-light"
        status_icon  = connected ? "ph-check-circle" : "ph-warning-circle"
      %>
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-(<%= status_bg %>) flex items-center justify-center flex-shrink-0">
            <i class="ph <%= status_icon %> text-(<%= status_color %>) text-xl"></i>
          </div>
          <div>
            <p class="text-sm font-medium text-(--color-text)">
              <%= @chip.formatted_number || @chip.name %>
            </p>
            <p class="text-xs text-(<%= status_color %>)"><%= status_label %></p>
          </div>
        </div>
        <%= link_to chip_path(@chip),
              class: "inline-flex items-center gap-2 px-3 py-2 border border-(--color-border) text-sm font-medium text-(--color-text-muted) rounded-lg hover:text-(--color-text) transition-colors" do %>
          <i class="ph ph-sliders-horizontal text-sm"></i>
          Gerenciar
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-(--color-text-muted)">Nenhum número WhatsApp configurado.</p>
    <% end %>
  </div>

</div>
