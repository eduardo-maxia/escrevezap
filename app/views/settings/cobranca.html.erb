<% content_for :page_title, "Cobrança" %>
<%
  lbl        = "block text-xs font-semibold text-(--color-text-subtle) uppercase tracking-wide mb-1 md:text-sm md:font-medium md:normal-case md:tracking-normal md:text-(--color-text) md:mb-1.5"
  inp_native = "w-full text-sm text-(--color-text) px-3 py-2.5 bg-(--color-surface-muted) border border-(--color-border) rounded-lg focus:outline-none focus:border-(--color-brand) focus:ring-1 focus:ring-(--color-brand) transition-colors"
%>

<%# Mobile header %>
<div class="md:hidden flex items-center gap-2 px-4 py-3 border-b border-(--color-border) bg-(--color-surface) sticky top-0 z-10">
  <%= link_to settings_path, class: "p-1.5 -ml-1 rounded-lg text-(--color-text) hover:bg-(--color-surface-muted) transition-colors" do %>
    <i class="ph ph-arrow-left text-lg leading-none"></i>
  <% end %>
  <h1 class="text-base font-semibold text-(--color-text)">Cobrança automática</h1>
</div>

<div class="px-4 pt-5 pb-24 md:p-6 md:pb-6 md:max-w-2xl space-y-4 md:space-y-6">

  <%# Desktop header %>
  <div class="hidden md:block">
    <h2 class="text-2xl font-bold text-(--color-text)">Cobrança automática</h2>
    <p class="text-sm text-(--color-text-muted) mt-1">Configure o serviço de cobrança da sua empresa.</p>
  </div>

  <% if @campaign&.errors&.any? %>
    <div class="flex items-center gap-3 p-3.5 bg-(--color-danger-light) border border-(--color-danger) rounded-xl text-sm text-(--color-danger)">
      <i class="ph ph-warning-circle flex-shrink-0 text-base"></i>
      <span><%= @campaign.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <%# ── Serviço de cobrança ─────────────────────────────────────── %>
  <div>
    <p class="text-[11px] font-semibold text-(--color-text-subtle) uppercase tracking-wider px-0.5 mb-2">Serviço de cobrança</p>

    <% if @campaign %>
      <%= form_with model: @campaign, url: settings_cobranca_path, method: :patch do |f| %>
        <div class="space-y-4">
          <div class="bg-(--color-surface) rounded-2xl border border-(--color-border) overflow-hidden md:p-6">

            <%# Horários row %>
            <div class="px-4 py-3.5 border-b border-(--color-border) md:px-0 md:py-0 md:border-b-0 md:pb-4">
              <p class="<%= lbl %> mb-2">Horário de envio</p>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <%= f.label :start_time, "Início", class: "block text-xs text-(--color-text-subtle) mb-1" %>
                  <%= f.time_field :start_time, class: inp_native %>
                </div>
                <div>
                  <%= f.label :end_time, "Fim", class: "block text-xs text-(--color-text-subtle) mb-1" %>
                  <%= f.time_field :end_time, class: inp_native %>
                </div>
              </div>
            </div>

            <%# Mensagem row %>
            <div class="px-4 py-3.5 md:px-0 md:py-0">
              <label class="<%= lbl %>">Mensagem de cobrança</label>
              <textarea name="campaign[template][body]"
                        rows="4"
                        enterkeyhint="send"
                        placeholder="Olá {{nome}}, sua mensalidade de {{valor}} vence em {{vencimento}}."
                        class="<%= inp_native %> resize-none"><%= @campaign.template&.dig("body") %></textarea>
              <p class="text-[11px] text-(--color-text-subtle) mt-2 leading-relaxed">
                Variáveis disponíveis:
                <code class="bg-(--color-surface-raised) px-1 py-0.5 rounded">{{nome}}</code>
                <code class="bg-(--color-surface-raised) px-1 py-0.5 rounded">{{valor}}</code>
                <code class="bg-(--color-surface-raised) px-1 py-0.5 rounded">{{vencimento}}</code>
              </p>
            </div>

          </div>

          <div class="md:flex md:justify-end">
            <button type="submit"
                    data-controller="loadable"
                    data-loadable-loading-text-value="Salvando..."
                    class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-(--color-brand) text-(--color-text-inverse) text-sm font-semibold rounded-lg hover:bg-(--color-brand-dark) transition-colors cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed">
              Salvar
            </button>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="bg-(--color-surface) rounded-2xl border border-(--color-border) px-4 py-8 text-center">
        <i class="ph ph-invoice text-(--color-text-subtle) text-3xl block mb-2"></i>
        <p class="text-sm text-(--color-text-muted)">Nenhuma cobrança configurada ainda.</p>
        <p class="text-xs text-(--color-text-subtle) mt-1">Complete o processo de configuração inicial.</p>
      </div>
    <% end %>
  </div>

  <%# ── WhatsApp ────────────────────────────────────────────────── %>
  <div>
    <p class="text-[11px] font-semibold text-(--color-text-subtle) uppercase tracking-wider px-0.5 mb-2">WhatsApp</p>

    <div class="bg-(--color-surface) rounded-2xl border border-(--color-border) overflow-hidden">
      <% if @chip %>
        <%
          connected    = @chip.working?
          status_label = connected ? "Conectado" : (@chip.waha_status&.humanize || "Desconectado")
          status_color = connected ? "--color-success" : "--color-warning"
          status_bg    = connected ? "--color-success-light" : "--color-warning-light"
          status_icon  = connected ? "ph-check-circle" : "ph-warning-circle"
        %>
        <div class="flex items-center justify-between gap-3 px-4 py-3.5">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-9 h-9 rounded-full bg-(<%= status_bg %>) flex items-center justify-center flex-shrink-0">
              <i class="ph <%= status_icon %> text-(<%= status_color %>) text-lg"></i>
            </div>
            <div class="min-w-0">
              <p class="text-sm font-medium text-(--color-text) truncate">
                <%= @chip.formatted_number || @chip.name %>
              </p>
              <p class="text-xs text-(<%= status_color %>)"><%= status_label %></p>
            </div>
          </div>
          <%= link_to chip_path(@chip),
                class: "inline-flex items-center gap-1.5 px-3 py-1.5 border border-(--color-border) text-xs font-medium text-(--color-text-muted) rounded-lg hover:text-(--color-text) transition-colors flex-shrink-0" do %>
            <i class="ph ph-sliders-horizontal text-sm"></i>
            Gerenciar
          <% end %>
        </div>
      <% else %>
        <div class="px-4 py-6 text-center">
          <p class="text-sm text-(--color-text-muted)">Nenhum número WhatsApp configurado.</p>
        </div>
      <% end %>
    </div>
  </div>

</div>
