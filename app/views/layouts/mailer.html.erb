<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cobrança em Dia</title>
  </head>
  <body style="margin:0;padding:0;background-color:#f1f5f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1f5f9;padding:40px 16px;">
      <tr>
        <td align="center">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">

            <%# Header %>
            <tr>
              <td align="center" style="background-color:#0D2E67;border-radius:12px 12px 0 0;padding:28px 40px;">
                <span style="color:#ffffff;font-size:20px;font-weight:700;letter-spacing:-0.3px;">Cobrança em Dia</span>
              </td>
            </tr>

            <%# Body %>
            <tr>
              <td style="background-color:#ffffff;padding:40px 40px 32px;border-radius:0 0 12px 12px;border:1px solid #e2e8f0;border-top:none;">
                <%= yield %>

                <%# Footer %>
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:40px;border-top:1px solid #e2e8f0;padding-top:24px;">
                  <tr>
                    <td style="color:#94a3b8;font-size:12px;line-height:1.7;">
                      <p style="margin:0 0 4px;">Você está recebendo este email pois tem uma conta no Cobrança em Dia.</p>
                      <p style="margin:0;">© <%= Date.current.year %> Cobrança em Dia. Todos os direitos reservados.</p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
