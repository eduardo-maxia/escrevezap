<% exact         = local_assigns.fetch(:exact, false) %>
<% unless_paths  = local_assigns.fetch(:unless_paths, []) %>
<% active = path != "#" && (request.path == path || (!exact && request.path.start_with?("#{path}/"))) %>
<% active &&= unless_paths.none? { |p| request.path == p || request.path.start_with?("#{p}/") } %>
<%= link_to path,
      class: "inline-flex flex-col items-center justify-center px-5 hover:bg-(--color-sidebar-item-hover) group transition-colors #{active ? 'text-(--color-sidebar-text-hover)' : 'text-(--color-sidebar-text) hover:text-(--color-sidebar-text-hover)'}" do %>
  <i class="ph<%= active ? "-fill" : "" %> ph-<%= icon %> text-xl mb-1"></i>
  <span class="text-[11px]"><%= label %></span>
<% end %>
