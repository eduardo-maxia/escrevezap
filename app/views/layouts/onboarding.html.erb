<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Cobrança em Dia · Configuração" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/logo.png" type="image/png">
    <link rel="manifest" href="/manifest">
    <meta name="theme-color" content="#0D2E67">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Cobrança em Dia">
    <script src="https://unpkg.com/@phosphor-icons/web@2.1.1"></script>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen bg-(--color-surface) antialiased">

    <% current_step_num = (yield(:current_step) || "1").to_i %>

    <%# ── DESKTOP: sidebar + content ──────────────────────── %>
    <div class="hidden md:flex min-h-screen">

      <%# Sidebar %>
      <aside class="flex flex-col w-84 shrink-0 bg-(--color-surface-muted) border-r border-(--color-border) px-8 py-10">

        <%# Logo %>
        <%= link_to root_path, class: "flex items-center gap-2.5 mb-12 group" do %>
          <%= image_tag "/logo.png", alt: "Cobrança em Dia", class: "h-7 w-auto" %>
          <span class="text-sm font-semibold text-(--color-text) group-hover:text-(--color-brand) transition-colors">Cobrança em Dia</span>
        <% end %>

        <%# Vertical stepper %>
        <ol class="flex flex-col flex-1">
          <% [
            { n: 1, label: "Conta",    desc: "Dados da empresa",         icon: "user"             },
            { n: 2, label: "WhatsApp", desc: "Conecte seu número",        icon: "whatsapp-logo"    },
            { n: 3, label: "Teste",    desc: "Envie uma mensagem teste",  icon: "paper-plane-tilt" }
          ].each do |step| %>
            <% is_last   = step[:n] == 3 %>
            <% is_active = step[:n] == current_step_num %>
            <% is_done   = step[:n] < current_step_num %>

            <li class="flex gap-3 items-start">
              <div class="flex flex-col items-center self-stretch">
                <span class="w-12 h-12 rounded-full flex items-center justify-center shrink-0
                     <%= is_done   ? 'bg-(--color-brand-light)'                           :
                         is_active ? 'bg-(--color-brand)'                                 :
                                     'bg-(--color-surface) border border-(--color-border)' %>">
                  <% if is_done %>
                    <i class="ph-fill ph-check text-2xl text-(--color-brand)"></i>
                  <% elsif is_active %>
                    <i class="ph ph-<%= step[:icon] %> text-(--color-text-inverse) text-2xl"></i>
                  <% else %>
                    <i class="ph ph-<%= step[:icon] %> text-(--color-text-subtle) text-2xl"></i>
                  <% end %>
                </span>
                <% unless is_last %>
                  <div class="w-[4px] h-15 mt-2 mb-2 rounded <%= is_done ? 'bg-(--color-brand-light)' : 'bg-(--color-border)' %>"></div>
                <% end %>
              </div>

              <div class="pt-1.5">
                <p class="text-sm font-semibold
                   <%= is_done   ? 'text-(--color-text-muted)'  :
                       is_active ? 'text-(--color-brand)'       :
                                   'text-(--color-text-subtle)' %>">
                  <%= step[:label] %>
                </p>
                <p class="text-xs text-(--color-text-subtle) mt-0.5"><%= step[:desc] %></p>
              </div>
            </li>
          <% end %>
        </ol>

        <%# Logout %>
        <%= button_to destroy_user_session_path, method: :delete,
              class: "flex items-center gap-2 mt-auto px-4 py-2.5 rounded-lg border-(--color-border) text-sm text-(--color-text-muted) hover:bg-(--color-surface-raised) hover:text-(--color-text) transition-colors cursor-pointer" do %>
         Sair  <i class="ph ph-sign-out text-base"></i> 
        <% end %>

      </aside>

      <%# Content %>
      <main class="flex-1 flex flex-col items-center justify-center bg-(--color-surface) p-10">
        <div class="w-full max-w-md">
          <%= yield %>
          <% if current_step_num > 1 && current_step_num < 4 %>
            <div class="text-center mt-6">
              <%= button_to skip_onboarding_path, method: :post,
                    class: "text-xs text-(--color-text-subtle) hover:text-(--color-text-muted) transition-colors cursor-pointer" do %>
                Pular configuração →
              <% end %>
            </div>
          <% end %>
        </div>
      </main>

    </div>

    <%# ── MOBILE: single column ────────────────────────────── %>
    <div class="md:hidden">

      <%# Logout %>
      <%= button_to destroy_user_session_path, method: :delete,
            class: "fixed top-6 right-4 z-50 flex items-center gap-1 text-xs text-(--color-text-subtle) hover:text-(--color-text-muted) transition-colors cursor-pointer" do %>
        Sair <i class="ph ph-sign-out"></i>
      <% end %>

      <main class="min-h-screen flex flex-col items-center justify-center px-6 pt-10 pb-24">
        <div class="w-full max-w-sm">

          <%# Logo %>
          <%= link_to root_path, class: "absolute top-4 left-4 flex items-center justify-center gap-2.5 mb-8 group" do %>
            <%= image_tag "/logo.png", alt: "Cobrança em Dia", class: "h-8 w-auto" %>
            <span class="text-base font-semibold text-(--color-text) group-hover:text-(--color-brand) transition-colors">Cobrança em Dia</span>
          <% end %>

          <%= yield %>

          <% if current_step_num > 1 && current_step_num < 4 %>
            <div class="text-center mt-6">
              <%= button_to skip_onboarding_path, method: :post,
                    class: "text-xs text-(--color-text-subtle) hover:text-(--color-text-muted) transition-colors cursor-pointer" do %>
                Pular configuração →
              <% end %>
            </div>
          <% end %>

        </div>
      </main>

      <%# Progress dots %>
      <div class="fixed bottom-0 inset-x-0 flex justify-center items-center gap-2 py-5 bg-(--color-surface)">
        <% (1..4).each do |n| %>
          <% is_active = n == current_step_num %>
          <% is_done   = n < current_step_num %>
          <div class="rounded-full transition-all duration-300
               <%= is_active ? 'w-6 h-1.5 bg-(--color-brand)' :
                   is_done   ? 'w-1.5 h-1.5 bg-(--color-brand)' :
                               'w-1.5 h-1.5 bg-(--color-border-strong)' %>"></div>
        <% end %>
      </div>

    </div>

  </body>
</html>
