<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <meta name="theme-color" content="#1E7A52">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <title><%= content_for?(:title) ? yield(:title) + " — EscreveZap" : "EscreveZap" %></title>
    <link rel="icon" href="/logo.png">
    <link rel="apple-touch-icon" href="/logo.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>
  <body class="h-full bg-(--color-bg) text-(--color-text) antialiased">

    <%# ── Flash toasts (Notyf) ────────────────────────────────────────── %>
    <% if notice.present? %>
      <span data-controller="toast" data-toast-type-value="notice" data-toast-message-value="<%= notice %>"></span>
    <% end %>
    <% if alert.present? %>
      <span data-controller="toast" data-toast-type-value="alert" data-toast-message-value="<%= alert %>"></span>
    <% end %>

    <%# ── Top bar ─────────────────────────────────────────────────────── %>
    <header class="bg-(--color-surface) border-b border-gray-100 sticky top-0 z-40 safe-area-inset-top">
      <div class="flex items-center justify-between px-4 h-14 max-w-lg mx-auto">
        <%= link_to authenticated_root_path, class: "flex items-center gap-2 font-bold text-(--color-text)" do %>
          <%= image_tag "/logo.png", alt: "EscreveZap", class: "w-7 h-7 rounded-lg" %>
          <span class="text-sm">EscreveZap</span>
        <% end %>

        <%# User avatar → profile %>
        <%= link_to profile_path, class: "flex items-center rounded-full p-1 hover:opacity-80 transition-opacity" do %>
          <% if current_user.avatar.attached? %>
            <img src="<%= url_for(current_user.avatar) %>"
                 alt="<%= current_user.display_name %>"
                 class="w-8 h-8 rounded-full object-cover">
          <% elsif current_user.avatar_url.present? %>
            <img src="<%= current_user.avatar_url %>"
                 alt="<%= current_user.display_name %>"
                 class="w-8 h-8 rounded-full object-cover">
          <% else %>
            <span class="w-8 h-8 rounded-full bg-(--color-brand-light) text-(--color-brand) flex items-center justify-center text-sm font-semibold">
              <%= current_user.display_name.first.upcase %>
            </span>
          <% end %>
        <% end %>
      </div>
    </header>

    <%# ── Content ─────────────────────────────────────────────────────── %>
    <main class="max-w-lg mx-auto px-4 pt-3 pb-24">
      <%= yield %>
    </main>

    <%# ── Bottom navigation ───────────────────────────────────────────── %>
    <nav class="fixed bottom-0 inset-x-0 z-40 bg-(--color-surface) border-t border-(--color-border) pb-safe">
      <div class="max-w-lg mx-auto flex items-center">
        <% nav_items = [
          { path: authenticated_root_path, icon: "ph-house",        label: "Início",   active: controller_name == "dashboard" },
          { path: transcriptions_path,     icon: "ph-list-dashes",  label: "Logs",     active: controller_name == "transcriptions" },
          { path: monitored_contacts_path, icon: "ph-address-book", label: "Contatos", active: controller_name == "monitored_contacts" },
          { path: app_waha_session_path,   icon: "ph-whatsapp-logo",label: "WhatsApp", active: controller_name == "waha_sessions" },
        ] %>
        <% nav_items.each do |item| %>
          <%= link_to item[:path],
                class: "flex-1 flex flex-col items-center gap-0.5 py-2.5 transition-colors #{item[:active] ? 'text-(--color-brand)' : 'text-(--color-text-subtle) hover:text-(--color-text-muted)'}" do %>
            <i class="<%= item[:active] ? 'ph-fill' : 'ph' %> <%= item[:icon] %> text-xl"></i>
            <span class="text-[10px] font-medium"><%= item[:label] %></span>
          <% end %>
        <% end %>
      </div>
    </nav>

    <%# ── Modal frame (dialogs opened via turbo-frame) ──────────────────── %>
    <turbo-frame id="modal"></turbo-frame>

    <script src="https://unpkg.com/@phosphor-icons/web@2.1.1"></script>
    <%= render "shared/notyf" %>
  </body>
</html>
