<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="turbo-cache-control" content="no-preview">

    <%# ── Primary SEO ───────────────────────────────────────────────── %>
    <title><%= page_title %></title>
    <meta name="description" content="<%= page_description %>">
    <meta name="robots"      content="<%= meta_robots %>">
    <meta name="author"      content="EscreveZap">
    <link rel="canonical"    href="<%= canonical_url %>">

    <%# ── Open Graph ────────────────────────────────────────────────── %>
    <meta property="og:type"         content="website">
    <meta property="og:site_name"    content="EscreveZap">
    <meta property="og:title"        content="<%= og_title %>">
    <meta property="og:description"  content="<%= page_description %>">
    <meta property="og:url"          content="<%= canonical_url %>">
    <meta property="og:image"        content="<%= og_image_url %>">
    <meta property="og:image:width"  content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale"       content="pt_BR">

    <%# ── Twitter Card ──────────────────────────────────────────────── %>
    <meta name="twitter:card"        content="summary_large_image">
    <meta name="twitter:site"        content="<%= SeoHelper::SOCIAL_TWITTER %>">
    <meta name="twitter:title"       content="<%= og_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image"       content="<%= og_image_url %>">


    <%# ── Umami Analytics ───────────────────────────────────────────── %>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="32378504-b708-46f3-8ec2-df6b5c0fe9aa"></script>

    <%# ── Structured data (JSON-LD) ─────────────────────────────────── %>
    <%= organization_jsonld %>
    <%= website_jsonld %>
    <%= software_application_jsonld %>
    <%= yield :jsonld if content_for?(:jsonld) %>

    <%# ── PWA / Theme / Icons ───────────────────────────────────────── %>
    <meta name="theme-color" content="#1E7A52">
    <link rel="manifest" href="/manifest">
    <link rel="icon" type="image/png" href="/logo.png">
    <link rel="apple-touch-icon" href="/logo.png">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>
  <body class="bg-(--color-bg) text-(--color-text) antialiased">


    <%# ── Mobile sticky CTA ───────────────────────────────────────────── %>
    <div class="fixed bottom-0 inset-x-0 z-50 p-4 bg-white/95 backdrop-blur border-t border-gray-100 shadow-lg md:hidden">
      <% if user_signed_in? %>
        <%= link_to "Entrar", authenticated_root_path,
              class: "flex items-center justify-center gap-2 w-full bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold py-3.5 rounded-xl text-sm transition-colors" %>
      <% else %>
        <%= link_to new_user_session_path,
              class: "flex items-center justify-center gap-2 w-full bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold py-3.5 rounded-xl text-sm transition-colors" do %>
          <i class="ph ph-whatsapp-logo text-lg"></i>
          Conectar meu WhatsApp
        <% end %>
      <% end %>
    </div>

    <%# Flash toasts (Notyf) %>
    <% if notice.present? %>
      <span data-controller="toast" data-toast-type-value="notice" data-toast-message-value="<%= notice %>"></span>
    <% end %>
    <% if alert.present? %>
      <span data-controller="toast" data-toast-type-value="alert" data-toast-message-value="<%= alert %>"></span>
    <% end %>

    <%# ── Sticky Navbar ────────────────────────────────────────────────── %>
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-gray-100">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">

          <%# Logo %>
          <%= link_to root_path, class: "flex items-center gap-2 flex-shrink-0", "aria-label": "EscreveZap — página inicial" do %>
              <%= image_tag '/logo.png', alt: 'Logotipo EscreveZap', width: 32, height: 32, class: 'w-8 h-8' %>
            <span class="font-bold text-(--color-text) tracking-tight">EscreveZap</span>
          <% end %>

          <%# Desktop nav %>
          <nav class="hidden md:flex items-center gap-7">
            <a href="#como-funciona" class="text-sm text-(--color-text-muted) hover:text-(--color-text) transition-colors">Como funciona</a>
            <a href="#precos"        class="text-sm text-(--color-text-muted) hover:text-(--color-text) transition-colors">Preços</a>
            <a href="#faq"           class="text-sm text-(--color-text-muted) hover:text-(--color-text) transition-colors">FAQ</a>
          </nav>

          <%# Desktop CTA + hamburger %>
          <div class="flex items-center gap-3">
            <% if user_signed_in? %>
              <%= link_to "Entrar", authenticated_root_path,
                    class: "hidden md:inline-flex items-center gap-1.5 bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold px-4 py-2.5 rounded-xl text-sm transition-colors" %>
            <% else %>
              <%= link_to new_user_session_path,
                    class: "hidden md:inline-flex items-center gap-1.5 bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold px-4 py-2.5 rounded-xl text-sm transition-colors" do %>
                <i class="ph ph-whatsapp-logo"></i>
                Conectar WhatsApp
              <% end %>
            <% end %>

            <button type="button" id="hamburger-btn"
                    class="md:hidden p-2 rounded-lg text-(--color-text-muted) hover:bg-(--color-surface-soft) transition-colors"
                    aria-label="Abrir menu" aria-expanded="false">
              <i class="ph ph-list text-xl" id="hamburger-icon"></i>
            </button>
          </div>
        </div>
      </div>

      <%# Mobile dropdown %>
      <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100">
        <div class="max-w-6xl mx-auto px-4 py-3 space-y-1">
          <a href="#como-funciona" class="block px-3 py-2.5 rounded-lg text-sm text-(--color-text) hover:bg-(--color-surface-soft) transition-colors">Como funciona</a>
          <a href="#precos"        class="block px-3 py-2.5 rounded-lg text-sm text-(--color-text) hover:bg-(--color-surface-soft) transition-colors">Preços</a>
          <a href="#faq"           class="block px-3 py-2.5 rounded-lg text-sm text-(--color-text) hover:bg-(--color-surface-soft) transition-colors">FAQ</a>
          <div class="pt-2 border-t border-gray-100">
            <% if user_signed_in? %>
              <%= link_to "Entrar", authenticated_root_path,
                    class: "flex items-center justify-center gap-2 w-full bg-(--color-brand) text-white font-semibold py-3 rounded-xl text-sm" %>
            <% else %>
              <%= link_to "Conectar meu WhatsApp", new_user_session_path,
                    class: "flex items-center justify-center gap-2 w-full bg-(--color-brand) text-white font-semibold py-3 rounded-xl text-sm" %>
            <% end %>
          </div>
        </div>
      </div>
    </header>

    <%# ── Page content ────────────────────────────────────────────────── %>
    <main class="pb-24 md:pb-0">
      <%= yield %>
    </main>

    <%# ── Footer ──────────────────────────────────────────────────────── %>
    <footer class="bg-white border-t border-gray-100 py-10">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8">

          <%# Brand %>
          <div class="col-span-2 md:col-span-1">
            <%= link_to root_path, class: "flex items-center gap-2 mb-3", "aria-label": "EscreveZap — página inicial" do %>
              <%= image_tag '/logo.png', alt: 'Logotipo EscreveZap', width: 32, height: 32, class: 'w-8 h-8' %>
              <span class="text-sm font-semibold text-(--color-text)">EscreveZap</span>
            <% end %>
            <p class="text-xs text-(--color-text-muted) leading-relaxed">
              Transcrição automática de áudios do WhatsApp em texto, com IA.
            </p>
          </div>

          <%# Recursos %>
          <nav aria-label="Recursos" class="text-sm">
            <h2 class="font-semibold text-(--color-text) mb-3">Recursos</h2>
            <ul class="space-y-2 text-(--color-text-muted)">
              <li><%= link_to "Transcrever áudio do WhatsApp", seo_page_path("transcrever-audio-whatsapp"), class: "hover:text-(--color-text)" %></li>
              <li><%= link_to "Converter áudio em texto",      seo_page_path("converter-audio-em-texto"),  class: "hover:text-(--color-text)" %></li>
              <li><%= link_to "Responder áudio do WhatsApp",   seo_page_path("responder-audio-whatsapp"), class: "hover:text-(--color-text)" %></li>
              <li><%= link_to "Áudio do WhatsApp em texto",    seo_page_path("audio-whatsapp-texto"),     class: "hover:text-(--color-text)" %></li>
            </ul>
          </nav>

          <%# Produto %>
          <nav aria-label="Produto" class="text-sm">
            <h2 class="font-semibold text-(--color-text) mb-3">Produto</h2>
            <ul class="space-y-2 text-(--color-text-muted)">
              <li><a href="/#como-funciona" class="hover:text-(--color-text)">Como funciona</a></li>
              <li><%= link_to "Preços", pricing_path, class: "hover:text-(--color-text)" %></li>
              <li><a href="/#testar" class="hover:text-(--color-text)">Testar o motor</a></li>
              <li><a href="/#faq" class="hover:text-(--color-text)">Perguntas frequentes</a></li>
            </ul>
          </nav>

          <%# Legal %>
          <nav aria-label="Legal" class="text-sm">
            <h2 class="font-semibold text-(--color-text) mb-3">Legal</h2>
            <ul class="space-y-2 text-(--color-text-muted)">
              <li><%= link_to "Privacidade", privacidade_path, class: "hover:text-(--color-text)" %></li>
              <li><%= link_to "Termos de uso", termos_path, class: "hover:text-(--color-text)" %></li>
            </ul>
          </nav>
        </div>

        <div class="border-t border-gray-100 pt-6 flex flex-col md:flex-row items-center justify-between gap-3">
          <p class="text-xs text-(--color-text-muted)">© <%= Time.current.year %> EscreveZap. Todos os direitos reservados.</p>
          <p class="text-xs text-(--color-text-subtle)">Feito no Brasil 🇧🇷</p>
        </div>
      </div>
    </footer>

    <%# ── Scripts ─────────────────────────────────────────────────────── %>
    <script src="https://unpkg.com/@phosphor-icons/web@2.1.1"></script>
    <script>
      (function() {
        var btn  = document.getElementById('hamburger-btn');
        var menu = document.getElementById('mobile-menu');
        var icon = document.getElementById('hamburger-icon');
        if (!btn || !menu) return;
        btn.addEventListener('click', function() {
          var open = menu.classList.toggle('hidden') === false;
          btn.setAttribute('aria-expanded', open);
          icon.className = open ? 'ph ph-x text-xl' : 'ph ph-list text-xl';
        });
        menu.querySelectorAll('a').forEach(function(a) {
          a.addEventListener('click', function() {
            menu.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
            icon.className = 'ph ph-list text-xl';
          });
        });
      })();
    </script>
    <%= render "shared/notyf" %>
  </body>
</html>
