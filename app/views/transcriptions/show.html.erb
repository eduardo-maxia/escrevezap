<% content_for :title, "Transcrição" %>

<div class="py-6">
  <%# Back + header %>
  <div class="flex items-center gap-3 mb-6">
    <%= link_to transcriptions_path, class: "p-2 -ml-2 rounded-xl hover:bg-(--color-surface-raised) text-(--color-text-muted) transition-colors" do %>
      <i class="ph ph-arrow-left text-lg"></i>
    <% end %>
    <div class="min-w-0">
      <h1 class="text-xl font-bold text-(--color-text) truncate">
        <%= @transcription.monitored_contact.display_name.presence || @transcription.monitored_contact.phone_number %>
      </h1>
      <p class="text-sm text-(--color-text-muted)">
        <%= @transcription.created_at.strftime("%d de %B de %Y, %H:%M") %>
        <% if @transcription.audio_duration.present? %>
          · <i class="ph ph-microphone text-xs"></i> <%= "%.0f" % @transcription.audio_duration %>s
        <% end %>
      </p>
    </div>
  </div>

  <div class="rounded-2xl bg-(--color-surface) border border-(--color-border) px-5 py-4 mb-4">
    <div class="flex items-center gap-1.5 mb-3">
      <i class="ph ph-list-checks text-sm text-(--color-text-muted)"></i>
      <p class="text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Detalhes da transcrição</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
      <p class="text-(--color-text-muted)">ID da transcrição: <span class="font-medium text-(--color-text)">#<%= @transcription.id %></span></p>
      <p class="text-(--color-text-muted)">
        Status:
        <% if @transcription.completed? %>
          <span class="inline-flex items-center rounded-full bg-green-50 border border-green-200 text-green-700 px-2 py-0.5 text-[10px] font-semibold">Concluída</span>
        <% elsif @transcription.processing? %>
          <span class="inline-flex items-center rounded-full bg-blue-50 border border-blue-200 text-blue-700 px-2 py-0.5 text-[10px] font-semibold">Processando</span>
        <% else %>
          <span class="inline-flex items-center rounded-full bg-(--color-danger-light) border border-(--color-danger) text-(--color-danger) px-2 py-0.5 text-[10px] font-semibold">Falha</span>
        <% end %>
      </p>
      <p class="text-(--color-text-muted)">Direção: <span class="font-medium text-(--color-text)"><%= @transcription.incoming? ? "Recebido" : "Enviado" %></span></p>
      <p class="text-(--color-text-muted)">Message ID: <span class="font-medium text-(--color-text)"><%= @transcription.waha_message_id.presence || "-" %></span></p>
      <p class="text-(--color-text-muted)">Reply ID: <span class="font-medium text-(--color-text)"><%= @transcription.reply_message_id.presence || "-" %></span></p>
      <p class="text-(--color-text-muted)">Duração: <span class="font-medium text-(--color-text)"><%= @transcription.audio_duration.present? ? "#{format('%.0f', @transcription.audio_duration)}s" : "-" %></span></p>
    </div>
    <% if @transcription.provider_usages.any? %>
      <div class="mt-3 border-t border-(--color-border) pt-3">
        <p class="text-[11px] font-semibold text-(--color-text-muted) uppercase tracking-wide mb-2">Custos da transcrição</p>
        <div class="space-y-1.5">
          <% @transcription.provider_usages.each do |usage| %>
            <div class="flex items-center justify-between text-xs">
              <span class="text-(--color-text)"><%= usage.provider %> · <%= usage.unit_type %>: <%= usage.units.to_f %></span>
              <span class="text-(--color-text-muted)">US$ <%= format("%.6f", usage.cost_usd.to_f) %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Status: processing %>
  <% if @transcription.processing? %>
    <div class="flex flex-col items-center gap-4 py-12 text-center">
      <div class="w-12 h-12 border-4 border-(--color-brand) border-t-transparent rounded-full animate-spin"></div>
      <p class="text-sm text-(--color-text-muted)">Transcrevendo o áudio...</p>
    </div>

  <%# Status: failed %>
  <% elsif @transcription.failed? %>
    <div class="rounded-2xl bg-(--color-danger-light) border border-(--color-danger) px-5 py-5">
      <div class="flex items-center gap-2 mb-2">
        <i class="ph ph-warning-circle text-base text-(--color-danger)"></i>
        <p class="text-sm font-semibold text-(--color-danger)">Falha na transcrição</p>
      </div>
      <% if @transcription.error_message.present? %>
        <p class="text-xs text-(--color-danger) opacity-80"><%= @transcription.error_message %></p>
      <% end %>
    </div>

  <%# Status: completed %>
  <% else %>
    <div class="rounded-2xl bg-(--color-surface) border border-(--color-border) px-5 py-4 mb-4">
      <div class="flex items-center gap-1.5 mb-3">
        <i class="ph ph-waveform text-sm text-(--color-text-muted)"></i>
        <p class="text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Áudio original</p>
      </div>
      <% if @transcription.audio.attached? && @transcription.audio.blob.present? %>
        <%= audio_tag url_for(@transcription.audio), controls: true, preload: "metadata", class: "w-full" %>
      <% else %>
        <p class="text-sm text-(--color-text-muted)">Áudio não disponível.</p>
      <% end %>
    </div>

    <div class="rounded-2xl bg-(--color-surface) border border-(--color-border) px-5 py-4 mb-4">
      <div class="flex items-center gap-1.5 mb-3">
        <i class="ph ph-chat-text text-sm text-(--color-text-muted)"></i>
        <p class="text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Texto transcrito</p>
      </div>
      <p class="text-sm text-(--color-text) leading-relaxed whitespace-pre-wrap"><%= @transcription.transcript.presence || "-" %></p>
    </div>

    <div class="rounded-2xl bg-(--color-surface) border border-(--color-border) px-5 py-4 mb-4">
      <div class="flex items-center gap-1.5 mb-3">
        <i class="ph ph-brain text-sm text-(--color-text-muted)"></i>
        <p class="text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Texto de output da LLM</p>
      </div>
      <p class="text-sm text-(--color-text) leading-relaxed whitespace-pre-wrap"><%= @transcription.llm_output_json.presence || "-" %></p>
    </div>

    <%# AI summary (Pro) %>
    <div class="rounded-2xl bg-(--color-brand-subtle) border border-(--color-brand-light) px-5 py-4 mb-4">
      <div class="flex items-center gap-1.5 mb-2">
        <i class="ph ph-sparkle text-sm text-(--color-brand)"></i>
        <p class="text-xs font-semibold text-(--color-brand) uppercase tracking-wide">Resumo</p>
      </div>
      <p class="text-sm text-(--color-text) leading-relaxed whitespace-pre-wrap"><%= @transcription.summary.presence || "-" %></p>
    </div>

    <div class="rounded-2xl bg-(--color-surface) border border-(--color-border) px-5 py-4">
      <div class="flex items-center gap-1.5 mb-3">
        <i class="ph ph-file-text text-sm text-(--color-text-muted)"></i>
        <p class="text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Texto final</p>
      </div>
      <p class="text-sm text-(--color-text) leading-relaxed whitespace-pre-wrap"><%= @transcription.reply_text.presence || "-" %></p>
    </div>
  <% end %>
</div>
