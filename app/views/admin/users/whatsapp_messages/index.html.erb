<% content_for :title, "Histórico WhatsApp — Admin" %>
<% content_for :page_title, "Histórico WhatsApp" %>

<div class="space-y-6">
  <div class="flex items-center gap-3">
    <%= link_to admin_user_path(@user), class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-(--color-text-muted) hover:text-(--color-text) hover:bg-(--color-surface-raised) transition-colors" do %>
      <i class="ph ph-arrow-left text-lg"></i>
    <% end %>
    <div>
      <h1 class="text-lg font-bold text-(--color-text)">Conversa com <%= @user.name.presence || @user.email %></h1>
      <p class="text-sm text-(--color-text-muted)">Linha do tempo completa de mensagens recebidas e enviadas</p>
    </div>
  </div>

  <div class="bg-(--color-surface) border border-(--color-border) rounded-2xl overflow-hidden">
    <div class="px-5 py-4 border-b border-(--color-border) bg-(--color-surface-muted) flex items-center justify-between">
      <h2 class="font-semibold text-(--color-text)">Mensagens</h2>
      <span class="text-xs text-(--color-text-muted) font-medium bg-white px-2 py-1 rounded-md border border-(--color-border)">
        <%= @pagy.count %> registros
      </span>
    </div>

    <% if @messages.any? %>
      <div class="p-4 md:p-6 space-y-2 bg-(--color-surface-muted)/40">
        <% @messages.each do |message| %>
          <% incoming = message.incoming? %>
          <div class="flex <%= incoming ? 'justify-start' : 'justify-end' %>">
            <div class="max-w-[90%] md:max-w-[70%] rounded-2xl px-4 py-3 border shadow-sm <%= incoming ? 'bg-white border-(--color-border)' : 'bg-(--color-brand-light) border-(--color-brand-light)' %>">
              <p class="text-sm text-(--color-text) whitespace-pre-wrap break-words"><%= message.body %></p>
              <div class="mt-2 flex items-center gap-2 text-[11px] text-(--color-text-muted)">
                <span class="font-medium"><%= incoming ? 'Cliente' : 'Bot' %></span>
                <span>•</span>
                <span><%= l(message.sent_at || message.created_at, format: "%d/%m/%Y %H:%M") %></span>
                <span>•</span>
                <span class="uppercase"><%= message.message_type %></span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-10 text-center">
        <i class="ph ph-chat-circle-dots text-3xl text-(--color-text-subtle)"></i>
        <p class="mt-3 font-medium text-(--color-text)">Ainda não há histórico de mensagens.</p>
        <p class="text-sm text-(--color-text-muted)">As novas mensagens do WhatsApp vão aparecer aqui automaticamente.</p>
      </div>
    <% end %>
  </div>

  <% if @pagy.pages > 1 %>
    <div class="flex justify-center">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>
</div>