<% content_for :title, "Clientes — Admin" %>
<% content_for :page_title, "Clientes" %>

<div class="space-y-5">

  <%# ── Search + filters bar ──────────────────────────────────────────── %>
  <%= form_with url: admin_users_path, method: :get, data: { turbo_frame: "_top" }, class: "flex flex-col sm:flex-row gap-3" do |f| %>
    <%# Search input %>
    <div class="relative flex-1">
      <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-(--color-text-muted) text-base pointer-events-none"></i>
      <%= f.text_field :q,
            value: params[:q],
            placeholder: "Buscar por nome ou e-mail…",
            class: "w-full pl-9 pr-4 py-2.5 text-sm bg-(--color-surface) border border-(--color-border) rounded-xl focus:outline-none focus:ring-2 focus:ring-(--color-brand)/30 focus:border-(--color-brand) transition-colors",
            autocomplete: "off" %>
    </div>

    <%# Plan filter %>
    <%= f.select :plan,
          options_for_select([
            ["Todos os planos", ""],
            ["Free",  "free"],
            ["Basic", "basic"],
            ["Pro",   "pro"]
          ], params[:plan]),
          {},
          class: "text-sm bg-(--color-surface) border border-(--color-border) rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-(--color-brand)/30 focus:border-(--color-brand) transition-colors" %>

    <%= f.submit "Buscar",
          class: "px-5 py-2.5 bg-(--color-brand) hover:bg-(--color-brand-dark) text-white text-sm font-medium rounded-xl transition-colors cursor-pointer" %>

    <% if params[:q].present? || params[:plan].present? %>
      <%= link_to "Limpar", admin_users_path,
            class: "px-4 py-2.5 text-sm text-(--color-text-muted) hover:text-(--color-text) border border-(--color-border) rounded-xl transition-colors text-center" %>
    <% end %>
  <% end %>

  <%# ── Results summary ────────────────────────────────────────────────── %>
  <div class="flex items-center justify-between">
    <p class="text-sm text-(--color-text-muted)">
      <% if params[:q].present? || params[:plan].present? %>
        <%= @pagy.count %> resultado<%= @pagy.count == 1 ? "" : "s" %>
        <% if params[:q].present? %> para <strong class="text-(--color-text)">"<%= params[:q] %>"</strong><% end %>
        <% if params[:plan].present? %> · plano <strong class="text-(--color-text)"><%= params[:plan].capitalize %></strong><% end %>
      <% else %>
        <%= @pagy.count %> usuário<%= @pagy.count == 1 ? "" : "s" %> cadastrado<%= @pagy.count == 1 ? "" : "s" %>
      <% end %>
    </p>
    <p class="text-xs text-(--color-text-subtle)">
      Página <%= @pagy.page %> de <%= @pagy.last %>
    </p>
  </div>

  <%# ── Table ──────────────────────────────────────────────────────────── %>
  <div class="bg-(--color-surface) border border-(--color-border) rounded-2xl overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-(--color-border) bg-(--color-surface-muted)">
            <th class="text-left px-4 py-3 text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Usuário</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Plano</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide hidden md:table-cell">Assinatura</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide hidden lg:table-cell">WhatsApp</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide hidden lg:table-cell">Último acesso</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Cadastro</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-(--color-border)">
          <% @users.each do |user| %>
            <% sub = user.subscription %>
            <% ws  = user.waha_session %>
            <tr class="hover:bg-(--color-surface-muted) transition-colors">

              <%# Avatar + name + email %>
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  <%# Avatar initials %>
                  <div class="w-8 h-8 rounded-full bg-(--color-brand-light) flex items-center justify-center flex-shrink-0 text-xs font-bold text-(--color-brand) uppercase">
                    <%= (user.name.presence || user.email).first(2) %>
                  </div>
                  <div class="min-w-0">
                    <p class="font-medium text-(--color-text) truncate"><%= user.name.presence || "—" %></p>
                    <p class="text-xs text-(--color-text-muted) truncate"><%= user.email %></p>
                  </div>
                </div>
              </td>

              <%# Plan badge %>
              <td class="px-4 py-3">
                <% plan_styles = case user.plan
                   when "pro"   then "bg-(--color-brand) text-white"
                   when "basic" then "bg-(--color-brand-light) text-(--color-brand)"
                   else              "bg-(--color-surface-raised) text-(--color-text-muted)"
                   end %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold <%= plan_styles %>">
                  <%= user.plan.capitalize %>
                </span>
              </td>

              <%# Subscription status %>
              <td class="px-4 py-3 hidden md:table-cell">
                <% if sub %>
                  <% sub_styles = case sub.status
                     when "active"    then ["bg-emerald-50 text-emerald-700", "Ativa"]
                     when "trialing"  then ["bg-(--color-warning-light) text-(--color-warning)", "Trial"]
                     when "cancelled" then ["bg-(--color-danger-light) text-(--color-danger)", "Cancelada"]
                     when "past_due"  then ["bg-(--color-warning-light) text-(--color-warning)", "Pendente"]
                     else                  ["bg-(--color-surface-raised) text-(--color-text-muted)", sub.status.capitalize]
                     end %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium <%= sub_styles[0] %>">
                    <%= sub_styles[1] %>
                  </span>
                  <% if sub.pending_downgrade? %>
                    <span class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded text-xs bg-(--color-warning-light) text-(--color-warning)" title="Downgrade agendado para <%= sub.pending_plan.capitalize %>">
                      ↓ <%= sub.pending_plan.capitalize %>
                    </span>
                  <% end %>
                <% else %>
                  <span class="text-xs text-(--color-text-subtle)">—</span>
                <% end %>
              </td>

              <%# WhatsApp status %>
              <td class="px-4 py-3 hidden lg:table-cell">
                <% if ws %>
                  <% ws_connected = ws.waha_status == "working" %>
                  <div class="flex items-center gap-2">
                    <div class="flex items-center gap-1.5 min-w-0">
                      <span class="w-2 h-2 rounded-full flex-shrink-0 <%= ws_connected ? 'bg-emerald-500' : 'bg-(--color-text-subtle)' %>"></span>
                      <span class="text-xs text-(--color-text-muted) truncate max-w-24">
                        <%= ws.display_name.presence || ws.waha_chat_id.presence || ws.waha_status %>
                      </span>
                    </div>
                    <% auto_badge = case ws.auto_transcribe
                       when "both"     then ["bg-(--color-brand) text-white", "auto ↕"]
                       when "incoming" then ["bg-emerald-100 text-emerald-700", "auto ↓"]
                       when "outgoing" then ["bg-(--color-warning-light) text-(--color-warning)", "auto ↑"]
                       end %>
                    <% if auto_badge %>
                      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-semibold flex-shrink-0 <%= auto_badge[0] %>">
                        <%= auto_badge[1] %>
                      </span>
                    <% end %>
                    <%= link_to edit_admin_waha_session_path(ws),
                          data: { turbo_frame: "modal" },
                          class: "flex-shrink-0 p-1 rounded text-(--color-text-subtle) hover:text-(--color-text) hover:bg-(--color-surface-raised) transition-colors",
                          title: "Configurar auto-transcrição" do %>
                      <i class="ph ph-gear text-sm"></i>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-xs text-(--color-text-subtle)">Não conectado</span>
                <% end %>
              </td>

              <%# Last sign in %>
              <td class="px-4 py-3 hidden lg:table-cell">
                <% if user.last_sign_in_at %>
                  <span class="text-xs text-(--color-text-muted)" title="<%= user.last_sign_in_at.strftime("%d/%m/%Y %H:%M") %>">
                    <%= time_ago_in_words(user.last_sign_in_at) %> atrás
                  </span>
                <% else %>
                  <span class="text-xs text-(--color-text-subtle)">Nunca</span>
                <% end %>
              </td>

              <%# Created at %>
              <td class="px-4 py-3">
                <span class="text-xs text-(--color-text-muted)" title="<%= user.created_at.strftime("%d/%m/%Y %H:%M") %>">
                  <%= user.created_at.strftime("%-d %b %Y") %>
                </span>
              </td>

            </tr>
          <% end %>

          <% if @users.empty? %>
            <tr>
              <td colspan="6" class="px-4 py-12 text-center">
                <i class="ph ph-users text-4xl text-(--color-text-subtle) block mb-2"></i>
                <p class="text-sm text-(--color-text-muted)">Nenhum usuário encontrado</p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%# ── Pagination ──────────────────────────────────────────────────────── %>
  <% if @pagy.last > 1 %>
    <div class="flex items-center justify-center gap-1">
      <% if @pagy.prev %>
        <%= link_to admin_users_path(q: params[:q], plan: params[:plan], page: @pagy.prev),
              class: "px-3 py-2 text-sm text-(--color-text-muted) hover:text-(--color-text) border border-(--color-border) rounded-lg hover:bg-(--color-surface-raised) transition-colors" do %>
          <i class="ph ph-caret-left"></i>
        <% end %>
      <% end %>

      <% (@pagy.series).each do |item| %>
        <% if item == :gap %>
          <span class="px-3 py-2 text-sm text-(--color-text-subtle)">…</span>
        <% elsif item == @pagy.page %>
          <span class="px-3 py-2 text-sm font-semibold bg-(--color-brand) text-white rounded-lg"><%= item %></span>
        <% else %>
          <%= link_to item, admin_users_path(q: params[:q], plan: params[:plan], page: item),
                class: "px-3 py-2 text-sm text-(--color-text-muted) hover:text-(--color-text) border border-(--color-border) rounded-lg hover:bg-(--color-surface-raised) transition-colors" %>
        <% end %>
      <% end %>

      <% if @pagy.next %>
        <%= link_to admin_users_path(q: params[:q], plan: params[:plan], page: @pagy.next),
              class: "px-3 py-2 text-sm text-(--color-text-muted) hover:text-(--color-text) border border-(--color-border) rounded-lg hover:bg-(--color-surface-raised) transition-colors" do %>
          <i class="ph ph-caret-right"></i>
        <% end %>
      <% end %>
    </div>
  <% end %>

</div>
