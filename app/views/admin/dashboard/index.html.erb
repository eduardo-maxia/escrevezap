<% content_for :title, "Dashboard Admin" %>
<% content_for :page_title, "Dashboard" %>

<% content_for :head do %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<% end %>

<div class="space-y-6">

  <%# ── Row 1: Top KPIs ──────────────────────────────────────────────── %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">

    <%# MRR %>
    <div class="bg-(--color-surface) border border-(--color-border) rounded-2xl p-5">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-medium text-(--color-text-muted) uppercase tracking-wide">MRR</span>
        <div class="w-8 h-8 rounded-lg bg-(--color-brand-light) flex items-center justify-center">
          <i class="ph ph-currency-dollar-simple text-(--color-brand) text-base"></i>
        </div>
      </div>
      <p class="text-2xl font-bold text-(--color-text)">R$<%= "%.2f" % @mrr %></p>
      <p class="text-xs text-(--color-text-subtle) mt-1"><%= @basic_count %> Basic · <%= @pro_count %> Pro</p>
    </div>

    <%# Assinantes ativos %>
    <div class="bg-(--color-surface) border border-(--color-border) rounded-2xl p-5">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-medium text-(--color-text-muted) uppercase tracking-wide">Assinantes</span>
        <div class="w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center">
          <i class="ph ph-credit-card text-emerald-600 text-base"></i>
        </div>
      </div>
      <p class="text-2xl font-bold text-(--color-text)"><%= @active_subscriptions %></p>
      <p class="text-xs text-(--color-text-subtle) mt-1">
        Conv. <strong class="text-(--color-text)"><%= @conversion_rate %>%</strong> dos usuários
      </p>
    </div>

    <%# MAU %>
    <div class="bg-(--color-surface) border border-(--color-border) rounded-2xl p-5">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-medium text-(--color-text-muted) uppercase tracking-wide">MAU 30d</span>
        <div class="w-8 h-8 rounded-lg bg-violet-50 flex items-center justify-center">
          <i class="ph ph-activity text-violet-600 text-base"></i>
        </div>
      </div>
      <p class="text-2xl font-bold text-(--color-text)"><%= @mau %></p>
      <p class="text-xs text-(--color-text-subtle) mt-1">usuários ativos nos últimos 30d</p>
    </div>

    <%# Total users %>
    <div class="bg-(--color-surface) border border-(--color-border) rounded-2xl p-5">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-medium text-(--color-text-muted) uppercase tracking-wide">Usuários</span>
        <div class="w-8 h-8 rounded-lg bg-sky-50 flex items-center justify-center">
          <i class="ph ph-users text-sky-600 text-base"></i>
        </div>
      </div>
      <p class="text-2xl font-bold text-(--color-text)"><%= @total_users %></p>
      <p class="text-xs text-(--color-text-subtle) mt-1">
        +<%= @new_users_this_month %> este mês
        <% if @new_users_last_month > 0 %>
          <% delta = @new_users_this_month - @new_users_last_month %>
          <span class="<%= delta >= 0 ? 'text-emerald-600' : 'text-(--color-danger)' %>">
            (<%= delta >= 0 ? "+" : "" %><%= delta %> vs anterior)
          </span>
        <% end %>
      </p>
    </div>

  </div>

  <%# ── Row 2: Charts ──────────────────────────────────────────────────── %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">

    <%# Transcriptions line chart (2/3) %>
    <div class="lg:col-span-2 bg-(--color-surface) border border-(--color-border) rounded-2xl p-5">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-sm font-semibold text-(--color-text)">Transcrições por dia</h3>
          <p class="text-xs text-(--color-text-muted)">Últimos 30 dias</p>
        </div>
        <span class="text-lg font-bold text-(--color-text)"><%= @transcriptions_this_month %> este mês</span>
      </div>
      <div class="h-52">
        <canvas id="transcriptionsChart"></canvas>
      </div>
    </div>

    <%# Plan distribution (1/3) %>
    <div class="bg-(--color-surface) border border-(--color-border) rounded-2xl p-5 flex flex-col">
      <div class="mb-4">
        <h3 class="text-sm font-semibold text-(--color-text)">Distribuição de planos</h3>
        <p class="text-xs text-(--color-text-muted)"><%= @total_users %> usuários no total</p>
      </div>

      <div class="flex-1 flex items-center justify-center">
        <div class="w-36 h-36">
          <canvas id="plansChart"></canvas>
        </div>
      </div>

      <div class="mt-4 space-y-2">
        <% [
          ["Free",  @free_count,  "#E2E8F0", false],
          ["Basic", @basic_count, "#DCE8F8", false],
          ["Pro",   @pro_count,   "#0D2E67", false]
        ].each do |label, count, color, _| %>
          <div class="flex items-center justify-between text-xs">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-sm flex-shrink-0" style="background-color: <%= color %>; border: 1px solid rgba(0,0,0,0.08)"></span>
              <span class="text-(--color-text-muted)"><%= label %></span>
            </div>
            <span class="font-semibold text-(--color-text)"><%= count %></span>
          </div>
        <% end %>
      </div>
    </div>

  </div>

  <%# ── Row 3: New users chart + Transcription health ─────────────────── %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">

    <%# New users bar chart (2/3) %>
    <div class="lg:col-span-2 bg-(--color-surface) border border-(--color-border) rounded-2xl p-5">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-sm font-semibold text-(--color-text)">Novos usuários por dia</h3>
          <p class="text-xs text-(--color-text-muted)">Últimos 30 dias</p>
        </div>
        <span class="text-lg font-bold text-(--color-text)"><%= @new_users_this_month %> este mês</span>
      </div>
      <div class="h-36">
        <canvas id="usersChart"></canvas>
      </div>
    </div>

    <%# Transcription health (1/3) %>
    <div class="bg-(--color-surface) border border-(--color-border) rounded-2xl p-5 space-y-4">
      <h3 class="text-sm font-semibold text-(--color-text)">Transcrições</h3>

      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2 text-xs text-(--color-text-muted)">
            <i class="ph ph-waveform text-base"></i>Hoje
          </div>
          <span class="text-sm font-bold text-(--color-text)"><%= @transcriptions_today %></span>
        </div>
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2 text-xs text-(--color-text-muted)">
            <i class="ph ph-calendar-blank text-base"></i>Este mês
          </div>
          <span class="text-sm font-bold text-(--color-text)"><%= @transcriptions_this_month %></span>
        </div>
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2 text-xs <%= @failed_transcriptions > 0 ? 'text-(--color-danger)' : 'text-(--color-text-muted)' %>">
            <i class="ph ph-warning text-base"></i>Falhas este mês
          </div>
          <span class="text-sm font-bold <%= @failed_transcriptions > 0 ? 'text-(--color-danger)' : 'text-(--color-text)' %>">
            <%= @failed_transcriptions %>
          </span>
        </div>
        <% if @transcriptions_this_month > 0 %>
          <% fail_rate = (@failed_transcriptions.to_f / @transcriptions_this_month * 100).round(1) %>
          <div class="pt-2 border-t border-(--color-border)">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-xs text-(--color-text-muted)">Taxa de sucesso</span>
              <span class="text-xs font-semibold <%= fail_rate > 5 ? 'text-(--color-danger)' : 'text-emerald-600' %>">
                <%= (100 - fail_rate).round(1) %>%
              </span>
            </div>
            <div class="h-1.5 bg-(--color-surface-raised) rounded-full overflow-hidden">
              <div class="h-full rounded-full <%= fail_rate > 5 ? 'bg-(--color-danger)' : 'bg-emerald-500' %>"
                   style="width: <%= [(100 - fail_rate), 0].max %>%"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

  </div>

  <%# ── Row 4: Custos + Confiabilidade + Assinaturas ───────────────────── %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

    <%# Custos %>
    <div class="bg-(--color-surface) border border-(--color-border) rounded-2xl p-5">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold text-(--color-text)">Custos de infraestrutura</h3>
        <span class="text-xs text-(--color-text-muted)">este mês</span>
      </div>
      <div class="space-y-3">
        <div class="flex items-center justify-between p-3 bg-(--color-surface-muted) rounded-xl">
          <div class="flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-lg bg-(--color-surface-raised) flex items-center justify-center">
              <i class="ph ph-microphone text-(--color-text-muted) text-sm"></i>
            </div>
            <span class="text-sm text-(--color-text)">Deepgram <span class="text-xs text-(--color-text-muted)">(STT)</span></span>
          </div>
          <span class="text-sm font-bold text-(--color-text) font-mono">US$ <%= "%.4f" % @deepgram_cost_this_month %></span>
        </div>
        <div class="flex items-center justify-between p-3 bg-(--color-surface-muted) rounded-xl">
          <div class="flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-lg bg-(--color-surface-raised) flex items-center justify-center">
              <i class="ph ph-robot text-(--color-text-muted) text-sm"></i>
            </div>
            <span class="text-sm text-(--color-text)">OpenAI <span class="text-xs text-(--color-text-muted)">(LLM)</span></span>
          </div>
          <span class="text-sm font-bold text-(--color-text) font-mono">US$ <%= "%.4f" % @openai_cost_this_month %></span>
        </div>
        <div class="flex items-center justify-between p-3 bg-(--color-brand-light) rounded-xl">
          <div class="flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-lg bg-(--color-brand) flex items-center justify-center">
              <i class="ph ph-coins text-white text-sm"></i>
            </div>
            <span class="text-sm font-semibold text-(--color-brand)">Total</span>
          </div>
          <span class="text-sm font-bold text-(--color-brand) font-mono">US$ <%= "%.4f" % @total_cost_this_month %></span>
        </div>
      </div>
    </div>

    <%# Confiabilidade + Assinaturas %>
    <div class="space-y-4">
      <div class="bg-(--color-surface) border border-(--color-border) rounded-2xl p-5">
        <h3 class="text-sm font-semibold text-(--color-text) mb-4">Confiabilidade</h3>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-3 bg-(--color-surface-muted) rounded-xl">
            <div class="flex items-center gap-1.5 mb-1.5">
              <i class="ph ph-clock text-(--color-text-muted) text-sm"></i>
              <span class="text-xs text-(--color-text-muted)">Fila pendente</span>
            </div>
            <span class="text-xl font-bold text-(--color-text)"><%= @pending_external_events %></span>
          </div>
          <div class="p-3 rounded-xl <%= @failed_external_events > 0 ? 'bg-(--color-danger-light)' : 'bg-(--color-surface-muted)' %>">
            <div class="flex items-center gap-1.5 mb-1.5">
              <i class="ph ph-bug text-sm <%= @failed_external_events > 0 ? 'text-(--color-danger)' : 'text-(--color-text-muted)' %>"></i>
              <span class="text-xs <%= @failed_external_events > 0 ? 'text-(--color-danger)' : 'text-(--color-text-muted)' %>">Falhas (mês)</span>
            </div>
            <span class="text-xl font-bold <%= @failed_external_events > 0 ? 'text-(--color-danger)' : 'text-(--color-text)' %>"><%= @failed_external_events %></span>
          </div>
        </div>
      </div>

      <div class="bg-(--color-surface) border border-(--color-border) rounded-2xl p-5">
        <h3 class="text-sm font-semibold text-(--color-text) mb-4">Assinaturas</h3>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-3 bg-(--color-brand-light) rounded-xl">
            <div class="flex items-center gap-1.5 mb-1.5">
              <i class="ph ph-check-circle text-(--color-brand) text-sm"></i>
              <span class="text-xs text-(--color-brand)">Ativas</span>
            </div>
            <span class="text-xl font-bold text-(--color-brand)"><%= @active_subscriptions %></span>
          </div>
          <div class="p-3 bg-(--color-surface-muted) rounded-xl">
            <div class="flex items-center gap-1.5 mb-1.5">
              <i class="ph ph-x-circle text-(--color-text-muted) text-sm"></i>
              <span class="text-xs text-(--color-text-muted)">Canceladas (mês)</span>
            </div>
            <span class="text-xl font-bold text-(--color-text)"><%= @cancelled_this_month %></span>
          </div>
        </div>
      </div>
    </div>

  </div>

</div>

<%# ── Chart.js initialization ────────────────────────────────────────────── %>
<script>
document.addEventListener("DOMContentLoaded", function () {
  var labels    = <%= @chart_labels.html_safe %>;
  var txData    = <%= @chart_data.html_safe %>;
  var usersData = <%= @users_chart_data.html_safe %>;

  var shortLabels = labels.map(function(d) {
    var parts = d.split("-");
    return parts[2] + "/" + parts[1];
  });

  // ── Transcriptions line chart ──────────────────────────────────────────
  var txCtx = document.getElementById("transcriptionsChart");
  if (txCtx) {
    new Chart(txCtx, {
      type: "line",
      data: {
        labels: shortLabels,
        datasets: [{
          data: txData,
          borderColor: "#0D2E67",
          backgroundColor: "rgba(13,46,103,0.07)",
          borderWidth: 2,
          pointRadius: 0,
          pointHoverRadius: 4,
          tension: 0.4,
          fill: true
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { mode: "index", intersect: false } },
        scales: {
          x: { grid: { display: false }, ticks: { maxTicksLimit: 8, color: "#94A3B8", font: { size: 10 } } },
          y: { beginAtZero: true, grid: { color: "#F1F5F9" }, ticks: { color: "#94A3B8", font: { size: 10 }, precision: 0 } }
        }
      }
    });
  }

  // ── Plan distribution donut ────────────────────────────────────────────
  var plansCtx = document.getElementById("plansChart");
  if (plansCtx) {
    new Chart(plansCtx, {
      type: "doughnut",
      data: {
        labels: ["Free", "Basic", "Pro"],
        datasets: [{
          data: [<%= @free_count %>, <%= @basic_count %>, <%= @pro_count %>],
          backgroundColor: ["#E2E8F0", "#DCE8F8", "#0D2E67"],
          borderWidth: 0,
          hoverOffset: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: "70%",
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: function(ctx) { return " " + ctx.label + ": " + ctx.parsed; } } }
        }
      }
    });
  }

  // ── New users bar chart ────────────────────────────────────────────────
  var usersCtx = document.getElementById("usersChart");
  if (usersCtx) {
    new Chart(usersCtx, {
      type: "bar",
      data: {
        labels: shortLabels,
        datasets: [{
          data: usersData,
          backgroundColor: "rgba(13,46,103,0.12)",
          hoverBackgroundColor: "#0D2E67",
          borderRadius: 3,
          borderSkipped: false
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { mode: "index", intersect: false } },
        scales: {
          x: { grid: { display: false }, ticks: { maxTicksLimit: 8, color: "#94A3B8", font: { size: 10 } } },
          y: { beginAtZero: true, grid: { color: "#F1F5F9" }, ticks: { color: "#94A3B8", font: { size: 10 }, precision: 0 } }
        }
      }
    });
  }
});
</script>

