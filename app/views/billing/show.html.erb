<% content_for :title, "Assinatura" %>

<%
  sub   = @subscription
  used  = current_user.monthly_transcriptions_used
  limit = current_user.transcription_limit
  pct   = [(used.to_f / limit * 100).round, 100].min

  has_active_sub = sub&.active_or_trialing?

  status_cfg = if sub&.active?
    { label: "Ativo",              bg: "bg-(--color-success-light)", fg: "text-(--color-success)" }
  elsif sub&.trialing?
    { label: "Trial",              bg: "bg-(--color-warning-light)", fg: "text-(--color-warning)" }
  elsif sub&.past_due?
    { label: "Pagamento pendente", bg: "bg-(--color-warning-light)", fg: "text-(--color-warning)" }
  elsif sub&.cancelled? || sub&.expired?
    { label: "Cancelado",          bg: "bg-(--color-danger-light)",  fg: "text-(--color-danger)" }
  else
    { label: "Gratuito",           bg: "bg-(--color-surface-raised)", fg: "text-(--color-text-muted)" }
  end

  plans = {
    "free"  => { label: "Grátis", price: "R$0",     limit: 20,    highlights: ["Integração com WhatsApp", "Histórico de transcrições"], icon: "ph-gift",      tone: "muted" },
    "basic" => { label: "Basic",  price: "R$5,99",  limit: 500,   highlights: ["Sem assinatura visual", "Ideal para rotina diária"],    icon: "ph-lightning", tone: "brand" },
    "pro"   => { label: "Pro",    price: "R$19,90", limit: 2_000, highlights: ["Resumo e formatação com IA", "Produtividade máxima"],    icon: "ph-star",      tone: "premium" },
  }

  current_plan = current_user.plan
  upgrade_plan = case current_plan
                 when "free"  then "pro"
                 when "basic" then "pro"
                 else              nil
                 end
  alt_plan = if current_user.free? then "basic" else nil end
%>

<div class="space-y-6">
  <%# Header %>
  <div class="flex items-center gap-3">
    <%= link_to profile_path, class: "w-9 h-9 rounded-full flex items-center justify-center hover:bg-(--color-surface-raised) text-(--color-text-muted) transition-colors" do %>
      <i class="ph ph-arrow-left text-base"></i>
    <% end %>
    <div>
      <h1 class="text-xl font-bold text-(--color-text)">Assinatura</h1>
      <p class="text-xs text-(--color-text-muted)">Gerencie seu plano e limite mensal</p>
    </div>
  </div>

  <%# Current plan + usage (compacto) %>
  <div class="rounded-3xl border border-(--color-border) bg-(--color-surface) p-5 space-y-4">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-wide text-(--color-text-muted)">Plano atual</p>
        <p class="text-2xl font-extrabold text-(--color-text) mt-1"><%= current_user.plan.capitalize %></p>
      </div>
      <span class="px-2.5 py-1 rounded-full text-xs font-semibold <%= status_cfg[:bg] %> <%= status_cfg[:fg] %>">
        <%= status_cfg[:label] %>
      </span>
    </div>

    <% if sub&.pending_downgrade? %>
      <div class="rounded-xl border border-(--color-warning) bg-(--color-warning-light) px-3 py-2 text-xs text-(--color-warning)">
        Muda para <strong><%= sub.pending_plan.capitalize %></strong> no próximo ciclo
        <% if sub.current_period_end.present? %>
          (<%= sub.current_period_end.strftime("%-d/%m/%Y") %>)
        <% end %>
      </div>
    <% elsif has_active_sub && sub.current_period_end.present? %>
      <p class="text-xs text-(--color-text-muted)">
        Renova em <strong class="text-(--color-text)"><%= sub.current_period_end.strftime("%-d de %B de %Y") %></strong>
      </p>
    <% elsif sub&.cancelled? && sub.cancelled_at.present? %>
      <p class="text-xs text-(--color-danger)">
        Cancelado em <%= sub.cancelled_at.strftime("%-d de %B de %Y") %>
      </p>
    <% end %>

    <%# Usage gauge — visual de uso vs limite %>
    <div>
      <div class="flex items-baseline justify-between gap-2 mb-2">
        <p class="text-xs text-(--color-text-muted)">Uso este mês</p>
        <p class="text-sm font-bold text-(--color-text)"><%= used %><span class="text-(--color-text-subtle) font-normal"> / <%= limit %></span></p>
      </div>
      <div class="w-full h-2 bg-(--color-surface-raised) rounded-full overflow-hidden">
        <div class="h-full rounded-full transition-all duration-500 <%= pct >= 90 ? 'bg-(--color-danger)' : 'bg-(--color-brand)' %>" style="width:<%= pct %>%"></div>
      </div>
      <% if pct >= 100 %>
        <p class="text-xs text-(--color-danger) font-medium mt-2">Limite atingido. Faça upgrade para continuar.</p>
      <% elsif pct >= 80 %>
        <p class="text-xs text-(--color-warning) mt-2">Você já usou <%= pct %>% do seu limite mensal.</p>
      <% end %>
    </div>
  </div>

  <%# ────────────── Recomendado para você ────────────── %>
  <% if upgrade_plan %>
    <%
      target  = plans[upgrade_plan]
      current = plans[current_plan]
      delta_transcriptions = target[:limit] - current[:limit]
      multiplier = (target[:limit].to_f / [current[:limit], 1].max).round
    %>

    <div class="relative overflow-hidden rounded-3xl bg-(--color-brand) text-white">
      <%# Decorative shapes %>
      <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-white/10 blur-2xl"></div>
      <div class="absolute -bottom-12 -left-10 w-44 h-44 rounded-full bg-(--color-accent)/30 blur-3xl"></div>

      <div class="relative p-5 space-y-4">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 bg-white/15 text-white text-[11px] font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full">
            <i class="ph-fill ph-sparkle text-xs"></i>
            Recomendado para você
          </span>
        </div>

        <div class="flex items-end justify-between gap-3">
          <div>
            <p class="text-[11px] uppercase tracking-wide text-white/70">Próximo passo</p>
            <p class="text-3xl font-extrabold mt-0.5"><%= target[:label] %></p>
          </div>
          <div class="text-right">
            <p class="text-2xl font-extrabold leading-none"><%= target[:price] %></p>
            <p class="text-xs text-white/70 mt-0.5">/mês</p>
          </div>
        </div>

        <%# Delta cards — o que você ganha %>
        <div class="grid grid-cols-2 gap-2">
          <div class="rounded-2xl bg-white/10 backdrop-blur p-3">
            <p class="text-[10px] uppercase tracking-wide text-white/70">Você passa a ter</p>
            <p class="text-lg font-bold mt-1"><%= target[:limit] %><span class="text-xs font-medium text-white/70"> transcrições/mês</span></p>
            <% if delta_transcriptions > 0 %>
              <p class="text-[11px] font-semibold text-(--color-accent-light) mt-1">+<%= delta_transcriptions %> vs. seu plano atual</p>
            <% end %>
          </div>
          <div class="rounded-2xl bg-white/10 backdrop-blur p-3">
            <p class="text-[10px] uppercase tracking-wide text-white/70">Capacidade</p>
            <p class="text-lg font-bold mt-1"><%= multiplier %>×<span class="text-xs font-medium text-white/70"> mais</span></p>
            <p class="text-[11px] text-white/80 mt-1">do que o <%= current[:label] %></p>
          </div>
        </div>

        <ul class="space-y-1.5">
          <% target[:highlights].each do |highlight| %>
            <li class="flex items-center gap-2 text-sm">
              <i class="ph-fill ph-check-circle text-(--color-accent-light) text-base"></i>
              <span><%= highlight %></span>
            </li>
          <% end %>
        </ul>

        <% if has_active_sub %>
          <%= link_to billing_change_plan_confirm_path(plan: upgrade_plan),
                data: { turbo_frame: "modal" },
                class: "w-full mt-1 inline-flex items-center justify-center gap-2 bg-white text-(--color-brand) hover:bg-white/90 font-bold px-4 py-3 rounded-2xl text-sm transition-colors" do %>
            Fazer upgrade para <%= target[:label] %>
            <i class="ph ph-arrow-right"></i>
          <% end %>
        <% else %>
          <%= button_to billing_upgrade_path(plan: upgrade_plan),
                method: :post,
                data: { turbo: false, controller: "loadable", "loadable-loading-text-value": "Redirecionando..." },
                class: "w-full mt-1 inline-flex items-center justify-center gap-2 bg-white text-(--color-brand) hover:bg-white/90 font-bold px-4 py-3 rounded-2xl text-sm transition-colors disabled:opacity-60 disabled:cursor-not-allowed" do %>
            Assinar <%= target[:label] %>
            <i class="ph ph-arrow-right"></i>
          <% end %>
        <% end %>

        <% if alt_plan %>
          <% alt = plans[alt_plan] %>
          <div class="pt-1">
            <% if has_active_sub %>
              <%= link_to billing_change_plan_confirm_path(plan: alt_plan),
                    data: { turbo_frame: "modal" },
                    class: "w-full inline-flex items-center justify-center gap-2 text-white/90 hover:text-white text-xs font-medium underline underline-offset-2" do %>
                Ou comece com <%= alt[:label] %> · <%= alt[:price] %>/mês
              <% end %>
            <% else %>
              <%= button_to billing_upgrade_path(plan: alt_plan),
                    method: :post,
                    data: { turbo: false, controller: "loadable", "loadable-loading-text-value": "Redirecionando..." },
                    class: "w-full inline-flex items-center justify-center gap-2 text-white/90 hover:text-white text-xs font-medium underline underline-offset-2 bg-transparent border-none p-0 disabled:opacity-60 disabled:cursor-not-allowed" do %>
                Ou comece com <%= alt[:label] %> · <%= alt[:price] %>/mês
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ────────────── Outros planos (recolhível) ────────────── %>
  <details class="group rounded-2xl border border-(--color-border) bg-(--color-surface) overflow-hidden">
    <summary class="flex items-center justify-between gap-3 px-5 py-4 cursor-pointer select-none list-none">
      <div>
        <p class="text-sm font-semibold text-(--color-text)">Ver todos os planos</p>
        <p class="text-xs text-(--color-text-muted) mt-0.5">Compare lado a lado</p>
      </div>
      <i class="ph ph-caret-down text-base text-(--color-text-muted) group-open:rotate-180 transition-transform"></i>
    </summary>

    <div class="border-t border-(--color-border) divide-y divide-(--color-border)">
      <% plans.each do |key, plan| %>
        <div class="px-5 py-4 flex items-center gap-3 <%= current_plan == key ? 'bg-(--color-brand-subtle)' : '' %>">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0
                      <%= plan[:tone] == 'premium' ? 'bg-(--color-brand) text-white' :
                          plan[:tone] == 'brand'   ? 'bg-(--color-brand-subtle) text-(--color-brand)' :
                                                     'bg-(--color-surface-raised) text-(--color-text-muted)' %>">
            <i class="ph <%= plan[:icon] %> text-base"></i>
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <p class="text-sm font-bold text-(--color-text)"><%= plan[:label] %></p>
              <% if current_plan == key %>
                <span class="text-[10px] bg-(--color-brand-light) text-(--color-brand) px-2 py-0.5 rounded-full font-semibold">Atual</span>
              <% end %>
            </div>
            <p class="text-xs text-(--color-text-muted) mt-0.5"><%= plan[:limit] %> transcrições/mês</p>
          </div>

          <div class="text-right flex-shrink-0">
            <p class="text-sm font-bold text-(--color-text)"><%= plan[:price] %></p>
            <p class="text-[11px] text-(--color-text-subtle)">/mês</p>
          </div>

          <% if current_plan != key && key != "free" %>
            <% if has_active_sub %>
              <%= link_to billing_change_plan_confirm_path(plan: key),
                    data: { turbo_frame: "modal" },
                    class: "flex-shrink-0 w-9 h-9 rounded-full bg-(--color-brand) hover:bg-(--color-brand-dark) text-white flex items-center justify-center transition-colors",
                    aria: { label: "Mudar para #{plan[:label]}" } do %>
                <i class="ph ph-arrow-right text-sm"></i>
              <% end %>
            <% else %>
              <%= button_to billing_upgrade_path(plan: key),
                    method: :post,
                    data: { turbo: false, controller: "loadable", "loadable-loading-text-value": "..." },
                    class: "flex-shrink-0 w-9 h-9 rounded-full bg-(--color-brand) hover:bg-(--color-brand-dark) text-white flex items-center justify-center transition-colors disabled:opacity-60 disabled:cursor-not-allowed",
                    aria: { label: "Assinar #{plan[:label]}" } do %>
                <i class="ph ph-arrow-right text-sm"></i>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </details>

  <% if has_active_sub %>
    <div class="pt-1 text-center">
      <%= link_to "Cancelar assinatura",
            billing_cancel_confirm_path,
            class: "text-xs text-(--color-danger) hover:underline",
            data: { turbo_frame: "modal" } %>
    </div>
  <% end %>
</div>
