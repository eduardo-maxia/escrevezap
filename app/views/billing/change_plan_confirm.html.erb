<%
  plan_label = @plan == "pro" ? "Pro" : "Basic"
  plan_price = @plan == "pro" ? "R$19,90/mês" : "R$5,99/mês"
  plan_limit = @plan == "pro" ? "2.000 transcrições/mês" : "500 transcrições/mês"
  current_label = @subscription&.plan&.capitalize || "Grátis"
  plan_rank = { "basic" => 1, "pro" => 2 }
  upgrading = plan_rank[@plan].to_i > plan_rank[@subscription&.plan.to_s].to_i
  icon = @plan == "pro" ? "ph-star" : "ph-lightning"
%>

<turbo-frame id="modal">
  <dialog data-controller="modal" class="app-modal md:max-w-sm">
    <div class="app-modal-handle"></div>

    <%# Header %>
    <div class="flex items-start justify-between gap-4 px-6 py-5 border-b border-(--color-border) flex-shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-(--color-brand-subtle) flex items-center justify-center flex-shrink-0">
          <i class="ph-fill <%= icon %> text-base text-(--color-brand)"></i>
        </div>
        <h2 class="text-base font-bold text-(--color-text)">Mudar para <%= plan_label %></h2>
      </div>
      <button type="button" data-action="click->modal#close"
              class="p-1.5 rounded-lg text-(--color-text-muted) hover:bg-(--color-surface-raised)">
        <i class="ph ph-x text-sm"></i>
      </button>
    </div>

    <%# Body %>
    <div class="px-6 py-5 space-y-4">
      <%# Plan summary %>
      <div class="bg-(--color-surface-muted) border border-(--color-border) rounded-xl p-4 space-y-2">
        <div class="flex items-center justify-between text-sm">
          <span class="text-(--color-text-muted)">Plano atual</span>
          <span class="font-medium text-(--color-text)"><%= current_label %></span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="text-(--color-text-muted)">Novo plano</span>
          <span class="font-bold text-(--color-brand)"><%= plan_label %> · <%= plan_price %></span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="text-(--color-text-muted)">Limite</span>
          <span class="font-medium text-(--color-text)"><%= plan_limit %></span>
        </div>
      </div>

      <p class="text-sm text-(--color-text-muted) leading-relaxed">
        <% if upgrading %>
        <% else %>
          Você continuará no plano atual até o fim do ciclo. A partir do próximo ciclo,
          será cobrado <strong class="text-(--color-text)"><%= plan_price %></strong> pelo plano <%= plan_label %>.
        <% end %>
      </p>

      <%# Confirm button — POST to billing#change_plan %>
      <%= button_to "Confirmar mudança para #{plan_label}",
            billing_change_plan_path(plan: @plan),
            method: :post,
            data: upgrading ? {
              turbo:                         false,
              controller:                    "loadable",
              "loadable-loading-text-value": "Redirecionando..."
            } : {
              turbo_frame:                   "_top",
              controller:                    "loadable",
              "loadable-loading-text-value": "Solicitando..."
            },
            class: "w-full bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold px-4 py-3 rounded-xl text-sm transition-colors inline-flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed" %>

      <button type="button" data-action="click->modal#close"
              class="w-full px-4 py-3 rounded-xl border border-(--color-border) text-sm font-medium text-(--color-text-muted) hover:bg-(--color-surface-raised) transition-colors">
        Voltar
      </button>
    </div>
  </dialog>
</turbo-frame>
