<turbo-frame id="modal">
  <dialog data-controller="modal" class="app-modal md:max-w-sm">
    <div class="app-modal-handle"></div>

    <%# Header %>
    <div class="flex items-start justify-between gap-4 px-6 py-5 border-b border-(--color-border) flex-shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-(--color-danger-light) flex items-center justify-center flex-shrink-0">
          <i class="ph-fill ph-warning text-base text-(--color-danger)"></i>
        </div>
        <h2 class="text-base font-bold text-(--color-text)">Cancelar assinatura</h2>
      </div>
      <button type="button" data-action="click->modal#close"
              class="p-1.5 rounded-lg text-(--color-text-muted) hover:bg-(--color-surface-raised)">
        <i class="ph ph-x text-sm"></i>
      </button>
    </div>

    <%# Body %>
    <div class="px-6 py-5 space-y-4">
      <p class="text-sm text-(--color-text)">
        Sua assinatura será <strong>cancelada imediatamente</strong> e você voltará ao plano gratuito (20 transcrições/mês).
      </p>
      <p class="text-sm text-(--color-text-muted)">
        Esta ação é irreversível. Para reativar, será necessário fazer uma nova assinatura.
      </p>

      <%# Confirm button — DELETE to billing#cancel %>
      <%= button_to "Confirmar cancelamento",
            billing_cancel_path,
            method: :delete,
            data: {
              turbo_frame:                   "_top",
              controller:                    "loadable",
              "loadable-loading-text-value": "Cancelando..."
            },
            class: "w-full bg-(--color-danger) hover:bg-red-700 text-white font-semibold px-4 py-3 rounded-xl text-sm transition-colors inline-flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed" %>

      <button type="button" data-action="click->modal#close"
              class="w-full px-4 py-3 rounded-xl border border-(--color-border) text-sm font-medium text-(--color-text-muted) hover:bg-(--color-surface-raised) transition-colors">
        Voltar
      </button>
    </div>
  </dialog>
</turbo-frame>
