<% content_for :title, "Sem conexão — Cobrança em Dia" %>

<div class="min-h-screen flex items-center justify-center px-6 bg-(--color-surface-muted)">
  <div class="text-center max-w-sm">
    <div class="w-20 h-20 rounded-full bg-(--color-brand-subtle) flex items-center justify-center mx-auto mb-6">
      <i class="ph ph-wifi-slash text-4xl text-(--color-brand)"></i>
    </div>
    <h1 class="text-2xl font-bold text-(--color-text) mb-2">Você está offline</h1>
    <p class="text-sm text-(--color-text-muted) mb-8">
      Verifique sua conexão com a internet e tente novamente.
    </p>
    <button onclick="window.location.reload()"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-(--color-brand) text-(--color-text-inverse) text-sm font-semibold rounded-xl hover:bg-(--color-brand-dark) transition-colors">
      <i class="ph ph-arrow-clockwise"></i>
      Tentar novamente
    </button>
  </div>
</div>
