<% content_for :page_title, "Nova campanha" %>

<div class="p-6 max-w-2xl">

  <nav class="flex items-center gap-1.5 text-xs text-(--color-text-muted) mb-5">
    <%= link_to "Campanhas", campaigns_path, class: "hover:text-(--color-text) transition-colors" %>
    <i class="ph ph-caret-right text-xs"></i>
    <span class="text-(--color-text)">Nova campanha</span>
  </nav>

  <div class="bg-(--color-surface) rounded-xl border border-(--color-border) overflow-hidden">
    <div class="px-6 py-4 flex items-center gap-3 border-b border-(--color-border) bg-(--color-brand-subtle)">
      <div class="w-9 h-9 rounded-xl bg-(--color-brand) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-megaphone text-(--color-text-inverse) text-base"></i>
      </div>
      <div>
        <h2 class="text-base font-bold text-(--color-text) leading-tight">Nova campanha</h2>
        <p class="text-xs text-(--color-text-muted)">Configure os dados da campanha de cobrança mensal</p>
      </div>
    </div>
    <div class="p-6">
      <%= render "form" %>
    </div>
  </div>

</div>
