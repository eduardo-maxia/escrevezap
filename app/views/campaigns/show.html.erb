<% content_for :page_title, @campaign.name %>

<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@28.1.0/dist/css/intlTelInput.css">
  <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@28.1.0/dist/js/intlTelInputWithUtils.min.js"></script>
<% end %>
<% input_cls = "w-full px-3 py-2 bg-(--color-surface) border border-(--color-border) rounded-lg text-sm text-(--color-text) focus:outline-none focus:border-(--color-brand) focus:ring-1 focus:ring-(--color-brand) transition-colors" %>
<% edit_btn_cls = "opacity-0 group-hover:opacity-100 transition-opacity p-1 rounded-md hover:bg-(--color-surface-raised) text-(--color-text-subtle) hover:text-(--color-text-muted) flex-shrink-0" %>
<% save_cls = "px-2.5 py-1.5 bg-(--color-brand) text-(--color-text-inverse) text-xs font-medium rounded-lg hover:bg-(--color-brand-dark) transition-colors cursor-pointer whitespace-nowrap" %>
<% cancel_cls = "px-2.5 py-1.5 border border-(--color-border) text-xs font-medium text-(--color-text-muted) rounded-lg hover:text-(--color-text) transition-colors whitespace-nowrap" %>
<%
  status_class = case @campaign.status
  when "active"   then "bg-(--color-success-light) text-(--color-success)"
  when "paused"   then "bg-(--color-warning-light) text-(--color-warning)"
  when "finished" then "bg-(--color-surface-raised) text-(--color-text-muted)"
  else                 "bg-(--color-info-light) text-(--color-info)"
  end
  status_label = { "draft" => "Rascunho", "active" => "Ativa", "paused" => "Pausada", "finished" => "Finalizada" }[@campaign.status] || @campaign.status
%>

<div class="p-6 space-y-5">

  <%# ── Header ──────────────────────────────────────────────────────── %>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      <nav class="flex items-center gap-1.5 text-xs text-(--color-text-muted) mb-2">
        <%= link_to "Campanhas", campaigns_path, class: "hover:text-(--color-text) transition-colors" %>
        <i class="ph ph-caret-right text-xs"></i>
        <span class="text-(--color-text)"><%= @campaign.name %></span>
      </nav>

      <%# Inline name edit %>
      <div data-controller="inline-edit" class="group">
        <div data-inline-edit-target="view" class="flex items-center gap-3 flex-wrap">
          <h2 class="text-2xl font-bold text-(--color-text)"><%= @campaign.name %></h2>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium <%= status_class %>"><%= status_label %></span>
          <button data-action="click->inline-edit#edit" class="<%= edit_btn_cls %>">
            <i class="ph ph-pencil-simple text-sm"></i>
          </button>
        </div>
        <div data-inline-edit-target="editor" class="hidden mt-1">
          <%= form_with url: campaign_path(@campaign), method: :patch, class: "flex items-center gap-2 flex-wrap" do |f| %>
            <%= f.text_field :name, data: { inline_edit_target: "field" },
                  class: "px-3 py-1.5 text-xl font-bold border border-(--color-border) rounded-lg focus:outline-none focus:border-(--color-brand) text-(--color-text) bg-(--color-surface) min-w-[14rem]" %>
            <%= f.submit "Salvar", class: save_cls %>
            <button type="button" data-action="click->inline-edit#cancel" class="<%= cancel_cls %>">Cancelar</button>
          <% end %>
        </div>
      </div>
    </div>

    <div class="flex-shrink-0 pt-6">
      <%= button_to campaign_path(@campaign), method: :delete,
            class: "p-2 rounded-lg border border-(--color-border) bg-(--color-surface) text-(--color-text-muted) hover:text-(--color-danger) hover:border-(--color-danger) hover:bg-(--color-danger-light) transition-colors",
            title: "Excluir campanha",
            data: { turbo_confirm: "Tem certeza que deseja remover \"#{@campaign.name}\"?" } do %>
        <i class="ph ph-trash text-sm"></i>
      <% end %>
    </div>
  </div>

  <%# ── Main grid ───────────────────────────────────────────────────── %>
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_296px] gap-5 items-start">

    <%# ── LEFT: Clients ──────────────────────────────────────────────── %>
    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) overflow-hidden"
         data-controller="toggle">

      <div class="px-5 py-4 border-b border-(--color-border) flex items-center justify-between">
        <div class="flex items-center gap-2">
          <h3 class="font-semibold text-(--color-text)">Clientes</h3>
          <span class="inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 rounded-full bg-(--color-surface-raised) text-(--color-text-muted) text-xs font-medium">
            <%= @campaign_clients.count %>
          </span>
        </div>
        <button data-action="click->toggle#toggle"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-(--color-brand) text-(--color-text-inverse) text-xs font-medium rounded-lg hover:bg-(--color-brand-dark) transition-colors">
          <i class="ph ph-user-plus text-sm"></i>
          Adicionar
        </button>
      </div>

      <%# Add client panel %>
      <div data-toggle-target="content" class="hidden">
        <div class="px-5 py-5 bg-(--color-surface-muted) border-b border-(--color-border)"
             data-controller="add-client"
             data-add-client-search-url-value="<%= search_clients_path %>"
             data-add-client-check-whatsapp-url-value="<%= onboarding_check_whatsapp_path %>">

          <p class="text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide mb-4">Adicionar cliente à campanha</p>

          <%= form_with url: campaign_campaign_clients_path(@campaign), method: :post do %>

            <%# ── Step 1: Search ── %>
            <div data-add-client-target="searchSection" class="mb-3">
              <label class="block text-xs font-medium text-(--color-text-muted) mb-1.5">Cliente</label>
              <div class="relative">
                <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
                  <i class="ph ph-magnifying-glass text-(--color-text-subtle) text-sm"></i>
                </div>
                <input type="text"
                       placeholder="Buscar pelo nome..."
                       autocomplete="off"
                       data-add-client-target="searchInput"
                       data-action="input->add-client#onInput keydown->add-client#onKeydown blur->add-client#onBlur"
                       class="w-full pl-9 pr-3 py-2.5 bg-(--color-surface) border border-(--color-border) rounded-lg text-sm text-(--color-text) placeholder:text-(--color-text-subtle) focus:outline-none focus:border-(--color-brand) focus:ring-1 focus:ring-(--color-brand) transition-colors">
                <ul data-add-client-target="dropdown"
                    class="hidden absolute z-50 left-0 right-0 mt-1 bg-(--color-surface) border border-(--color-border) rounded-lg shadow-lg overflow-hidden max-h-52 overflow-y-auto">
                </ul>
              </div>
              <p class="mt-1.5 text-xs text-(--color-text-subtle)">Selecione um cliente existente — ou Tab / clique em "Criar novo" para cadastrar.</p>
            </div>

            <%# ── Step 2a: Existing client selected ── %>
            <div data-add-client-target="selectedSection" class="hidden mb-3">
              <label class="block text-xs font-medium text-(--color-text-muted) mb-1.5">Cliente selecionado</label>
              <div class="flex items-center gap-2.5 px-3 py-2.5 bg-(--color-surface) border-2 border-(--color-brand) rounded-lg">
                <div class="w-7 h-7 rounded-full bg-(--color-brand-subtle) flex items-center justify-center flex-shrink-0">
                  <i class="ph ph-user-check text-(--color-brand) text-sm"></i>
                </div>
                <span data-add-client-target="selectedLabel" class="flex-1 text-sm font-medium text-(--color-text) truncate"></span>
                <button type="button"
                        data-action="click->add-client#clearSelection"
                        class="p-0.5 rounded text-(--color-text-subtle) hover:text-(--color-danger) transition-colors flex-shrink-0"
                        title="Remover seleção">
                  <i class="ph ph-x text-sm"></i>
                </button>
              </div>
              <input type="hidden" name="campaign_client[client_id]" data-add-client-target="clientIdHidden">
            </div>

            <%# ── Step 2b: New client ── %>
            <div data-add-client-target="newSection" class="hidden mb-3 space-y-3">
              <div>
                <label class="block text-xs font-medium text-(--color-text-muted) mb-1.5">Novo cliente</label>
                <div class="flex items-center gap-2.5 px-3 py-2.5 bg-(--color-surface) border border-(--color-border) rounded-lg">
                  <div class="w-7 h-7 rounded-full bg-(--color-surface-raised) flex items-center justify-center flex-shrink-0">
                    <i class="ph ph-user-plus text-(--color-text-muted) text-sm"></i>
                  </div>
                  <span data-add-client-target="newNameLabel" class="flex-1 text-sm font-medium text-(--color-text) truncate"></span>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-(--color-brand-subtle) text-(--color-brand)">Novo</span>
                  <button type="button"
                          data-action="click->add-client#clearSelection"
                          class="p-0.5 rounded text-(--color-text-subtle) hover:text-(--color-danger) transition-colors flex-shrink-0"
                          title="Cancelar">
                    <i class="ph ph-x text-sm"></i>
                  </button>
                </div>
                <input type="hidden" name="campaign_client[new_client][name]" data-add-client-target="newNameHidden">
              </div>

              <div>
                <label class="block text-xs font-medium text-(--color-text-muted) mb-1.5">WhatsApp</label>
                <input type="tel"
                       data-add-client-target="phoneInput"
                       data-action="input->add-client#onPhoneInput countrychange->add-client#onPhoneInput"
                       class="w-full px-3 py-2.5 bg-(--color-surface) border border-(--color-border) rounded-lg text-sm text-(--color-text) focus:outline-none focus:border-(--color-brand) focus:ring-1 focus:ring-(--color-brand) transition-colors">
                <input type="hidden" name="campaign_client[new_client][phone_number]" data-add-client-target="phoneHidden">
                <p data-add-client-target="phoneCheck" class="hidden text-xs mt-1.5"></p>
              </div>
            </div>

            <%# ── Step 3: Amount + Date + Submit (hidden until client resolved) ── %>
            <div data-add-client-target="extraFields" class="hidden">
              <div class="grid grid-cols-1 sm:grid-cols-[1fr_9rem_auto] gap-3 items-end">
                <div>
                  <label class="block text-xs font-medium text-(--color-text-muted) mb-1.5">Valor <span class="text-(--color-danger)">*</span></label>
                  <div class="relative">
                    <span class="absolute inset-y-0 left-3 flex items-center text-sm text-(--color-text-muted) pointer-events-none select-none">R$</span>
                    <input type="text"
                           inputmode="numeric"
                           placeholder="0,00"
                           required
                           data-add-client-target="amountDisplay"
                           data-action="input->add-client#onAmountInput"
                           class="w-full pl-9 pr-3 py-2.5 bg-(--color-surface) border border-(--color-border) rounded-lg text-sm text-(--color-text) placeholder:text-(--color-text-subtle) focus:outline-none focus:border-(--color-brand) focus:ring-1 focus:ring-(--color-brand) transition-colors">
                    <input type="hidden" name="campaign_client[amount]" data-add-client-target="amountHidden">
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-medium text-(--color-text-muted) mb-1.5">Dia de vencimento <span class="text-(--color-danger)">*</span></label>
                  <input type="number"
                         name="campaign_client[due_day]"
                         required
                         min="1"
                         max="30"
                         placeholder="Ex: 15"
                         class="w-full px-3 py-2.5 bg-(--color-surface) border border-(--color-border) rounded-lg text-sm text-(--color-text) focus:outline-none focus:border-(--color-brand) transition-colors">
                </div>
                <div>
                  <button type="submit"
                          disabled
                          data-add-client-target="submitBtn"
                          class="w-full px-4 py-2.5 bg-(--color-brand) text-(--color-text-inverse) text-sm font-semibold rounded-lg hover:bg-(--color-brand-dark) transition-colors cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                    Adicionar
                  </button>
                </div>
              </div>
            </div>

          <% end %>
        </div>
      </div>

      <%# Empty state %>
      <% if @campaign_clients.empty? %>
        <div class="py-14 text-center">
          <div class="w-12 h-12 rounded-full bg-(--color-surface-raised) flex items-center justify-center mx-auto mb-3">
            <i class="ph ph-users-three text-(--color-text-subtle) text-2xl"></i>
          </div>
          <p class="text-(--color-text-muted) text-sm font-medium">Nenhum cliente nesta campanha</p>
          <p class="text-(--color-text-subtle) text-xs mt-1">Adicione clientes para começar os disparos</p>
        </div>

      <%# Client table %>
      <% else %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="border-b border-(--color-border) bg-(--color-surface-muted)">
              <tr>
                <th class="text-left px-5 py-3 font-medium text-(--color-text-muted) w-full">Cliente</th>
                <th class="text-left px-4 py-3 font-medium text-(--color-text-muted) whitespace-nowrap">Telefone</th>
                <th class="text-right px-4 py-3 font-medium text-(--color-text-muted) whitespace-nowrap">Valor</th>
                <th class="text-left px-4 py-3 font-medium text-(--color-text-muted) whitespace-nowrap">Próx. venc.</th>
                <th class="text-left px-4 py-3 font-medium text-(--color-text-muted)">Status</th>
                <th class="text-right px-5 py-3"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-(--color-border)">
              <% @campaign_clients.each do |cc| %>
                <%
                  cc_status_class = case cc.status
                  when "active"    then "bg-(--color-success-light) text-(--color-success)"
                  when "paused"    then "bg-(--color-warning-light) text-(--color-warning)"
                  when "completed" then "bg-(--color-info-light) text-(--color-info)"
                  else                  "bg-(--color-surface-raised) text-(--color-text-muted)"
                  end
                  cc_status_label = { "active" => "Ativo", "paused" => "Pausado", "completed" => "Concluído" }[cc.status] || cc.status
                  initials = cc.client.name.split.first(2).map { |w| w[0] }.join.upcase
                %>
                <tr class="hover:bg-(--color-surface-muted) transition-colors group">
                  <td class="px-5 py-3.5">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-full bg-(--color-brand-subtle) flex items-center justify-center flex-shrink-0 text-xs font-bold text-(--color-brand)">
                        <%= initials %>
                      </div>
                      <div class="flex items-center gap-1.5">
                        <div>
                          <p class="font-medium text-(--color-text)"><%= cc.client.name %></p>
                          <% if cc.client.email.present? %>
                            <p class="text-xs text-(--color-text-subtle)"><%= cc.client.email %></p>
                          <% end %>
                        </div>
                        <%= link_to client_path(cc.client),
                              class: "opacity-0 group-hover:opacity-100 p-1 rounded-md text-(--color-text-subtle) hover:text-(--color-brand) hover:bg-(--color-surface-raised) transition-all flex-shrink-0 cursor-pointer",
                              title: "Ver cliente" do %>
                          <i class="ph ph-arrow-square-out text-sm"></i>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td class="px-4 py-3.5 text-(--color-text-muted) whitespace-nowrap text-xs">
                    <%= cc.client.formatted_number || cc.client.phone_number || "—" %>
                  </td>
                  <td class="px-4 py-3.5 text-right whitespace-nowrap">
                    <span class="font-medium text-(--color-text)"><%= number_to_currency(cc.amount, unit: "R$\u00a0", separator: ",", delimiter: ".", precision: 2) %></span>
                  </td>
                  <td class="px-4 py-3.5 whitespace-nowrap">
                    <span class="text-xs text-(--color-text-muted)">dia <%= cc.due_day %></span>
                  </td>
                  <td class="px-4 py-3.5">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium <%= cc_status_class %>">
                      <%= cc_status_label %>
                    </span>
                  </td>
                  <td class="px-5 py-3.5">
                    <div class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                      <%= link_to campaign_client_path(cc),
                            data: { turbo_frame: "modal" },
                            class: "p-1.5 rounded-lg hover:bg-(--color-surface-raised) text-(--color-text-muted) hover:text-(--color-brand) transition-colors cursor-pointer",
                            title: "Ver detalhes" do %>
                        <i class="ph ph-list-dashes text-sm"></i>
                      <% end %>
                      <%= button_to campaign_client_path(cc), method: :delete,
                            class: "p-1.5 rounded-lg hover:bg-(--color-danger-light) text-(--color-text-muted) hover:text-(--color-danger) transition-colors cursor-pointer",
                            title: "Remover",
                            data: { turbo_confirm: "Remover #{cc.client.name} desta campanha?" } do %>
                        <i class="ph ph-trash text-sm"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>

    <%# ── RIGHT: Details sidebar ──────────────────────────────────────── %>
    <div class="bg-(--color-surface) rounded-xl border border-(--color-border) divide-y divide-(--color-border)">

      <%# Status (auto-submit) %>
      <div class="p-4">
        <p class="text-xs font-medium text-(--color-text-muted) mb-2">Status</p>
        <%= form_with url: campaign_path(@campaign), method: :patch,
                      data: { controller: "inline-edit" } do |f| %>
          <%= f.select :status,
                [["Rascunho", "draft"], ["Ativa", "active"], ["Pausada", "paused"], ["Finalizada", "finished"]],
                { selected: @campaign.status },
                data: { action: "change->inline-edit#submit" },
                class: "w-full px-3 py-2 bg-(--color-surface) border border-(--color-border) rounded-lg text-sm text-(--color-text) focus:outline-none focus:border-(--color-brand) focus:ring-1 focus:ring-(--color-brand) transition-colors" %>
        <% end %>
      </div>

      <%# Chip de envio %>
      <div class="p-4 group" data-controller="inline-edit">
        <p class="text-xs font-medium text-(--color-text-muted) mb-1.5">Chip de envio</p>
        <div data-inline-edit-target="view" class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2 text-sm font-semibold text-(--color-text) min-w-0">
            <i class="ph ph-device-mobile text-(--color-text-muted) flex-shrink-0"></i>
            <span class="truncate"><%= @campaign.chip&.formatted_number || @campaign.chip&.name || "Nenhum" %></span>
          </div>
          <button data-action="click->inline-edit#edit" class="<%= edit_btn_cls %>">
            <i class="ph ph-pencil-simple text-xs"></i>
          </button>
        </div>
        <div data-inline-edit-target="editor" class="hidden mt-2">
          <%= form_with url: campaign_path(@campaign), method: :patch, class: "flex items-center gap-2" do |f| %>
            <%= f.select :chip_id, @chips.map { |c| [c.formatted_number || c.name, c.id] },
                  { selected: @campaign.chip_id },
                  class: "flex-1 px-2.5 py-1.5 bg-(--color-surface) border border-(--color-border) rounded-lg text-sm text-(--color-text) focus:outline-none focus:border-(--color-brand)" %>
            <%= f.submit "✓", class: save_cls %>
            <button type="button" data-action="click->inline-edit#cancel" class="<%= cancel_cls %>">✕</button>
          <% end %>
        </div>
      </div>

      <%# Janela de envio %>
      <div class="p-4 group" data-controller="inline-edit">
        <p class="text-xs font-medium text-(--color-text-muted) mb-1.5">Janela de envio</p>
        <div data-inline-edit-target="view" class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2 text-sm font-semibold text-(--color-text)">
            <i class="ph ph-clock text-(--color-text-muted) flex-shrink-0"></i>
            <% if @campaign.start_time && @campaign.end_time %>
              <%= @campaign.start_time.strftime("%H:%M") %> – <%= @campaign.end_time.strftime("%H:%M") %>
            <% else %>
              <span class="font-normal text-(--color-text-subtle)">Não definida</span>
            <% end %>
          </div>
          <button data-action="click->inline-edit#edit" class="<%= edit_btn_cls %>">
            <i class="ph ph-pencil-simple text-xs"></i>
          </button>
        </div>
        <div data-inline-edit-target="editor" class="hidden mt-2">
          <%= form_with url: campaign_path(@campaign), method: :patch do |f| %>
            <div class="flex items-center gap-2 mb-2">
              <div class="flex-1">
                <label class="block text-xs text-(--color-text-muted) mb-1">Início</label>
                <%= f.time_field :start_time, data: { inline_edit_target: "field" },
                      class: "w-full px-2.5 py-1.5 bg-(--color-surface) border border-(--color-border) rounded-lg text-sm text-(--color-text) focus:outline-none focus:border-(--color-brand)" %>
              </div>
              <div class="flex-1">
                <label class="block text-xs text-(--color-text-muted) mb-1">Fim</label>
                <%= f.time_field :end_time,
                      class: "w-full px-2.5 py-1.5 bg-(--color-surface) border border-(--color-border) rounded-lg text-sm text-(--color-text) focus:outline-none focus:border-(--color-brand)" %>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <%= f.submit "Salvar", class: save_cls %>
              <button type="button" data-action="click->inline-edit#cancel" class="<%= cancel_cls %>">Cancelar</button>
            </div>
          <% end %>
        </div>
      </div>

      <%# Mensagem %>
      <div class="p-4 group" data-controller="inline-edit">
        <div data-inline-edit-target="view">
          <div class="flex items-center justify-between gap-2 mb-1.5">
            <p class="text-xs font-medium text-(--color-text-muted)">Mensagem</p>
            <button data-action="click->inline-edit#edit" class="<%= edit_btn_cls %>">
              <i class="ph ph-pencil-simple text-xs"></i>
            </button>
          </div>
          <% if @campaign.template&.dig("body").present? %>
            <p class="text-xs text-(--color-text) whitespace-pre-wrap font-mono leading-relaxed bg-(--color-surface-muted) rounded-lg px-3 py-2 border border-(--color-border)"><%= @campaign.template["body"] %></p>
          <% else %>
            <p class="text-xs text-(--color-text-subtle) italic">Sem mensagem definida</p>
          <% end %>
        </div>
        <div data-inline-edit-target="editor" class="hidden mt-1">
          <%= form_with url: campaign_path(@campaign), method: :patch do |f| %>
            <textarea name="campaign[template][body]"
                      rows="5"
                      data-inline-edit-target="field"
                      class="w-full px-3 py-2 bg-(--color-surface) border border-(--color-border) rounded-lg text-xs font-mono text-(--color-text) focus:outline-none focus:border-(--color-brand) focus:ring-1 focus:ring-(--color-brand) resize-none mb-2"><%= @campaign.template&.dig("body") %></textarea>
            <p class="text-xs text-(--color-text-subtle) mb-2">
              <code class="bg-(--color-surface-raised) px-1 rounded">{{nome}}</code>
              <code class="bg-(--color-surface-raised) px-1 rounded">{{valor}}</code>
              <code class="bg-(--color-surface-raised) px-1 rounded">{{vencimento}}</code>
            </p>
            <div class="flex items-center gap-2">
              <%= f.submit "Salvar", class: save_cls %>
              <button type="button" data-action="click->inline-edit#cancel" class="<%= cancel_cls %>">Cancelar</button>
            </div>
          <% end %>
        </div>
      </div>

    </div><%# end right sidebar %>

  </div><%# end main grid %>

  <%# ── Notifications ───────────────────────────────────────────────── %>
  <div class="bg-(--color-surface) rounded-xl border border-(--color-border) overflow-hidden"
       data-controller="table-filter"
       data-table-filter-frame-value="campaign-notifications"
       data-table-filter-page-param-value="npage">

    <%# ── Filter bar ── %>
    <div class="px-5 py-4 border-b border-(--color-border) flex flex-wrap items-center gap-3">
      <div class="flex items-center gap-2 flex-shrink-0">
        <h3 class="font-semibold text-(--color-text)">Notificações</h3>
        <span class="inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 rounded-full bg-(--color-surface-raised) text-(--color-text-muted) text-xs font-medium">
          <%= @pagy_notif.count %>
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-2 ml-auto">
        <%# Client name search (debounced) %>
        <div class="relative">
          <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
            <i class="ph ph-magnifying-glass text-(--color-text-subtle) text-sm"></i>
          </div>
          <input type="text"
                 name="nq"
                 placeholder="Buscar cliente..."
                 value="<%= params[:nq] %>"
                 autocomplete="off"
                 data-table-filter-target="input"
                 data-action="input->table-filter#filter"
                 class="pl-9 pr-3 py-2 bg-(--color-surface) border border-(--color-border) rounded-lg text-sm text-(--color-text) placeholder:text-(--color-text-subtle) focus:outline-none focus:border-(--color-brand) focus:ring-1 focus:ring-(--color-brand) transition-colors w-44">
        </div>

        <%# Tipo %>
        <div class="relative">
          <select name="ntype"
                  data-table-filter-target="input"
                  data-action="change->table-filter#immediate"
                  class="pl-3 pr-8 py-2 bg-(--color-surface) border border-(--color-border) rounded-lg text-sm text-(--color-text) focus:outline-none focus:border-(--color-brand) transition-colors appearance-none cursor-pointer">
            <option value="" <%= params[:ntype].blank? ? "selected" : "" %>>Todos os tipos</option>
            <option value="message"  <%= params[:ntype] == "message"  ? "selected" : "" %>>WhatsApp</option>
            <option value="email"    <%= params[:ntype] == "email"    ? "selected" : "" %>>E-mail</option>
            <option value="call"     <%= params[:ntype] == "call"     ? "selected" : "" %>>Ligação</option>
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-2.5 flex items-center">
            <i class="ph ph-caret-down text-xs text-(--color-text-subtle)"></i>
          </div>
        </div>

        <%# Status %>
        <div class="relative">
          <select name="nstatus"
                  data-table-filter-target="input"
                  data-action="change->table-filter#immediate"
                  class="pl-3 pr-8 py-2 bg-(--color-surface) border border-(--color-border) rounded-lg text-sm text-(--color-text) focus:outline-none focus:border-(--color-brand) transition-colors appearance-none cursor-pointer">
            <option value="" <%= params[:nstatus].blank? ? "selected" : "" %>>Todos os status</option>
            <option value="pending"   <%= params[:nstatus] == "pending"   ? "selected" : "" %>>Pendente</option>
            <option value="sending"   <%= params[:nstatus] == "sending"   ? "selected" : "" %>>Enviando</option>
            <option value="sent"      <%= params[:nstatus] == "sent"      ? "selected" : "" %>>Enviado</option>
            <option value="delivered" <%= params[:nstatus] == "delivered" ? "selected" : "" %>>Entregue</option>
            <option value="read"      <%= params[:nstatus] == "read"      ? "selected" : "" %>>Lido</option>
            <option value="failed"    <%= params[:nstatus] == "failed"    ? "selected" : "" %>>Falhou</option>
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-2.5 flex items-center">
            <i class="ph ph-caret-down text-xs text-(--color-text-subtle)"></i>
          </div>
        </div>
      </div>
    </div>

    <%# ── Table (turbo-frame inside partial) ── %>
    <%= render "notifications_table" %>
  </div>

</div>
