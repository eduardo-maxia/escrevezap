<% content_for :page_title, "Convidar usuário" %>
<%
  lbl = "block text-xs font-semibold text-(--color-text-subtle) uppercase tracking-wide mb-1 md:text-sm md:font-medium md:normal-case md:tracking-normal md:text-(--color-text) md:mb-1.5"
  inp = "w-full text-sm text-(--color-text) bg-transparent border-0 p-0 focus:outline-none focus:ring-0 placeholder:text-(--color-text-subtle) md:px-3 md:py-2.5 md:bg-(--color-surface) md:border md:border-(--color-border) md:rounded-lg md:focus:border-(--color-brand) md:focus:ring-1 md:focus:ring-(--color-brand) md:transition-colors"
%>

<%# Mobile header %>
<div class="md:hidden flex items-center gap-2 px-4 py-3 border-b border-(--color-border) bg-(--color-surface) sticky top-0 z-10">
  <%= link_to users_path, class: "p-1.5 -ml-1 rounded-lg text-(--color-text) hover:bg-(--color-surface-muted) transition-colors" do %>
    <i class="ph ph-arrow-left text-lg leading-none"></i>
  <% end %>
  <h1 class="text-base font-semibold text-(--color-text)">Convidar usuário</h1>
</div>

<div class="px-4 pt-5 pb-24 md:p-6 md:pb-6 md:max-w-lg space-y-4 md:space-y-6">

  <%# Desktop header %>
  <div class="hidden md:block">
    <nav class="flex items-center gap-1.5 text-xs text-(--color-text-muted) mb-4">
      <%= link_to "Usuários", users_path, class: "hover:text-(--color-text) transition-colors" %>
      <i class="ph ph-caret-right text-xs"></i>
      <span class="text-(--color-text)">Convidar usuário</span>
    </nav>
    <h2 class="text-2xl font-bold text-(--color-text) mb-1">Convidar colaborador</h2>
    <p class="text-sm text-(--color-text-muted)">
      Um e-mail de convite será enviado com o link de acesso. Não é preciso senha.
    </p>
  </div>

  <%# Mobile description %>
  <p class="md:hidden text-sm text-(--color-text-muted)">
    Um e-mail de convite será enviado com o link de acesso.
  </p>

  <% if @user.errors.any? %>
    <div class="flex items-center gap-3 p-3.5 bg-(--color-danger-light) border border-(--color-danger) rounded-xl text-sm text-(--color-danger)">
      <i class="ph ph-warning-circle flex-shrink-0 text-base"></i>
      <span><%= @user.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <%= form_with model: @user, url: users_path do |f| %>
    <div class="space-y-4">
      <div class="bg-(--color-surface) rounded-2xl border border-(--color-border) overflow-hidden md:p-6">

        <%# Nome %>
        <div class="px-4 py-3.5 border-b border-(--color-border) md:px-0 md:py-0 md:border-b-0 md:pb-4">
          <%= f.label :name, "Nome", class: lbl %>
          <%= f.text_field :name,
                placeholder: "Nome completo",
                class: inp,
                autofocus: true,
                enterkeyhint: "next" %>
        </div>

        <%# E-mail %>
        <div class="px-4 py-3.5 md:px-0 md:py-0">
          <%= f.label :email, "E-mail", class: lbl %>
          <%= f.email_field :email,
                placeholder: "colaborador@empresa.com",
                class: inp,
                required: true,
                enterkeyhint: "go" %>
        </div>

      </div>

      <div class="md:flex md:items-center md:justify-end md:gap-3">
        <%= link_to "Cancelar", users_path,
              class: "hidden md:inline-flex items-center px-4 py-2.5 border border-(--color-border) text-sm font-medium text-(--color-text-muted) rounded-lg hover:text-(--color-text) transition-colors" %>
        <button type="submit"
                data-controller="loadable"
                data-loadable-loading-text-value="Criando..."
                class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-(--color-brand) text-(--color-text-inverse) text-sm font-semibold rounded-lg hover:bg-(--color-brand-dark) transition-colors cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed">
          Criar usuário
        </button>
      </div>
    </div>
  <% end %>

</div>
