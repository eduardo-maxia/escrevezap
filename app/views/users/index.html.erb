<% content_for :page_title, "Usuários" %>

<%# Mobile header %>
<div class="md:hidden flex items-center gap-2 px-4 py-3 border-b border-(--color-border) bg-(--color-surface) sticky top-0 z-10">
  <%= link_to authenticated_root_path, class: "p-1.5 -ml-1 rounded-lg text-(--color-text) hover:bg-(--color-surface-muted) transition-colors" do %>
    <i class="ph ph-arrow-left text-lg leading-none"></i>
  <% end %>
  <h1 class="flex-1 text-base font-semibold text-(--color-text)">Usuários</h1>
  <%= link_to new_user_path,
        class: "inline-flex items-center gap-1.5 px-3 py-1.5 bg-(--color-brand) text-(--color-text-inverse) text-xs font-medium rounded-lg hover:bg-(--color-brand-dark) transition-colors" do %>
    <i class="ph ph-plus text-sm"></i>
    Convidar
  <% end %>
</div>

<div class="p-4 md:p-6 space-y-5">

  <%# Header (desktop only) %>
  <div class="hidden md:flex items-center justify-between gap-3">
    <div class="min-w-0">
      <h2 class="text-2xl font-bold text-(--color-text)">Usuários</h2>
      <p class="text-sm text-(--color-text-muted) mt-1">Membros com acesso à conta da empresa.</p>
    </div>
    <%= link_to new_user_path,
          class: "inline-flex items-center gap-2 px-4 py-2 bg-(--color-brand) text-(--color-text-inverse) text-sm font-medium rounded-lg hover:bg-(--color-brand-dark) transition-colors flex-shrink-0" do %>
      <i class="ph ph-plus text-sm"></i>
      Convidar usuário
    <% end %>
  </div>

  <%# Mobile: card list %>
  <div class="md:hidden bg-(--color-surface) rounded-2xl border border-(--color-border) overflow-hidden divide-y divide-(--color-border)">
    <% if @users.empty? %>
      <div class="px-4 py-12 text-center">
        <i class="ph ph-users-three text-(--color-text-subtle) text-3xl block mb-2"></i>
        <p class="text-sm text-(--color-text-muted)">Nenhum usuário encontrado.</p>
      </div>
    <% else %>
      <% @users.each do |user| %>
        <div class="flex items-center gap-3 px-4 py-3.5">
          <div class="w-9 h-9 rounded-full bg-(--color-surface-raised) flex items-center justify-center flex-shrink-0">
            <i class="ph ph-user text-(--color-text-muted) text-base"></i>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
              <p class="text-sm font-medium text-(--color-text) truncate"><%= user.name.presence || "—" %></p>
              <% if user == current_user %>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-(--color-surface-raised) text-(--color-text-muted)">você</span>
              <% end %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wide <%= user.owner? ? '''bg-(--color-brand-light) text-(--color-brand)''' : '''bg-(--color-surface-raised) text-(--color-text-muted)''' %>">
                <%= user.owner? ? "Dono" : "Membro" %>
              </span>
            </div>
            <p class="text-xs text-(--color-text-muted) truncate mt-0.5"><%= user.email %></p>
          </div>
          <% if current_user.owner? && user != current_user %>
            <%= button_to resend_invite_user_path(user), method: :post,
                  class: "shrink-0 p-1.5 text-(--color-text-subtle) hover:text-(--color-brand) hover:bg-(--color-brand-light) rounded-lg transition-colors cursor-pointer",
                  title: "Reenviar convite",
                  data: { controller: "loadable", "loadable-spinner-only-value": "true" } do %>
              <i class="ph ph-paper-plane-right text-base leading-none"></i>
            <% end %>
            <%= button_to user_path(user), method: :delete,
                  class: "shrink-0 p-1.5 text-(--color-text-subtle) hover:text-(--color-danger) hover:bg-(--color-danger-light) rounded-lg transition-colors cursor-pointer",
                  title: "Remover usuário",
                  data: { turbo_confirm: "Remover #{user.name.presence || user.email}?" } do %>
              <i class="ph ph-trash text-base leading-none"></i>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# Desktop: table %>
  <div class="hidden md:block bg-(--color-surface) rounded-xl border border-(--color-border) overflow-hidden">
    <% if @users.empty? %>
      <div class="py-16 text-center text-(--color-text-muted)">
        <i class="ph ph-users-three text-4xl block mb-2"></i>
        <p class="text-sm">Nenhum usuário encontrado.</p>
      </div>
    <% else %>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-(--color-border) bg-(--color-surface-muted)">
            <th class="px-5 py-3 text-left text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Usuário</th>
            <th class="px-5 py-3 text-left text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Papel</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-(--color-border)">
          <% @users.each do |user| %>
            <%
              role_label, role_color, role_bg =
                if user.owner?
                  ["Dono", "--color-brand", "--color-brand-light"]
                else
                  ["Membro", "--color-text-muted", "--color-surface-muted"]
                end
            %>
            <tr class="group hover:bg-(--color-surface-muted) transition-colors">
              <td class="px-5 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-(--color-surface-raised) flex items-center justify-center flex-shrink-0">
                    <i class="ph ph-user text-(--color-text-muted) text-sm"></i>
                  </div>
                  <div class="min-w-0">
                    <p class="font-medium text-(--color-text) truncate"><%= user.name.presence || "—" %></p>
                    <p class="text-xs text-(--color-text-muted) truncate"><%= user.email %></p>
                  </div>
                  <% if user == current_user %>
                    <span class="text-xs px-1.5 py-0.5 rounded bg-(--color-surface-raised) text-(--color-text-muted)">você</span>
                  <% end %>
                </div>
              </td>
              <td class="px-5 py-4">
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-(<%= role_bg %>) text-(<%= role_color %>)">
                  <%= role_label %>
                </span>
              </td>
              <td class="px-5 py-4 text-right">
                <% if current_user.owner? && user != current_user %>
                  <div class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-all">
                    <%= button_to resend_invite_user_path(user), method: :post,
                          class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-(--color-brand) hover:bg-(--color-brand-light) rounded-lg transition-colors",
                          title: "Reenviar convite",
                          data: { controller: "loadable", "loadable-spinner-only-value": "true" } do %>
                      <i class="ph ph-paper-plane-right"></i>
                      Reenviar convite
                    <% end %>
                    <%= button_to user_path(user), method: :delete,
                          class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-(--color-danger) hover:bg-(--color-danger-light) rounded-lg transition-colors",
                          data: { turbo_confirm: "Tem certeza que deseja remover #{user.name.presence || user.email}?" } do %>
                      <i class="ph ph-trash"></i>
                      Remover
                    <% end %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

</div>
