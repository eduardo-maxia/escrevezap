<% content_for :page_title, "Usuários" %>

<div class="p-6 space-y-5">

  <%# ── Header ──────────────────────────────────────────────────────── %>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="text-2xl font-bold text-(--color-text)">Usuários</h2>
      <p class="text-sm text-(--color-text-muted) mt-1">Membros com acesso à conta da empresa.</p>
    </div>
    <%= link_to new_user_path,
          class: "inline-flex items-center gap-2 px-4 py-2 bg-(--color-brand) text-(--color-text-inverse) text-sm font-medium rounded-lg hover:bg-(--color-brand-dark) transition-colors" do %>
      <i class="ph ph-plus text-sm"></i>
      Convidar usuário
    <% end %>
  </div>

  <%# ── Table ───────────────────────────────────────────────────────── %>
  <div class="bg-(--color-surface) rounded-xl border border-(--color-border) overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-(--color-border) bg-(--color-surface-muted)">
          <th class="px-5 py-3 text-left text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Usuário</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Papel</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-(--color-border)">
        <% @users.each do |user| %>
          <%
            role_label, role_color, role_bg =
              if user.owner?
                ["Dono", "--color-brand", "--color-brand-light"]
              else
                ["Membro", "--color-text-muted", "--color-surface-muted"]
              end
          %>
          <tr class="group hover:bg-(--color-surface-muted) transition-colors">
            <td class="px-5 py-4">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-(--color-surface-raised) flex items-center justify-center flex-shrink-0">
                  <i class="ph ph-user text-(--color-text-muted) text-sm"></i>
                </div>
                <div class="min-w-0">
                  <p class="font-medium text-(--color-text) truncate"><%= user.name.presence || "—" %></p>
                  <p class="text-xs text-(--color-text-muted) truncate"><%= user.email %></p>
                </div>
                <% if user == current_user %>
                  <span class="text-xs px-1.5 py-0.5 rounded bg-(--color-surface-raised) text-(--color-text-muted)">você</span>
                <% end %>
              </div>
            </td>
            <td class="px-5 py-4">
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-(<%= role_bg %>) text-(<%= role_color %>)">
                <%= role_label %>
              </span>
            </td>
            <td class="px-5 py-4 text-right">
              <% if current_user.owner? && user != current_user %>
                <%= button_to user_path(user), method: :delete,
                      class: "opacity-0 group-hover:opacity-100 inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-(--color-danger) hover:bg-(--color-danger-light) rounded-lg transition-all",
                      data: { turbo_confirm: "Tem certeza que deseja remover #{user.name.presence || user.email}?" } do %>
                  <i class="ph ph-trash"></i>
                  Remover
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @users.empty? %>
      <div class="text-center py-12 text-(--color-text-muted)">
        <i class="ph ph-users-three text-4xl block mb-2"></i>
        <p class="text-sm">Nenhum usuário encontrado.</p>
      </div>
    <% end %>
  </div>

</div>
