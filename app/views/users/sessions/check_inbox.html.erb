<% content_for :title, t("auth.check_inbox.title") %>

<div class="text-center">
  <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-(--color-brand-light) text-(--color-brand) text-3xl mb-6">
    <i class="ph ph-envelope-open"></i>
  </div>
  <h1 class="text-2xl font-bold text-(--color-text)"><%= t("auth.check_inbox.title") %></h1>
  <p class="mt-3 text-sm text-(--color-text-muted) leading-relaxed">
    <%= t("auth.check_inbox.message", email: @email) %>
  </p>
  <p class="mt-4 text-xs text-(--color-text-muted)"><%= t("auth.check_inbox.spam_note") %></p>

  <div class="mt-8">
    <%= link_to t("auth.check_inbox.back"), new_user_session_path,
          class: "text-sm font-medium text-(--color-brand) hover:text-(--color-brand-dark) transition-colors" %>
  </div>
</div>
