<% content_for :title, "Conectar WhatsApp" %>

<% content_for :auth_left do %>
  <div class="relative z-10 flex flex-1 flex-col justify-center">
    <div class="flex items-center gap-3 mb-12">
      <%= image_tag "/logo.png", alt: "EscreveZap", class: "w-10 h-10" %>
      <span class="text-xl font-bold tracking-tight">EscreveZap</span>
    </div>

    <h2 class="text-3xl font-bold leading-snug mb-3">
      Conecte seu WhatsApp<br>e comece agora.
    </h2>
    <p class="text-white/70 text-sm leading-relaxed mb-10">
      Após conectar, o EscreveZap transcreve automaticamente os áudios das conversas que você quiser monitorar.
    </p>

    <ul class="space-y-5">
      <li class="flex items-start gap-4">
        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-white/20 flex items-center justify-center text-xs font-bold">1</span>
        <div>
          <p class="text-sm font-medium">Faça login</p>
          <p class="text-xs text-white/60 mt-0.5">Já feito ✓</p>
        </div>
      </li>
      <li class="flex items-start gap-4">
        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-white flex items-center justify-center text-(--color-brand) text-xs font-bold">2</span>
        <div>
          <p class="text-sm font-semibold">Conecte seu WhatsApp</p>
          <p class="text-xs text-white/60 mt-0.5">Use o código de emparelhamento de 8 dígitos</p>
        </div>
      </li>
      <li class="flex items-start gap-4">
        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-white/20 flex items-center justify-center text-xs font-bold">3</span>
        <div>
          <p class="text-sm font-medium">Adicione contatos para monitorar</p>
          <p class="text-xs text-white/60 mt-0.5">Transcrições chegam direto na conversa</p>
        </div>
      </li>
    </ul>
  </div>

  <p class="relative z-10 text-white/40 text-xs mt-auto">© <%= Time.current.year %> EscreveZap</p>
<% end %>

<div
  data-controller="onboarding-connect"
  data-onboarding-connect-pairing-url-value="<%= pairing_code_app_waha_session_path(format: :json) %>"
  data-onboarding-connect-reconnect-url-value="<%= onboarding_reconnect_path %>"
  data-onboarding-connect-dashboard-url-value="<%= authenticated_root_path %>"
  data-onboarding-connect-status-url-value="<%= status_app_waha_session_path(format: :json) %>"
  data-onboarding-connect-status-value="<%= @waha_session.waha_status %>">

  <div class="lg:hidden fixed bottom-6 inset-x-0 z-10 flex items-center justify-center gap-1.5 pointer-events-none">
    <span class="w-2 h-2 rounded-full" style="background:#CBD5E1"></span>
    <span class="w-6 h-2 rounded-full bg-(--color-brand)"></span>
    <span class="w-2 h-2 rounded-full" style="background:#CBD5E1"></span>
  </div>

  <div class="mb-6">
    <h1 class="text-2xl font-bold text-(--color-text)">Conectar WhatsApp</h1>
    <p class="mt-1 text-sm text-(--color-text-muted)">Use o código de emparelhamento no seu WhatsApp</p>
    <div class="mt-3">
      <%= button_to "Conectar depois",
            onboarding_skip_connection_path,
            method: :post,
            data: {
              controller: "loadable",
              "loadable-loading-text-value": "Continuando..."
            },
            class: "inline-flex items-center justify-center gap-2 text-xs text-(--color-text-muted) hover:text-(--color-text) underline underline-offset-2 transition-colors bg-transparent border-none p-0 disabled:opacity-60 disabled:cursor-not-allowed" %>
    </div>
  </div>



  <div data-onboarding-connect-target="pairingPanel" class="md:bg-(--color-surface) md:rounded-2xl md:border md:border-(--color-border) md:p-5">
    <div data-onboarding-connect-target="phoneFormWrapper">
      <p class="text-sm text-(--color-text-muted) mb-4 leading-relaxed">
        Digite seu número do WhatsApp para receber um código de emparelhamento de 8 dígitos.
      </p>
      <form data-action="submit->onboarding-connect#requestPairingCode" novalidate>
        <div class="mb-3">
          <input type="tel"
                 name="phone_number"
                 inputmode="numeric"
                 autocomplete="tel"
                 class="w-full bg-(--color-surface) border border-(--color-border) rounded-xl px-4 py-3 text-sm text-(--color-text) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-transparent transition"
                 data-onboarding-connect-target="phoneInput">
        </div>
        <button type="submit"
                data-onboarding-connect-target="pairingSubmitBtn"
                class="w-full flex items-center justify-center gap-2 bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold px-4 py-3 rounded-xl text-sm transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
          <span data-onboarding-connect-target="pairingBtnText">Receber código</span>
        </button>
        <div data-onboarding-connect-target="pairingError" class="hidden mt-3 items-center gap-2 rounded-lg bg-(--color-danger-light) border border-(--color-danger) px-3 py-2.5 text-xs text-(--color-danger)">
          <i class="ph ph-warning-circle flex-shrink-0"></i>
          <span data-onboarding-connect-target="pairingErrorText"></span>
        </div>
      </form>
    </div>
    <div data-onboarding-connect-target="codeWrapper" class="hidden flex-col items-center gap-5 py-4">
      <div class="text-center">
        <p class="text-sm text-(--color-text-muted) mb-3 leading-relaxed">
          No WhatsApp, vá em <strong>Dispositivos conectados</strong> → <strong>Vincular com número de telefone</strong> e insira o código:
        </p>
        <div class="flex flex-col items-center gap-3">
          <div class="inline-flex items-center justify-center bg-(--color-brand-subtle) border-2 border-(--color-brand-light) rounded-2xl px-8 py-5 cursor-pointer hover:bg-(--color-brand-light) transition-colors" data-action="click->onboarding-connect#copyCode" title="Copiar código">
            <span class="font-mono text-3xl font-bold tracking-[0.2em] text-(--color-brand)" data-onboarding-connect-target="codeText">- - - -</span>
          </div>
          <button type="button" data-action="click->onboarding-connect#copyCode" class="flex items-center gap-1.5 text-xs font-semibold text-(--color-brand) hover:text-(--color-brand-dark) transition-colors bg-(--color-brand-subtle) hover:bg-(--color-brand-light) px-3 py-1.5 rounded-lg border border-(--color-brand-light)">
            <i class="ph ph-copy" data-onboarding-connect-target="copyIcon"></i>
            <span data-onboarding-connect-target="copyText">Copiar código</span>
          </button>
        </div>
      </div>
      <button type="button"
              data-action="click->onboarding-connect#resetPairing"
              class="flex items-center gap-1.5 text-xs text-(--color-text-muted) hover:text-(--color-text) transition-colors">
        <i class="ph ph-arrow-u-up-left"></i>
        Usar outro número
      </button>
    </div>
  </div>

  <div data-onboarding-connect-target="errorPanel" class="hidden flex-col items-center gap-5 py-8 text-center">
    <div class="w-16 h-16 rounded-full bg-(--color-danger-light) flex items-center justify-center">
      <i class="ph ph-wifi-slash text-4xl text-(--color-danger)"></i>
    </div>
    <div>
      <h3 class="text-lg font-bold text-(--color-text)" data-onboarding-connect-target="errorTitle">Falha ao conectar</h3>
      <p class="text-sm text-(--color-text-muted) mt-1 max-w-xs" data-onboarding-connect-target="errorMessage">Tente iniciar novamente.</p>
    </div>
    <button
      type="button"
      data-action="click->onboarding-connect#reconnect"
      data-onboarding-connect-target="reconnectButton"
      class="inline-flex items-center justify-center gap-2 bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold px-6 py-3 rounded-xl text-sm transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
      <i class="ph ph-arrows-clockwise text-base"></i>
      <span data-onboarding-connect-target="reconnectButtonText">Reiniciar sessão</span>
    </button>
  </div>

  <div data-onboarding-connect-target="successPanel" class="hidden flex-col items-center gap-4 py-8 text-center">
    <div class="w-16 h-16 rounded-full bg-(--color-brand-light) flex items-center justify-center">
      <i class="ph ph-check-circle text-4xl text-(--color-brand)"></i>
    </div>
    <div>
      <h3 class="text-lg font-bold text-(--color-text)">Conectado com sucesso!</h3>
      <p class="text-sm text-(--color-text-muted) mt-1">Redirecionando para o painel...</p>
    </div>
  </div>
</div>
