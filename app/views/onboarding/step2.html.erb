<% content_for :current_step, "2" %>

<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@28.1.0/dist/css/intlTelInput.css">
  <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@28.1.0/dist/js/intlTelInputWithUtils.min.js"></script>
<% end %>

<div class="bg-(--color-surface) rounded-2xl border border-(--color-border) shadow-sm overflow-hidden"
     data-controller="chip-auth"
     data-chip-auth-start-url-value="<%= onboarding_start_waha_session_path %>"
     data-chip-auth-request-code-url-value="<%= onboarding_request_waha_pairing_code_path %>"
     data-chip-auth-qr-url-value="<%= onboarding_waha_qr_code_path %>"
     data-chip-auth-status-url-value="<%= onboarding_chip_status_path %>"
     data-chip-auth-step4-url-value="<%= onboarding_step3_path %>">

  <%# Card header %>
  <div class="px-6 py-4 flex items-center gap-3 border-b border-(--color-border) bg-(--color-brand-subtle)">
    <div class="w-9 h-9 rounded-xl bg-(--color-brand) flex items-center justify-center flex-shrink-0">
      <i class="ph ph-whatsapp-logo text-(--color-text-inverse) text-base"></i>
    </div>
    <div class="text-left">
      <h2 class="text-base font-bold text-(--color-text) leading-tight">Conecte seu WhatsApp</h2>
      <p class="text-(--color-text-muted) text-xs">Escaneie o QR code ou use o código de pareamento.</p>
    </div>
  </div>

  <div class="p-5">
    <%# Tab toggle %>
    <div class="flex gap-1 bg-(--color-surface-raised) p-1 rounded-lg mb-6">
      <button type="button"
        data-action="click->chip-auth#switchToQr"
        data-chip-auth-target="qrTab"
        class="flex-1 flex items-center justify-center gap-2 py-2.5 px-4 rounded-md text-sm font-medium transition-all duration-200 cursor-pointer bg-(--color-brand) text-(--color-text-inverse)">
        <i class="ph ph-qr-code text-base"></i>
        QR Code
      </button>
      <button type="button"
        data-action="click->chip-auth#switchToCode"
        data-chip-auth-target="codeTab"
        class="flex-1 flex items-center justify-center gap-2 py-2.5 px-4 rounded-md text-sm font-medium transition-all duration-200 cursor-pointer text-(--color-text-muted) hover:text-(--color-text)">
        <i class="ph ph-device-mobile text-base"></i>
        Código Direto
      </button>
    </div>

    <%# QR panel %>
    <div data-chip-auth-target="qrPanel">
      <div class="flex flex-col items-center gap-4">

        <div class="w-52 h-52 rounded-xl border-2 border-(--color-border) flex items-center justify-center bg-(--color-surface-raised) relative overflow-hidden">
          <div data-chip-auth-target="qrSpinner" class="flex flex-col items-center gap-3">
            <div class="w-8 h-8 border-2 border-(--color-brand) border-t-transparent rounded-full animate-spin"></div>
            <p class="text-xs text-(--color-text-muted)">Preparando QR...</p>
          </div>
          <img data-chip-auth-target="qrImage"
               class="hidden absolute inset-0 w-full h-full object-contain"
               alt="QR Code WhatsApp" />
        </div>

        <div class="flex items-start gap-2 text-sm text-(--color-text-muted) text-center max-w-xs">
          <i class="ph ph-info text-base flex-shrink-0 mt-0.5"></i>
          <p>Abra o WhatsApp → Configurações → Aparelhos Conectados → Conectar novo aparelho</p>
        </div>

        <div data-chip-auth-target="qrHint"
             class="flex items-center gap-2 text-xs bg-(--color-warning-light) text-(--color-warning) px-3 py-2 rounded-lg">
          <div class="w-2 h-2 rounded-full bg-(--color-warning) animate-pulse"></div>
          <span>Aguardando leitura do QR code...</span>
        </div>

      </div>
    </div>

    <%# Pairing code panel %>
    <div data-chip-auth-target="codePanel" class="hidden">
      <div class="space-y-4">

        <div class="flex items-start gap-3 text-sm text-(--color-text-muted) bg-(--color-surface-raised) rounded-lg p-4">
          <ol class="list-none space-y-2">
            <li class="flex items-start gap-2">
              <span class="font-bold text-(--color-brand) flex-shrink-0">1.</span>
              Abra o WhatsApp e vá em <strong>Configurações</strong>
            </li>
            <li class="flex items-start gap-2">
              <span class="font-bold text-(--color-brand) flex-shrink-0">2.</span>
              Toque em <strong>Dispositivos Conectados</strong>
            </li>
            <li class="flex items-start gap-2">
              <span class="font-bold text-(--color-brand) flex-shrink-0">3.</span>
              Toque em <strong>Conectar dispositivo</strong>
            </li>
            <li class="flex items-start gap-2">
              <span class="font-bold text-(--color-brand) flex-shrink-0">4.</span>
              Toque em <strong>Vincular com número de telefone</strong>
            </li>
            <li class="flex items-start gap-2">
              <span class="font-bold text-(--color-brand) flex-shrink-0">5.</span>
              Digite o código exibido abaixo
            </li>
          </ol>
        </div>

        <%# Phone form (visible before code is generated) %>
        <div data-chip-auth-target="phoneForm">
          <label for="chip_phone_display" class="block text-sm font-medium text-(--color-text) mb-2">
            Seu número do WhatsApp
          </label>
          <div class="flex gap-2 items-start">
            <div class="flex-1 min-w-0" data-controller="phone-input">
              <input type="tel"
                     id="chip_phone_display"
                     data-phone-input-target="input"
                     class="w-full px-3.5 py-2.5 rounded-lg border border-(--color-border) bg-(--color-surface) text-(--color-text) text-sm placeholder:text-(--color-text-subtle) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) transition-colors">
              <input type="hidden"
                     data-phone-input-target="hidden"
                     data-chip-auth-target="phoneInput">
            </div>
            <button type="button"
                    data-action="click->chip-auth#requestCode"
                    data-chip-auth-target="requestCodeBtn"
                    class="px-4 py-2.5 bg-(--color-brand) hover:bg-(--color-brand-dark) text-(--color-text-inverse) text-sm font-medium rounded-lg transition-colors cursor-pointer whitespace-nowrap disabled:opacity-50">
              Gerar código
            </button>
          </div>
          <p data-chip-auth-target="codeError" class="hidden text-xs text-(--color-error) mt-1.5"></p>
        </div>

        <%# Code display (visible after code is generated) %>
        <div data-chip-auth-target="codeDisplay" class="hidden text-center">
          <p class="text-xs text-(--color-text-subtle) mb-3">Digite este código no WhatsApp</p>
          <div class="flex items-center justify-center gap-1.5 mb-4" data-chip-auth-target="codeBoxes">
            <%# Filled dynamically by Stimulus %>
          </div>
          <div class="flex items-center justify-center mb-3">
            <button type="button"
                    data-action="click->chip-auth#copyCode"
                    data-chip-auth-target="copyBtn"
                    class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border border-(--color-brand) text-(--color-brand) text-sm font-medium hover:bg-(--color-brand-light) transition-colors cursor-pointer disabled:opacity-50">
              <i class="ph ph-copy text-sm"></i>
              Copiar código
            </button>
          </div>
          <p class="text-xs text-(--color-text-subtle)">
            Expira em <span data-chip-auth-target="countdown" class="font-medium text-(--color-warning)">5:00</span>
          </p>
          <button type="button"
                  data-action="click->chip-auth#resetCode"
                  class="mt-3 text-xs text-(--color-text-muted) hover:text-(--color-text) underline cursor-pointer block mx-auto">
            Usar outro número
          </button>
        </div>

      </div>
    </div>

    <%# Success state %>
    <div data-chip-auth-target="successPanel" class="hidden text-center py-4">
      <div class="w-16 h-16 rounded-full bg-(--color-success-light) flex items-center justify-center mx-auto mb-4">
        <i class="ph ph-check-circle text-(--color-success) text-4xl"></i>
      </div>
      <h3 class="text-lg font-semibold text-(--color-text) mb-1">WhatsApp conectado!</h3>
      <p class="text-sm text-(--color-text-muted)">Redirecionando para o próximo passo...</p>
    </div>

    <%# Error / FAILED state %>
    <div data-chip-auth-target="errorPanel" class="hidden text-center py-4">
      <div class="w-16 h-16 rounded-full bg-(--color-error-light) flex items-center justify-center mx-auto mb-4">
        <i class="ph ph-warning-circle text-(--color-error) text-4xl"></i>
      </div>
      <h3 class="text-lg font-semibold text-(--color-text) mb-1">Falha na conexão</h3>
      <p class="text-sm text-(--color-text-muted) mb-4" data-chip-auth-target="errorMessage">
        Não foi possível estabelecer a conexão com o WhatsApp.
      </p>
      <button type="button"
              data-action="click->chip-auth#retrySession"
              class="px-5 py-2.5 bg-(--color-brand) hover:bg-(--color-brand-dark) text-(--color-text-inverse) text-sm font-medium rounded-lg transition-colors cursor-pointer">
        <i class="ph ph-arrow-clockwise mr-1"></i>
        Tentar novamente
      </button>
    </div>
  </div>
</div>

