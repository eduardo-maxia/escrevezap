<% content_for :current_step, "1" %>

<div>

  <div class="mb-5">
    <h2 class="text-xl font-bold text-(--color-text)">Bem-vindo! <span class="not-italic">👋</span></h2>
    <p class="text-(--color-text-muted) text-sm mt-1">Configure sua conta em menos de 2 minutos.</p>
  </div>

  <% if @error %>
    <div id="alert-step1"
         class="flex items-center p-4 mb-6 text-sm text-(--color-danger) rounded-xl bg-(--color-danger-light) border border-(--color-danger)"
         role="alert">
      <i class="ph ph-warning-circle text-lg shrink-0"></i>
      <span class="ms-3 font-medium flex-1"><%= @error %></span>
      <button type="button"
              class="ms-auto -mx-1.5 -my-1.5 text-(--color-danger) rounded-lg p-1.5 hover:bg-(--color-danger-light) inline-flex items-center justify-center h-8 w-8"
              data-dismiss-target="#alert-step1"
              aria-label="Fechar">
        <i class="ph ph-x text-sm"></i>
      </button>
    </div>
  <% end %>

  <%= form_with url: onboarding_step1_path, method: :post do |f| %>
    <div class="space-y-4">

      <div>
        <label for="step1_name" class="block mb-2 text-sm font-medium text-(--color-text)">
          Seu nome <span class="text-(--color-danger)">*</span>
        </label>
        <%= f.text_field :name,
              id: "step1_name",
              value: @name,
              placeholder: "Como podemos te chamar?",
              autofocus: true,
              enterkeyhint: "next",
              class: "bg-(--color-surface-muted) border border-(--color-border) text-(--color-text) text-sm rounded-lg focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) block w-full p-2.5 placeholder:text-(--color-text-subtle) transition-colors" %>
      </div>

      <div>
        <label for="step1_company" class="block mb-2 text-sm font-medium text-(--color-text)">
          Nome da empresa <span class="text-(--color-danger)">*</span>
        </label>
        <%= f.text_field :company_name,
              id: "step1_company",
              value: @company_name,
              placeholder: "Ex: Academia Fit, Clínica Saúde...",
              enterkeyhint: "done",
              class: "bg-(--color-surface-muted) border border-(--color-border) text-(--color-text) text-sm rounded-lg focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) block w-full p-2.5 placeholder:text-(--color-text-subtle) transition-colors" %>
        <p class="mt-2 text-xs text-(--color-text-subtle)">Este nome aparecerá para seus clientes.</p>
      </div>

      <button type="submit"
              data-controller="loadable"
              data-loadable-loading-text-value="Salvando..."
              class="w-full inline-flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed bg-(--color-brand) hover:bg-(--color-brand-dark) text-(--color-text-inverse) font-semibold py-2.5 px-5 rounded-lg text-sm transition-colors cursor-pointer">
        Começar configuração
        <i class="ph ph-arrow-right text-base"></i>
      </button>

    </div>
  <% end %>

</div>