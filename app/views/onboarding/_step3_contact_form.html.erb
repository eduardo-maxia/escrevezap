<div data-controller="contact-picker"
     data-contact-picker-url-value="<%= onboarding_step3_whatsapp_contacts_path(format: :json) %>">

  <div data-contact-picker-target="overlay" class="hidden">
    <div class="fixed inset-0 z-50 bg-(--color-surface) flex flex-col">
      <div class="flex items-center gap-3 px-4 py-3.5 bg-(--color-surface) border-b border-(--color-border) flex-shrink-0">
        <button type="button"
                data-action="click->contact-picker#closePicker"
                class="w-9 h-9 rounded-full flex items-center justify-center hover:bg-(--color-surface-raised) text-(--color-text-muted) transition-colors flex-shrink-0">
          <i class="ph ph-arrow-left text-lg"></i>
        </button>
        <div class="flex-1 min-w-0">
          <h2 class="text-base font-bold text-(--color-text) leading-tight">Selecionar contato</h2>
          <p data-contact-picker-target="count" class="text-xs text-(--color-text-subtle) leading-tight mt-0.5"></p>
        </div>
      </div>

      <div class="px-4 py-2.5 bg-(--color-surface) border-b border-(--color-border) flex-shrink-0">
        <div class="relative">
          <i class="ph ph-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-(--color-text-subtle) text-sm pointer-events-none"></i>
          <input type="search"
                 placeholder="Buscar nome ou número..."
                 autocomplete="off"
                 data-contact-picker-target="search"
                 data-action="input->contact-picker#filter"
                 class="w-full bg-(--color-surface-muted) rounded-full pl-10 pr-4 py-2.5 text-sm text-(--color-text) placeholder:text-(--color-text-subtle) focus:outline-none focus:bg-(--color-surface) focus:ring-2 focus:ring-(--color-brand) transition">
        </div>
      </div>

      <div data-contact-picker-target="loading"
           class="flex items-center justify-center gap-3 py-20 text-sm text-(--color-text-muted) flex-shrink-0">
        <div class="w-5 h-5 border-2 border-(--color-brand) border-t-transparent rounded-full animate-spin flex-shrink-0"></div>
        Carregando contatos...
      </div>

      <div data-contact-picker-target="list" class="flex-1 overflow-y-auto bg-(--color-surface)"></div>

      <div data-contact-picker-target="empty" class="hidden">
        <div class="flex flex-col items-center justify-center gap-3 py-24 text-(--color-text-muted)">
          <i class="ph ph-address-book text-5xl text-(--color-border-strong)"></i>
          <p class="text-sm font-semibold">Nenhum contato encontrado</p>
          <p class="text-xs text-(--color-text-subtle)">Tente outro nome ou número</p>
        </div>
      </div>
    </div>
  </div>

  <%= form_with model: contact, url: onboarding_create_contact_path, method: :post, data: { turbo: true } do |f| %>
    <% if contact.errors.any? %>
      <div class="mb-5 rounded-xl bg-(--color-danger-light) border border-(--color-danger) px-4 py-3 text-sm text-(--color-danger)">
        <p class="font-semibold mb-1">Corrija os erros:</p>
        <ul class="list-disc list-inside space-y-0.5">
          <% contact.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-5">
      <div>
        <label class="block text-sm font-medium text-(--color-text) mb-2">
          Contato do WhatsApp <span class="text-(--color-danger)">*</span>
        </label>

        <button type="button"
                data-contact-picker-target="trigger"
                data-action="click->contact-picker#openPicker"
                class="w-full flex items-center gap-4 bg-(--color-surface) border-2 border-dashed border-(--color-border) hover:border-(--color-brand) hover:bg-(--color-brand-subtle) rounded-2xl px-4 py-4 transition-all group text-left">
          <div class="w-10 h-10 rounded-full bg-(--color-brand-light) flex items-center justify-center flex-shrink-0 group-hover:bg-(--color-brand) transition-colors">
            <i class="ph ph-user-plus text-(--color-brand) text-lg group-hover:text-white transition-colors"></i>
          </div>
          <div class="flex-1">
            <p class="text-sm font-semibold text-(--color-text)">Escolher contato</p>
            <p class="text-xs text-(--color-text-muted) mt-0.5">Busque no seu WhatsApp</p>
          </div>
          <i class="ph ph-caret-right text-(--color-text-muted) text-base group-hover:text-(--color-brand) transition-colors"></i>
        </button>

        <div data-contact-picker-target="selectedCard" class="hidden">
          <div class="flex items-center gap-4 bg-(--color-brand-subtle) border border-(--color-brand-light) rounded-2xl px-4 py-3.5">
            <div class="w-10 h-10 rounded-full bg-(--color-brand) flex items-center justify-center flex-shrink-0">
              <i class="ph-fill ph-check-circle text-white text-lg"></i>
            </div>
            <div class="flex-1 min-w-0">
              <p data-contact-picker-target="selectedName" class="text-sm font-semibold text-(--color-text) truncate"></p>
              <p data-contact-picker-target="selectedPhone" class="text-xs text-(--color-text-muted) truncate mt-0.5"></p>
            </div>
            <button type="button"
                    data-action="click->contact-picker#openPicker"
                    class="flex-shrink-0 text-xs font-medium text-(--color-brand) hover:text-(--color-brand-dark) px-3 py-1.5 rounded-lg hover:bg-(--color-brand-light) transition-colors">
              Trocar
            </button>
          </div>
        </div>

        <%= f.hidden_field :phone_number, data: { "contact-picker-target": "phone" } %>
      </div>

      <div class="pt-1">
        <input id="onboarding-advanced-options" type="checkbox" class="peer sr-only">

        <label for="onboarding-advanced-options"
               class="inline-flex items-center gap-2.5 cursor-pointer select-none text-xs text-(--color-text-muted) hover:text-(--color-text) transition-colors">
          <span class="relative w-8 h-4 rounded-full bg-(--color-border) transition-colors peer-checked:bg-(--color-brand)">
            <span class="absolute top-0.5 left-0.5 w-3 h-3 rounded-full bg-white shadow-sm transition-transform peer-checked:translate-x-4"></span>
          </span>
          Ver opções avançadas
        </label>

        <div class="hidden peer-checked:block mt-3 space-y-4 rounded-2xl border border-(--color-border) bg-(--color-surface-muted) p-4">
          <div>
            <label class="block text-sm font-medium text-(--color-text) mb-1.5">
              Número manual (opcional)
            </label>
            <input type="tel"
                   placeholder="5511999999999"
                   inputmode="numeric"
                   autocomplete="tel"
                   data-action="input->contact-picker#manualPhone"
                   class="w-full bg-(--color-surface) border border-(--color-border) rounded-xl px-4 py-3 text-sm text-(--color-text) placeholder:text-(--color-text-subtle) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-transparent transition">
            <p class="mt-1.5 text-xs text-(--color-text-muted)">Código do país + DDD + número. Ex: 5511999999999</p>
          </div>

          <div>
            <label class="block text-sm font-medium text-(--color-text) mb-1.5">
              Nome (opcional)
            </label>
            <%= f.text_field :display_name,
                  placeholder: "Ex: João Silva",
                  data: { "contact-picker-target": "name" },
                  class: "w-full bg-(--color-surface) border border-(--color-border) rounded-xl px-4 py-3 text-sm text-(--color-text) placeholder:text-(--color-text-subtle) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-transparent transition" %>
          </div>

          <div>
            <label class="block text-sm font-medium text-(--color-text) mb-2">
              Transcrever mensagens
            </label>
            <div class="grid grid-cols-3 gap-2">
              <% MonitoredContact.directions.each_key do |dir| %>
                <label class="relative cursor-pointer">
                  <%= f.radio_button :direction, dir, class: "sr-only peer", checked: (contact.direction || "both") == dir %>
                  <div class="flex flex-col items-center gap-1.5 rounded-xl border-2 px-3 py-3 text-center transition-all
                              border-(--color-border) text-(--color-text-muted)
                              peer-checked:border-(--color-brand) peer-checked:bg-(--color-brand-subtle) peer-checked:text-(--color-brand)">
                    <i class="ph <%= dir == 'incoming' ? 'ph-arrow-down-left' : dir == 'outgoing' ? 'ph-arrow-up-right' : 'ph-arrows-left-right' %> text-lg"></i>
                    <span class="text-xs font-medium leading-tight"><%= t("monitored_contact.direction.#{dir}") %></span>
                  </div>
                </label>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <button type="submit"
              data-controller="loadable"
              data-loadable-loading-text-value="Adicionando..."
              class="w-full flex items-center justify-center gap-2 bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold px-4 py-3 rounded-xl text-sm transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
        Adicionar contato e continuar
      </button>
    </div>
  <% end %>
</div>
