<% content_for :current_step, "3" %>

<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@28.1.0/dist/css/intlTelInput.css">
  <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@28.1.0/dist/js/intlTelInputWithUtils.min.js"></script>
<% end %>

<% if @notification %>
  <%
    raw_status  = @notification.notification_status.to_s
    norm_status = raw_status == "read" ? "delivered" : raw_status
    failed      = raw_status == "failed"
    step_order  = %w[pending sending sent delivered]
    cur_idx     = failed ? -1 : (step_order.index(norm_status) || -1)
    state_for   = ->(key) {
      i = step_order.index(key)
      next "waiting" unless i
      i < cur_idx ? "done" : (i == cur_idx ? "active" : "waiting")
    }
    steps = [
      { key: "pending",   label: "Na fila",  sub: "Aguardando o envio" },
      { key: "sending",   label: "Enviando", sub: "Processando via WhatsApp" },
      { key: "sent",      label: "Enviado",  sub: "Chegou ao WhatsApp" },
      { key: "delivered", label: "Entregue", sub: "Recebido no dispositivo" },
    ]
    done = %w[delivered read].include?(raw_status)
  %>

  <div data-controller="notification-status"
       data-notification-status-notification-id-value="<%= @notification.id %>"
       data-notification-status-current-status-value="<%= norm_status %>">

    <%# Header %>
    <div class="mb-5">
      <h2 class="text-xl font-bold text-(--color-text) flex items-center gap-2">
        <i class="ph-fill ph-rocket-launch text-(--color-brand) text-2xl"></i>
        Mensagem enviada!
      </h2>
      <p class="text-(--color-text-muted) text-sm mt-1.5">Acompanhe em tempo real o status da sua mensagem.</p>
    </div>

    <%# Tracking area %>
    <div data-notification-status-target="trackingArea" class="<%= done ? 'hidden' : '' %>">

      <%# Recipient info %>
      <div class="flex items-center gap-3 bg-(--color-surface-muted) rounded-xl border border-(--color-border) px-4 py-3 mb-6">
        <div class="w-9 h-9 rounded-full bg-(--color-brand-subtle) flex items-center justify-center shrink-0">
          <i class="ph ph-user text-(--color-brand) text-base"></i>
        </div>
        <div class="min-w-0">
          <p class="text-sm font-medium text-(--color-text) truncate"><%= @notification.campaign_client.client.name rescue "Seu cliente" %></p>
          <p class="text-xs text-(--color-text-subtle)"><%= @notification.campaign_client.client.formatted_number rescue "" %></p>
        </div>
        <div class="ms-auto shrink-0">
          <i class="ph ph-whatsapp-logo text-(--color-brand) text-xl"></i>
        </div>
      </div>

      <%# Failed banner (Flowbite dismissible alert) %>
      <div id="alert-failed"
           data-notification-status-target="failedBanner"
           class="<%= failed ? '' : 'hidden' %> flex items-center p-4 mb-6 text-sm text-(--color-danger) rounded-xl bg-(--color-danger-light) border border-(--color-danger)"
           role="alert">
        <i class="ph ph-warning-circle text-lg shrink-0"></i>
        <div class="ms-3 flex-1">
          <p class="font-semibold">Falha no envio</p>
          <p class="text-xs opacity-80 mt-0.5">Não foi possível entregar a mensagem. Verifique o WhatsApp conectado.</p>
        </div>
      </div>

      <%# Flowbite vertical timeline %>
      <ol class="relative ms-4 border-s-2 border-(--color-border)">
        <% steps.each_with_index do |s, idx| %>
          <% st = state_for.call(s[:key]) %>
          <% is_last = idx == steps.length - 1 %>
          <li class="group <%= is_last ? 'ms-6' : 'mb-8 ms-6' %>"
              data-notification-status-target="step"
              data-step="<%= s[:key] %>"
              data-state="<%= st %>">

            <%# Dot — positioned on the timeline border %>
            <span class="absolute flex items-center justify-center w-8 h-8 rounded-full -start-4
                         ring-4 ring-(--color-surface) transition-all duration-300
                         group-data-[state=done]:bg-(--color-success)
                         group-data-[state=active]:bg-(--color-brand) group-data-[state=active]:ring-(--color-brand-light)
                         group-data-[state=waiting]:bg-(--color-surface-raised) group-data-[state=waiting]:border-2 group-data-[state=waiting]:border-(--color-border)">
              <i class="ph ph-check-bold text-white text-xs
                        group-data-[state=waiting]:hidden group-data-[state=active]:hidden"></i>
              <div class="w-2 h-2 rounded-full bg-white animate-pulse
                          group-data-[state=done]:hidden group-data-[state=waiting]:hidden"></div>
            </span>

            <h3 class="text-sm font-semibold transition-colors duration-300
                        group-data-[state=done]:text-(--color-success)
                        group-data-[state=active]:text-(--color-brand)
                        group-data-[state=waiting]:text-(--color-text-muted)">
              <%= s[:label] %>
            </h3>
            <p class="text-xs text-(--color-text-subtle) mt-0.5"><%= s[:sub] %></p>
          </li>
        <% end %>
      </ol>

    </div><%# /trackingArea %>

    <%# Complete section %>
    <div data-notification-status-target="completeSection"
         class="<%= done ? '' : 'hidden' %> text-center space-y-3">
      <div class="w-16 h-16 rounded-full bg-(--color-success-light) flex items-center justify-center mx-auto mb-3">
        <i class="ph ph-confetti text-(--color-success) text-3xl"></i>
      </div>
      <p class="text-lg font-bold text-(--color-text)">Perfeito! Tudo funcionando. 🎉</p>
      <p class="text-sm text-(--color-text-muted)">Sua primeira cobrança via WhatsApp foi um sucesso. Agora é só adicionar seus clientes.</p>
      <%= link_to onboarding_step4_path,
            class: "mt-2 w-full inline-flex items-center justify-center gap-2 bg-(--color-brand) hover:bg-(--color-brand-dark) text-(--color-text-inverse) font-semibold py-2.5 px-5 rounded-lg text-sm transition-colors" do %>
        Continuar
        <i class="ph ph-arrow-right text-base"></i>
      <% end %>
    </div>

    <%# Skip link %>
    <div data-notification-status-target="skipLink"
         class="<%= done ? 'hidden' : '' %> mt-6 text-center">
      <%= link_to onboarding_step4_path,
            class: "text-sm text-(--color-text-muted) hover:text-(--color-text) transition-colors" do %>
        Ir para o Dashboard <i class="ph ph-arrow-right text-xs"></i>
      <% end %>
    </div>

  </div>

<% else %>
  <%# ── Phone number form ──────────────────────────────────────────── %>
  <div>

    <div class="mb-5">
      <h2 class="text-xl font-bold text-(--color-text) flex items-center gap-2">
        <i class="ph-fill ph-paper-plane-tilt text-(--color-brand) text-2xl"></i>
        Teste o disparo agora!
      </h2>
      <p class="text-(--color-text-muted) text-sm mt-1.5">Envie uma mensagem de teste em tempo real.</p>
    </div>

    <% if @error %>
      <div id="alert-step3"
           class="flex items-center p-4 mb-6 text-sm text-(--color-danger) rounded-xl bg-(--color-danger-light) border border-(--color-danger)"
           role="alert">
        <i class="ph ph-warning-circle text-lg shrink-0"></i>
        <span class="ms-3 font-medium flex-1"><%= @error %></span>
        <button type="button"
                class="ms-auto -mx-1.5 -my-1.5 text-(--color-danger) rounded-lg p-1.5 hover:bg-(--color-danger-light) inline-flex items-center justify-center h-8 w-8"
                data-dismiss-target="#alert-step3"
                aria-label="Fechar">
          <i class="ph ph-x text-sm"></i>
        </button>
      </div>
    <% end %>

    <%# WhatsApp message preview %>
    <div class="mb-6 bg-(--color-surface-muted) rounded-xl border border-(--color-border) p-4">
      <div class="flex items-center gap-2 mb-3">
        <div class="w-7 h-7 rounded-full bg-(--color-brand) flex items-center justify-center shrink-0">
          <i class="ph ph-whatsapp-logo text-(--color-text-inverse) text-sm"></i>
        </div>
        <span class="text-xs font-semibold text-(--color-brand)">Cobrança em Dia</span>
        <span class="ms-auto text-xs text-(--color-text-subtle)">agora</span>
      </div>
      <div class="bg-(--color-surface) rounded-lg rounded-tl-none px-3.5 py-2.5 shadow-sm text-sm text-(--color-text) leading-relaxed border border-(--color-border)">
        Olá! 👋 Este é um teste do Cobrança em Dia. Sua régua de cobranças está pronta para funcionar. 🚀
      </div>
    </div>

    <%= form_with url: onboarding_step3_path, method: :post,
          data: { controller: "phone-input", action: "submit->phone-input#syncHidden",
                  "phone-input-check-whatsapp-url-value": onboarding_check_whatsapp_path } do |f| %>
      <div class="space-y-5">
        <div>
          <label for="phone_display" class="block mb-2 text-sm font-medium text-(--color-text)">
            Número do WhatsApp <span class="text-(--color-danger)">*</span>
          </label>
          <input type="tel"
                 id="phone_display"
                 data-phone-input-target="input"
                 data-action="input->phone-input#checkPhone countrychange->phone-input#checkPhone"
                 enterkeyhint="send"
                 autofocus
                 class="bg-(--color-surface-muted) border border-(--color-border) text-(--color-text) text-sm rounded-lg focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) block w-full p-2.5 placeholder:text-(--color-text-subtle) transition-colors">
          <input type="hidden" name="phone_number" data-phone-input-target="hidden">
          <p data-phone-input-target="phoneCheck" class="hidden text-xs mt-1.5"></p>
          <p class="mt-2 text-xs text-(--color-text-subtle)">Informe um número válido para o teste. Pode ser o seu próprio!</p>
        </div>

        <button type="submit"
                disabled
                data-phone-input-target="submit"
                data-controller="loadable"
                data-loadable-loading-text-value="Enviando..."
                class="w-full inline-flex items-center justify-center gap-2 disabled:opacity-40 disabled:cursor-not-allowed bg-(--color-brand) hover:bg-(--color-brand-dark) text-(--color-text-inverse) font-semibold py-2.5 px-5 rounded-lg text-sm transition-colors cursor-pointer">
          <i class="ph ph-paper-plane-tilt text-base"></i>
          Enviar mensagem de teste
        </button>
      </div>
    <% end %>
  </div>
<% end %>
