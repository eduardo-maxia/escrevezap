<% content_for :title, "Adicione seu primeiro contato — EscreveZap" %>

<%# ── Custom left panel ──────────────────────────────────────────────── %>
<% content_for :auth_left do %>
  <div class="flex-1 flex flex-col justify-center relative z-10">
    <div class="flex items-center gap-3 mb-12">
      <%= image_tag "/logo.png", alt: "EscreveZap", class: "w-10 h-10" %>
      <span class="text-xl font-bold tracking-tight">EscreveZap</span>
    </div>

    <h2 class="text-3xl font-bold leading-snug mb-3">
      Quase lá! Escolha<br>quem monitorar.
    </h2>
    <p class="text-white/70 text-sm leading-relaxed mb-10">
      Adicione os contatos cujos áudios você quer que o EscreveZap transcreva automaticamente.
    </p>

    <%# Steps %>
    <ul class="space-y-5">
      <li class="flex items-start gap-4">
        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-white/20 flex items-center justify-center text-xs font-bold">✓</span>
        <div>
          <p class="text-sm font-medium text-white/60">Faça login</p>
        </div>
      </li>
      <li class="flex items-start gap-4">
        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-white/20 flex items-center justify-center text-xs font-bold">✓</span>
        <div>
          <p class="text-sm font-medium text-white/60">Conecte seu WhatsApp</p>
        </div>
      </li>
      <li class="flex items-start gap-4">
        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-white flex items-center justify-center text-(--color-brand) text-xs font-bold">3</span>
        <div>
          <p class="text-sm font-semibold">Adicione contatos para monitorar</p>
          <p class="text-xs text-white/60 mt-0.5">Transcrições chegam direto na conversa</p>
        </div>
      </li>
    </ul>
  </div>
  <p class="relative z-10 text-white/40 text-xs mt-auto">© <%= Time.current.year %> EscreveZap</p>
<% end %>

<%# ── Right panel content ─────────────────────────────────────────────── %>
<div class="space-y-6">

  <%# Mobile steps indicator — fixed bottom %>
  <div class="lg:hidden fixed bottom-6 inset-x-0 z-10 flex items-center justify-center gap-1.5 pointer-events-none">
    <span class="w-2 h-2 rounded-full" style="background:#CBD5E1"></span>
    <span class="w-2 h-2 rounded-full" style="background:#CBD5E1"></span>
    <span class="w-6 h-2 rounded-full bg-(--color-brand)"></span>
  </div>

  <div>
    <h1 class="text-2xl font-bold text-(--color-text)">Adicione seu primeiro contato</h1>
    <p class="mt-1 text-sm text-(--color-text-muted)">Passo 3 de 3 — Escolha quem você quer monitorar</p>
  </div>

  <div class="rounded-2xl border border-(--color-brand-light) bg-(--color-brand-subtle) px-4 py-3 flex items-start gap-3">
    <i class="ph ph-info text-(--color-brand) text-lg flex-shrink-0 mt-0.5"></i>
    <p class="text-sm text-(--color-brand)">
      Só os contatos que você adicionar aqui terão os áudios transcritos. Você pode adicionar mais a qualquer momento.
    </p>
  </div>

  <%= render "step3_contact_form", contact: @contact %>

  <%# Skip %>
  <div class="text-center">
    <%= button_to "Pular por agora", onboarding_dismiss_contacts_path,
          method: :post,
          class: "text-sm text-(--color-text-muted) hover:text-(--color-text) underline underline-offset-2 transition-colors bg-transparent border-none cursor-pointer" %>
    <p class="text-xs text-(--color-text-subtle) mt-1">Você pode adicionar contatos depois, em Contatos.</p>
  </div>

</div>
