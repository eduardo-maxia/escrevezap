<% content_for :current_step, "3" %>

<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@28.1.0/dist/css/intlTelInput.css">
  <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@28.1.0/dist/js/intlTelInputWithUtils.min.js"></script>
<% end %>

<% if @notification %>
  <%
    raw_status  = @notification.notification_status.to_s
    norm_status = raw_status == "read" ? "delivered" : raw_status
    failed      = raw_status == "failed"
    step_order  = %w[pending sending sent delivered]
    cur_idx     = failed ? -1 : (step_order.index(norm_status) || -1)
    state_for   = ->(key) {
      i = step_order.index(key)
      next "waiting" unless i
      i < cur_idx ? "done" : (i == cur_idx ? "active" : "waiting")
    }
    steps = [
      { key: "pending",   label: "Na fila",  sub: "Aguardando o envio" },
      { key: "sending",   label: "Enviando", sub: "Processando via WhatsApp" },
      { key: "sent",      label: "Enviado",  sub: "Chegou ao WhatsApp" },
      { key: "delivered", label: "Entregue", sub: "Recebido no dispositivo" },
    ]
    done = %w[delivered read].include?(raw_status)
  %>

  <div class="bg-(--color-surface) rounded-2xl border border-(--color-border) shadow-sm overflow-hidden"
       data-controller="notification-status"
       data-notification-status-notification-id-value="<%= @notification.id %>"
       data-notification-status-current-status-value="<%= norm_status %>">

    <div class="px-6 py-4 flex items-center gap-3 border-b border-(--color-border) bg-(--color-brand-subtle)">
      <div class="w-9 h-9 rounded-xl bg-(--color-brand) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-rocket-launch text-(--color-text-inverse) text-base"></i>
      </div>
      <div class="text-left">
        <h2 class="text-base font-bold text-(--color-text) leading-tight">Mensagem enviada! 🚀</h2>
        <p class="text-(--color-text-muted) text-xs">Acompanhe em tempo real o status da sua mensagem.</p>
      </div>
    </div>

    <div class="p-8">
      <%# Tracking area — hidden when delivered %>
      <div data-notification-status-target="trackingArea" class="<%= done ? 'hidden' : '' %>">
        <%# Recipient info %>
        <div class="flex items-center gap-3 bg-(--color-surface-muted) rounded-lg px-4 py-3 mb-6 border border-(--color-border)">
        <div class="w-9 h-9 rounded-full bg-(--color-brand-light) flex items-center justify-center flex-shrink-0">
          <i class="ph ph-user text-(--color-brand) text-base"></i>
        </div>
        <div class="min-w-0">
          <p class="text-sm font-medium text-(--color-text) truncate"><%= @notification.campaign_client.client.name rescue "Seu cliente" %></p>
          <p class="text-xs text-(--color-text-subtle)"><%= @notification.campaign_client.client.formatted_number rescue "" %></p>
        </div>
        <div class="ml-auto flex-shrink-0">
          <i class="ph ph-whatsapp-logo text-(--color-brand) text-xl"></i>
        </div>
      </div>

      <%# Failed banner %>
      <div data-notification-status-target="failedBanner"
           class="<%= failed ? '' : 'hidden' %> mb-6 flex items-start gap-3 bg-(--color-danger-light) border border-(--color-danger) rounded-xl px-4 py-3">
        <i class="ph ph-warning-circle text-(--color-danger) text-xl flex-shrink-0 mt-0.5"></i>
        <div>
          <p class="text-sm font-semibold text-(--color-danger)">Falha no envio</p>
          <p class="text-xs text-(--color-danger) opacity-70 mt-0.5">Não foi possível entregar a mensagem. Verifique o WhatsApp conectado.</p>
        </div>
      </div>

      <%# Horizontal step progress %>
      <div class="flex items-start py-3 px-1">
        <% steps.each_with_index do |s, idx| %>
          <% st = state_for.call(s[:key]) %>
          <%# Connector before (except first) %>
          <% if idx > 0 %>
            <% prev_st = state_for.call(steps[idx - 1][:key]) %>
            <div data-notification-status-target="connector"
                 data-step="<%= steps[idx - 1][:key] %>"
                 data-state="<%= prev_st == 'done' ? 'done' : 'waiting' %>"
                 class="flex-1 h-px mt-3.5 mx-1 transition-all duration-400
                   data-[state=done]:bg-(--color-success)
                   data-[state=waiting]:bg-(--color-border)"></div>
          <% end %>
          <%# Step dot + label %>
          <div data-notification-status-target="step"
               data-step="<%= s[:key] %>"
               data-state="<%= st %>"
               class="group flex flex-col items-center gap-1.5 flex-shrink-0 w-14">
            <div class="w-7 h-7 rounded-full flex items-center justify-center border-2 transition-all duration-400
                 bg-(--color-surface) border-(--color-border)
                 group-data-[state=done]:bg-(--color-success)  group-data-[state=done]:border-(--color-success)
                 group-data-[state=active]:bg-(--color-brand)  group-data-[state=active]:border-(--color-brand)">
              <i class="ph ph-check-bold text-white text-xs
                   group-data-[state=waiting]:hidden group-data-[state=active]:hidden"></i>
              <div class="w-2 h-2 rounded-full bg-white animate-pulse
                   group-data-[state=done]:hidden group-data-[state=waiting]:hidden"></div>
            </div>
            <span class="text-[10px] font-medium leading-tight text-center text-(--color-text-subtle) transition-colors duration-400
                 group-data-[state=done]:text-(--color-success)
                 group-data-[state=active]:text-(--color-brand)">
              <%= s[:label] %>
            </span>
          </div>
        <% end %>
      </div>
      </div><%# /trackingArea %>

      <%# Complete section %>
      <div data-notification-status-target="completeSection"
           class="<%= done ? '' : 'hidden' %> text-center space-y-3">
        <div class="w-14 h-14 rounded-full bg-(--color-success-light) flex items-center justify-center mx-auto mb-3">
          <i class="ph ph-confetti text-(--color-success) text-2xl"></i>
        </div>
        <p class="text-base font-semibold text-(--color-text)">Perfeito! Tudo funcionando. 🎉</p>
        <p class="text-sm text-(--color-text-muted)">Sua primeira cobrança via WhatsApp foi um sucesso. Agora é só adicionar seus clientes e deixar o Cobrança em Dia trabalhar por você.</p>
        <%= button_to complete_onboarding_path, method: :post,
              class: "mt-2 w-full flex items-center justify-center gap-2 bg-(--color-brand) hover:bg-(--color-brand-dark) text-(--color-text-inverse) font-semibold py-3 px-4 rounded-lg text-sm transition-colors cursor-pointer" do %>
          Ir para o Dashboard
          <i class="ph ph-arrow-right text-base"></i>
        <% end %>
      </div>

      <%# Skip link %>
      <div data-notification-status-target="skipLink"
           class="<%= done ? 'hidden' : '' %> mt-6 text-center">
        <%= link_to complete_onboarding_path, data: { "turbo-method": "post" },
              class: "text-sm text-(--color-text-muted) hover:text-(--color-text) transition-colors" do %>
          Ir para o Dashboard <i class="ph ph-arrow-right text-xs"></i>
        <% end %>
      </div>
    </div>
  </div>

<% else %>
  <%# ── Phone number form view ──────────────────────────────────────── %>
  <div class="bg-(--color-surface) rounded-2xl border border-(--color-border) shadow-sm overflow-hidden">

    <div class="px-6 py-4 flex items-center gap-3 border-b border-(--color-border) bg-(--color-brand-subtle)">
      <div class="w-9 h-9 rounded-xl bg-(--color-brand) flex items-center justify-center flex-shrink-0">
        <i class="ph ph-paper-plane-tilt text-(--color-text-inverse) text-base"></i>
      </div>
      <div class="text-left">
        <h2 class="text-base font-bold text-(--color-text) leading-tight">Teste o disparo agora!</h2>
        <p class="text-(--color-text-muted) text-xs">Envie uma mensagem de teste em tempo real.</p>
      </div>
    </div>

    <div class="p-8">
      <% if @error %>
        <div class="mb-5 flex items-start gap-3 bg-(--color-danger-light) border border-(--color-danger) rounded-lg px-4 py-3 text-sm text-(--color-danger)">
          <i class="ph ph-warning-circle text-lg flex-shrink-0 mt-0.5"></i>
          <span><%= @error %></span>
        </div>
      <% end %>

      <%# Preview card %>
      <div class="mb-6 bg-(--color-surface-raised) rounded-xl border border-(--color-border) p-4">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-7 h-7 rounded-full bg-(--color-brand) flex items-center justify-center flex-shrink-0">
            <i class="ph ph-whatsapp-logo text-(--color-text-inverse) text-sm"></i>
          </div>
          <span class="text-xs font-semibold text-(--color-brand)">Cobrança em Dia</span>
          <span class="ml-auto text-xs text-(--color-text-subtle)">agora</span>
        </div>
        <div class="bg-(--color-surface) rounded-lg rounded-tl-none px-3.5 py-2.5 shadow-sm text-sm text-(--color-text) leading-relaxed border border-(--color-border)">
          Olá! 👋 Este é um teste do Cobrança em Dia. Sua régua de cobranças está pronta para funcionar. 🚀
        </div>
      </div>

      <%= form_with url: onboarding_step3_path, method: :post,
            data: { controller: "phone-input", action: "submit->phone-input#syncHidden",
                    "phone-input-check-whatsapp-url-value": onboarding_check_whatsapp_path } do |f| %>
        <div class="space-y-5">
          <div>
            <label for="phone_display" class="block text-sm font-medium text-(--color-text) mb-1.5">
              Número do WhatsApp <span class="text-(--color-danger)">*</span>
            </label>
            <input type="tel"
                   id="phone_display"
                   data-phone-input-target="input"
                   data-action="input->phone-input#checkPhone countrychange->phone-input#checkPhone"
                   autofocus
                   class="w-full px-3.5 py-2.5 rounded-lg border border-(--color-border) bg-(--color-surface) text-(--color-text) text-sm placeholder:text-(--color-text-subtle) focus:outline-none focus:ring-2 focus:ring-(--color-brand) focus:border-(--color-brand) transition-colors">
            <input type="hidden" name="phone_number" data-phone-input-target="hidden">
            <p data-phone-input-target="phoneCheck" class="hidden text-xs mt-1.5"></p>
            <p class="mt-1.5 text-xs text-(--color-text-subtle)">Informe um número válido para o teste. Pode ser o seu próprio!</p>
          </div>

          <button type="submit"
            disabled
            data-phone-input-target="submit"
            class="w-full flex items-center justify-center gap-2 bg-(--color-brand) hover:bg-(--color-brand-dark) text-(--color-text-inverse) font-semibold py-3 px-4 rounded-lg text-sm transition-colors cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
            <i class="ph ph-paper-plane-tilt text-base"></i>
            Enviar mensagem de teste
          </button>
        </div>
      <% end %>

      <div class="mt-4 text-center">
        <%= link_to complete_onboarding_path, data: { "turbo-method": "post" },
              class: "text-sm text-(--color-text-muted) hover:text-(--color-text) transition-colors" do %>
          Pular e ir para o Dashboard <i class="ph ph-arrow-right text-xs"></i>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
